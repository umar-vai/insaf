---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import BottomNav from '../components/BottomNav.astro';
import FontPicker from '../components/FontPicker.astro';
import EnvBanner from '../components/EnvBanner.astro';
import MetaPixel from '../components/MetaPixel.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Pre-filled WhatsApp message for the floating button. */
  whatsapp?: string;
  /** The phone bottom menu; the lesson player has its own bar instead. */
  bottomNav?: boolean;
  /** Foundation-branded campaign pages only. */
  foundationTheme?: boolean;
}
const { title, description = SITE.tagline, image = '/images/students-quran-1280.webp', whatsapp, bottomNav = true, foundationTheme = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.name ? `${SITE.nameBn} | ${SITE.slogan}` : `${title} | ${SITE.nameBn}`;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={foundationTheme ? '#005f82' : '#17362a'} />
    <link rel="preload" href="/fonts/extra/anek-bangla-bengali-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nameBn} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <MetaPixel />
    <Analytics />
    <slot name="head" />
  </head>
  <body class={foundationTheme ? 'foundation-theme' : undefined}>
    <a class="skip-link" href="#main">মূল অংশে যান</a>
    <EnvBanner />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer foundationTheme={foundationTheme} />
    {!foundationTheme && <WhatsAppFab message={whatsapp} />}
    <FontPicker />
    {bottomNav && <BottomNav />}
    <div class="progress" aria-hidden="true"></div>
    <script>
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Siblings that reveal together arrive one after another.
      const groups = new Map<Element, number>();
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        const parent = el.parentElement!;
        const i = groups.get(parent) ?? 0;
        groups.set(parent, i + 1);
        if (i) el.style.setProperty('--reveal-delay', `${Math.min(i, 6) * 90}ms`);
      });

      // Numbers marked data-count climb to their value once seen.
      const BN = '০১২৩৪৫৬৭৮৯';
      const bn = (n: number) => String(n).replace(/\d/g, (d) => BN[+d]!);
      const counter = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          counter.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const suffix = el.dataset.suffix ?? '';
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min(1, (now - start) / 1400);
            el.textContent = bn(Math.round(to * (1 - Math.pow(1 - t, 3)))) + suffix;
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      });
      if (!reduced) document.querySelectorAll('[data-count]').forEach((el) => counter.observe(el));

      // Reading progress line.
      const bar = document.querySelector('.progress') as HTMLElement;
      let ticking = false;
      addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const max = document.documentElement.scrollHeight - innerHeight;
            bar.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
            ticking = false;
          });
        },
        { passive: true },
      );

      // Reveal sections once as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
