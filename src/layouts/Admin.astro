---
import '../styles/base.css';
import '../styles/panel.css';
import Icon from '../components/Icon.astro';
import FontPicker from '../components/FontPicker.astro';
import { adminModule, homeFor, inArea, mayOpenPath, MODULE_BN } from '../server/staff';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';
type Item = { href: string; label: string; icon: Parameters<typeof Icon>[0]['name'] };
type Group = { label: string; items: Item[] };

// Two halves, each with its own menu: donations (the CRM) and the madrasa
// office (the ERP). The switcher at the top moves between them.
const ONLINE: Group[] = [
  { label: 'সারসংক্ষেপ', items: [{ href: '/admin/dashboard', label: 'দানের ড্যাশবোর্ড', icon: 'grid' }, { href: '/admin/visits', label: 'আজকের ভিজিট', icon: 'users' }] },
  {
    label: 'দান ও দাতা',
    items: [
      { href: '/admin/donations', label: 'সব দান', icon: 'receipt' },
      { href: '/admin/donations/record', label: 'অফিসে পাওয়া দান', icon: 'plus' },
      { href: '/admin/donors', label: 'দাতা (CRM)', icon: 'users' },
      { href: '/admin/funds', label: 'তহবিল ও গল্প', icon: 'heart' },
    ],
  },
  { label: 'ওয়েবসাইট', items: [{ href: '/admin/blog', label: 'পাবলিক নোটিশ ও খবর', icon: 'text' }] },
];
const OFFLINE: Group[] = [
  { label: 'সারসংক্ষেপ', items: [{ href: '/admin/offline', label: 'ড্যাশবোর্ড', icon: 'grid' }] },
  {
    label: 'ছাত্র ও ফি',
    items: [
      { href: '/admin/offline/students', label: 'ছাত্র ও ভর্তি', icon: 'users' },
      { href: '/admin/offline/collect', label: 'ফি আদায়', icon: 'coins' },
      { href: '/admin/offline/dues', label: 'বকেয়া ও রিমাইন্ডার', icon: 'alert' },
      { href: '/admin/offline/tickets', label: 'টিকেট', icon: 'mail' },
    ],
  },
  {
    label: 'একাডেমিক',
    items: [
      { href: '/admin/offline/batches', label: 'ক্লাস ও রুটিন', icon: 'calendar' },
      { href: '/admin/offline/attendance', label: 'হাজিরা', icon: 'clipboard' },
      { href: '/admin/offline/courses', label: 'বিভাগ ও ফি', icon: 'book' },
      { href: '/admin/offline/notices', label: 'পোর্টালের নোটিশ', icon: 'bell' },
    ],
  },
  {
    label: 'শিক্ষক ও বেতন',
    items: [
      { href: '/admin/offline/teachers', label: 'শিক্ষক ও কর্মী', icon: 'briefcase' },
      { href: '/admin/offline/leave', label: 'ছুটির আবেদন', icon: 'calendar' },
      { href: '/admin/offline/payroll', label: 'বেতন শিট', icon: 'wallet' },
    ],
  },
  {
    label: 'হিসাব',
    items: [
      { href: '/admin/offline/expenses', label: 'খরচ ও ভাউচার', icon: 'wallet' },
      { href: '/admin/offline/reports', label: 'আয় ব্যয় রিপোর্ট', icon: 'chart' },
      { href: '/admin/offline/online-payments', label: 'অনলাইনে আসা ফি', icon: 'globe' },
      { href: '/admin/offline/settings', label: 'অফিসের নিয়ম', icon: 'layers' },
    ],
  },
];

// Search hints explain both what the section does and where nested tasks live.
// The rendered list is already filtered by mayOpenPath, so searches never
// reveal a module the signed-in administrator cannot access.
const TASK_HINTS: Record<string, string> = {
  '/admin/dashboard': 'দানের মোট হিসাব, তহবিল এবং দাতা বিশ্লেষণ',
  '/admin/visits': 'ওয়েবসাইট ভিজিট এবং দর্শনার্থীর রিপোর্ট',
  '/admin/donations': 'অনলাইন ও অফলাইন অনুদান, রসিদ এবং পেমেন্ট যাচাই',
  '/admin/donations/record': 'ক্যাশ ব্যাংক বিকাশ নগদ অনুদান অফিসে রেকর্ড করুন',
  '/admin/donors': 'দাতার ইতিহাস, ফোন এবং CRM',
  '/admin/funds': 'জমি প্রজেক্ট অনুদানের লক্ষ্য ও তহবিল',
  '/admin/blog': 'ওয়েবসাইটের নোটিশ খবর ব্লগ পোস্ট',
  '/admin/offline': 'মাদরাসা দৈনিক সারাংশ, ছাত্র ফি ও আজকের ক্লাস',
  '/admin/offline/students': 'নতুন ভর্তি, ছাত্র প্রোফাইল, অভিভাবকের ফোন, আইডি কার্ড, রেকর্ড খুঁজুন',
  '/admin/offline/collect': 'ছাত্রের ফি নিন, টাকা আদায়, মানি রসিদ তৈরি',
  '/admin/offline/dues': 'বকেয়া টাকা, কিস্তি ও রিমাইন্ডার WhatsApp SMS',
  '/admin/offline/tickets': 'শিক্ষার্থী ও শিক্ষকের অভিযোগ প্রশ্ন সহায়তা টিকেট',
  '/admin/offline/batches': 'ক্লাস ব্যাচ রুটিন পরীক্ষা শিডিউল শিক্ষক বিষয় স্টাডি ম্যাটেরিয়াল',
  '/admin/offline/attendance': 'ছাত্র হাজিরা উপস্থিত অনুপস্থিত রিপোর্ট',
  '/admin/offline/courses': 'বিভাগ কোর্স ফি সেটআপ',
  '/admin/offline/notices': 'ছাত্র ও শিক্ষক পোর্টালের ঘোষণা নোটিশ',
  '/admin/offline/teachers': 'শিক্ষক কর্মী প্রোফাইল তালিকা এবং দায়িত্ব',
  '/admin/offline/leave': 'শিক্ষক ও কর্মচারীর ছুটির আবেদন অনুমোদন',
  '/admin/offline/payroll': 'মাসিক বেতন, পে স্লিপ ও বেতন প্রদান',
  '/admin/offline/expenses': 'অফিস খরচ ভাউচার অনুমোদন',
  '/admin/offline/reports': 'আয় ব্যয়, ছাত্র ফি রিপোর্ট, এক্সেল CSV',
  '/admin/offline/online-payments': 'গেটওয়ে পেমেন্ট যাচাই অনলাইন ফি',
  '/admin/offline/settings': 'মাদরাসা অফিসের নিয়ম ফি জরিমানা অনুমতি',
  '/admin/finance': 'দান ও ছাত্র ফি একসাথে মোট আয় ব্যয়',
  '/admin/team': 'টিম সদস্য নিয়োগ ভূমিকা অ্যাডমিন অনুমতি',
  '/admin/audit': 'অডিট লগ কে কী পরিবর্তন করেছে',
  '/admin/system': 'সিস্টেম সেটিংস SSLCommerz নিরাপত্তা',
};

const SHARED: Group = {
  label: 'প্রতিষ্ঠান',
  items: [
    { href: '/admin/finance', label: 'মোট আয় ব্যয়', icon: 'layers' },
    { href: '/admin/team', label: 'টিম ও অনুমতি', icon: 'user' },
    { href: '/admin/audit', label: 'কে কী করেছে', icon: 'clipboard' },
    { href: '/admin/system', label: 'সিস্টেম সেটিংস', icon: 'lock' },
  ],
};

const access = { modules: Astro.locals.staffModules ?? [], owner: Astro.locals.staffOwner ?? false, grants: Astro.locals.staffGrants };
const home = homeFor(access);
const here = adminModule(path);
const pathArea = here === 'shared' || here === 'owner' ? 'shared' : MODULE_BN[here].area;
const viewOnly = !access.owner && here !== 'shared' && here !== 'owner' && Astro.locals.staffGrants?.[here] === 'view';
const hasOnline = inArea(access, 'online');
const hasOffline = inArea(access, 'offline');
// On pages that belong to both (team, totals, system), keep the menu the person came from.
const remembered = Astro.cookies.get('tm_area')?.value === 'offline' ? 'offline' : 'online';
const mode: 'online' | 'offline' =
  !hasOnline ? 'offline' : !hasOffline ? 'online' : pathArea === 'offline' || pathArea === 'online' ? pathArea : remembered;
const keep = (g: Group): Group => ({ ...g, items: g.items.filter((n) => mayOpenPath(access, n.href)) });
const groups = [...(mode === 'offline' ? OFFLINE : ONLINE), SHARED].map(keep).filter((g) => g.items.length);
const all = groups.flatMap((g) => g.items);
const current = all.filter((n) => path === n.href || path.startsWith(`${n.href}/`)).sort((a, b) => b.href.length - a.href.length)[0];
const flash = Astro.url.searchParams.get('saved');
const problem = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="robots" content="noindex" />
    <title>{title} | ইনসাফ অ্যাডমিন</title>
  </head>
  <body class="admin ui ui-page">
    <header class="top">
      <button type="button" class="top__menu" data-side-open aria-label="মেনু খুলুন" aria-controls="admin-side" aria-expanded="false">
        <Icon name="menu" size={22} />
      </button>
      <span class="top__here">{current?.label ?? title}</span>
      <span class="top__mode">{mode === 'offline' ? 'মাদরাসা' : 'দান'}</span>
    </header>

    <aside class="side" id="admin-side">
      <a class="side__brand" href={home}>
        <img src="/logo-wide.webp" alt="Madrasatul Insaf" width="150" height="40" />
        <span>{mode === 'offline' ? 'মাদরাসা ERP' : 'দান CRM'}</span>
      </a>
      {
        hasOnline && hasOffline && (
          <nav class="switch" aria-label="অংশ বাছুন">
            <a href="/admin/dashboard" aria-current={mode === 'online' ? 'true' : undefined} data-area="online">
              <Icon name="heart" size={16} /> দান
            </a>
            <a href="/admin/offline" aria-current={mode === 'offline' ? 'true' : undefined} data-area="offline">
              <Icon name="home" size={16} /> মাদরাসা
            </a>
          </nav>
        )
      }
      <div class="side__find">
        <label for="admin-task-search">কোন কাজ কোথায়?</label>
        <input id="admin-task-search" type="search" placeholder="যেমন: পরীক্ষা, বেতন, রসিদ" autocomplete="off" aria-controls="admin-nav-groups" />
        <p id="admin-task-results" class="side__find-status" role="status" aria-live="polite" hidden></p>
      </div>
      <nav class="side__nav" id="admin-nav-groups" aria-label="অ্যাডমিন মেনু">
        {
          groups.map((g) => (
            <div class="side__group" data-task-group>
              <p class="side__label">{g.label}</p>
              {g.items.map((n) => (
                <a
                  href={n.href}
                  aria-current={n === current ? 'page' : undefined}
                  data-task-link
                  data-task-search={`${g.label} ${n.label} ${TASK_HINTS[n.href] ?? ''}`}
                  title={TASK_HINTS[n.href]}
                >
                  <Icon name={n.icon} size={19} />
                  <span>{n.label}</span>
                </a>
              ))}
            </div>
          ))
        }
      </nav>
      <div class="side__foot">
        <a href="/" target="_blank" rel="noopener"><Icon name="home" size={19} /><span>সাইট দেখুন</span></a>
        <form method="post" action="/api/auth/logout">
          <button type="submit" class="side__logout"><Icon name="logout" size={19} /><span>লগআউট</span></button>
        </form>
        <p class="side__who" title={Astro.locals.staff}>{Astro.locals.staff}</p>
      </div>
    </aside>
    <div class="scrim" data-side-close hidden></div>

    <main class="main">
      {viewOnly && <p class="note note--warn" role="status">এই অংশে আপনার শুধু দেখার অনুমতি আছে। কিছু সংরক্ষণ করতে চাইলে তা হবে না।</p>}
      {flash && <p class="flash flash--ok" role="status">সংরক্ষণ হয়েছে।</p>}
      {problem && <p class="flash flash--bad" role="alert">কাজটি করা যায়নি। তথ্য দেখে আবার চেষ্টা করুন।</p>}
      <slot />
    </main>
    <FontPicker corner />

    <script>
      import { toWebp } from '../lib/to-webp';

      // Every image picked in a form is turned into a small WebP before it is
      // sent. A form waits for this if it is submitted straight away.
      const pending = new WeakMap<HTMLInputElement, Promise<void>>();
      document.addEventListener('change', (e) => {
        const input = e.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'file' || !input.accept.includes('image/webp') || input.hasAttribute('data-image-file')) return;
        const file = input.files?.[0];
        if (!file) return;
        pending.set(
          input,
          toWebp(file).then((out) => {
            if (out === file) return;
            const list = new DataTransfer();
            list.items.add(out);
            input.files = list.files;
          }),
        );
      });
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement;
        const waits = [...form.querySelectorAll<HTMLInputElement>('input[type=file]')].map((i) => pending.get(i)).filter(Boolean);
        if (!waits.length || form.dataset.webpReady) return;
        e.preventDefault();
        // Submit again on a later task: a resubmit while this submit event is
        // still being handled is silently dropped by the browser.
        Promise.all(waits).then(() =>
          setTimeout(() => {
            form.dataset.webpReady = '1';
            form.requestSubmit();
          }),
        );
      });

      // Remember which menu was last used, for pages that belong to both.
      document.querySelectorAll<HTMLAnchorElement>('[data-area]').forEach((a) =>
        a.addEventListener('click', () => {
          document.cookie = `tm_area=${a.dataset.area}; path=/admin; max-age=31536000; samesite=lax`;
        }),
      );
      const area = location.pathname.startsWith('/admin/offline') ? 'offline' : /^\/admin\/(dashboard|orders|students|courses|blog|reviews|notices|reports)/.test(location.pathname) ? 'online' : '';
      if (area) document.cookie = `tm_area=${area}; path=/admin; max-age=31536000; samesite=lax`;

      const taskInput = document.querySelector<HTMLInputElement>('#admin-task-search');
      const taskStatus = document.querySelector<HTMLElement>('#admin-task-results');
      const taskGroups = [...document.querySelectorAll<HTMLElement>('[data-task-group]')];
      const normalizeTask = (value: string) => value.normalize('NFKC').toLocaleLowerCase().replace(/\s+/g, ' ').trim();

      const filterTasks = () => {
        const query = normalizeTask(taskInput?.value ?? '');
        let matches = 0;
        taskGroups.forEach((group) => {
          let visible = 0;
          group.querySelectorAll<HTMLAnchorElement>('[data-task-link]').forEach((link) => {
            const found = !query || normalizeTask(link.dataset.taskSearch ?? '').includes(query);
            link.hidden = !found;
            if (found) { matches++; visible++; }
          });
          group.hidden = !visible;
        });
        if (taskStatus) {
          taskStatus.hidden = !query;
          taskStatus.textContent = query ? (matches ? `${matches}টি অনুমতিপ্রাপ্ত অংশ পাওয়া গেছে` : 'এই নামে অনুমতিপ্রাপ্ত কোনো অংশ পাওয়া যায়নি') : '';
        }
      };
      taskInput?.addEventListener('input', filterTasks);
      const side = document.getElementById('admin-side')!;
      const scrim = document.querySelector<HTMLElement>('.scrim')!;
      const btn = document.querySelector<HTMLButtonElement>('[data-side-open]')!;
      const set = (open: boolean) => {
        side.toggleAttribute('data-open', open);
        scrim.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
      };
      btn.addEventListener('click', () => set(true));
      scrim.addEventListener('click', () => set(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { set(false); return; }
        // Press / outside an input to find a task; open the drawer on phones.
        const target = e.target;
        const typing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || (target instanceof HTMLElement && target.isContentEditable);
        if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey && taskInput) {
          e.preventDefault();
          if (window.matchMedia('(max-width: 900px)').matches) set(true);
          taskInput.focus();
        }
      });
      // "Save as PDF" buttons print the page; the browser's print dialog saves it as a PDF.
      document.querySelectorAll<HTMLElement>('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
      // Ask before anything that cannot be undone with one click.
      document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
        f.addEventListener('submit', (e) => {
          if (!confirm(f.dataset.confirm!)) e.preventDefault();
        }),
      );
    </script>



    <style>
      .top {
        display: none;
      }
      .side {
        position: fixed;
        inset: 0 auto 0 0;
        width: 248px;
        display: flex;
        flex-direction: column;
        background-color: var(--green-950);
        background-image: var(--pattern-dark);
        color: var(--color-on-dark);
        z-index: 30;
      }
      .side__brand {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-5);
        text-decoration: none;
        color: var(--gold-300);
        font: 600 var(--text-xs) / 1 var(--font-display);
      }
      .side__brand img {
        height: 40px;
        width: auto;
        background: var(--white);
        border-radius: 8px;
        padding: 4px 6px;
      }
      .side__find {
        display: grid;
        gap: 5px;
        padding: 0 var(--space-3) var(--space-2);
      }
      .side__find label {
        font: 600 0.76rem / 1.4 var(--font-display);
        color: var(--color-on-dark-muted);
      }
      .side__find input {
        width: 100%;
        min-width: 0;
        padding: 10px 11px;
        border-radius: 9px;
        border: 1px solid rgb(255 255 255 / .27);
        color: var(--green-950);
        background: #fff;
        font: 500 .86rem / 1.4 var(--font-display);
      }
      .side__find input:focus-visible {
        outline: 3px solid var(--leaf-500);
        outline-offset: 2px;
      }
      .side__find-status {
        margin: 0;
        font: 500 .76rem / 1.4 var(--font-display);
        color: var(--color-on-dark-muted);
      }
      .side__group[hidden], .side__group [data-task-link][hidden] { display: none !important; }
      .side__nav {
        display: grid;
        align-content: start;
        gap: var(--space-3);
        padding: var(--space-2) var(--space-2) var(--space-4);
        flex: 1;
        min-height: 0;
        overflow-y: auto;
      }
      .side__group {
        display: grid;
        gap: 1px;
      }
      .side__label {
        margin: 0;
        padding: var(--space-1) var(--space-4);
        font: 600 0.72rem / 1.6 var(--font-display);
        color: var(--color-on-dark-muted);
        opacity: 0.8;
      }
      .switch {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3px;
        margin: 0 var(--space-3) var(--space-3);
        padding: 3px;
        border-radius: 12px;
        background: rgb(255 255 255 / 0.07);
      }
      .side .switch a {
        justify-content: center;
        gap: var(--space-1);
        padding: var(--space-2);
        border-radius: 9px;
        font: 600 var(--text-xs) / 1.4 var(--font-display);
      }
      .side .switch a[aria-current] {
        background: var(--white);
        color: var(--green-950);
      }
      .top__mode {
        margin-left: auto;
        font: 600 var(--text-xs) / 1 var(--font-display);
        color: var(--leaf-400);
      }
      .side a {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: 0.55rem var(--space-4);
        border-radius: var(--radius-sm);
        color: var(--color-on-dark);
        text-decoration: none;
        font: 550 var(--text-sm) / 1.3 var(--font-display);
      }
      .side a:hover {
        background: rgb(255 255 255 / 0.06);
      }
      .side a[aria-current='page'] {
        background: var(--leaf-500);
        color: var(--green-950);
      }
      .side__foot {
        margin-top: auto;
        padding: var(--space-2);
        border-top: 1px solid rgb(255 255 255 / 0.1);
      }
      .side__foot a {
        font-size: var(--text-sm);
      }
      .side__logout {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        width: 100%;
        padding: var(--space-3) var(--space-4);
        border: 0;
        border-radius: var(--radius-sm);
        background: none;
        color: var(--color-on-dark);
        font: 550 var(--text-sm) / 1.3 var(--font-display);
        cursor: pointer;
        text-align: left;
      }
      .side__logout:hover {
        background: rgb(255 255 255 / 0.06);
      }
      .side__who {
        margin: var(--space-2) var(--space-4);
        font-size: var(--text-xs);
        color: var(--color-on-dark-muted);
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .main {
        margin-left: 248px;
        padding: var(--space-8) clamp(1rem, 0.5rem + 2vw, 2.5rem) var(--space-16);
        max-width: 1280px;
      }
      .flash {
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-sm);
        margin-bottom: var(--space-5);
      }
      .flash--ok {
        background: var(--good-100);
        color: var(--good-700);
      }
      .flash--bad {
        background: var(--bad-100);
        color: var(--bad-700);
      }
      .scrim {
        position: fixed;
        inset: 0;
        background: rgb(4 38 26 / 0.5);
        z-index: 25;
      }
      @media (max-width: 900px) {
        .top {
          position: sticky;
          top: 0;
          z-index: 20;
          display: flex;
          align-items: center;
          gap: var(--space-3);
          padding: var(--space-2) var(--gutter);
          background: var(--green-950);
          color: var(--white);
        }
        .top__menu {
          display: grid;
          place-items: center;
          width: 42px;
          height: 42px;
          border: 0;
          border-radius: 10px;
          background: rgb(255 255 255 / 0.08);
          color: var(--white);
          cursor: pointer;
        }
        .top__here {
          font: 600 var(--text-base) / 1 var(--font-display);
        }
        .side {
          transform: translateX(-100%);
          transition: transform 0.25s var(--ease);
        }
        .side[data-open] {
          transform: none;
        }
        .main {
          margin-left: 0;
        }
      }
          @media print {
        .side,
        .top,
        .scrim,
        .switch,
        [data-noprint] {
          display: none !important;
        }
        .main {
          margin: 0 !important;
          padding: 0 !important;
          max-width: none !important;
        }
        body {
          background: #fff !important;
        }
        .card,
        .kpi {
          break-inside: avoid;
        }
      }
    </style>
  </body>
</html>
