---
// Materials of a batch: files open through /api/material (checked there), links open directly.
import Icon from './Icon.astro';
import type { Material } from '../server/panels';
import { dateBn } from '../lib/format';

interface Props {
  materials: Material[];
  /** Shows a hide button (office and the batch's teacher). */
  canHide?: boolean;
  showBatch?: boolean;
}
const { materials, canHide = false, showBatch = false } = Astro.props;
const size = (b: number | null) => (b ? `${(b / 1024 / 1024).toFixed(1)} MB` : '');
---

{
  materials.length === 0 ? (
    <p class="muted">এখনো কোনো উপকরণ দেওয়া হয়নি।</p>
  ) : (
    <ul class="mats">
      {materials.map((m) => (
        <li>
          <Icon name={m.url ? 'globe' : 'text'} size={20} />
          <div>
            <a href={m.url ?? `/api/material/${m.id}`} target={m.url ? '_blank' : undefined} rel={m.url ? 'noopener nofollow' : undefined}>
              <strong>{m.title}</strong>
            </a>
            <small>{showBatch && `${m.batchName} · `}{m.fileName ? `${m.fileName} ${size(m.sizeBytes)}` : 'লিংক'} · {dateBn(m.createdAt)}</small>
          </div>
          {canHide && (
            <form method="post" data-confirm="এই উপকরণটি সরিয়ে দেবেন? ছাত্ররা আর দেখবে না।">
              <input type="hidden" name="action" value="hide-material" />
              <input type="hidden" name="materialId" value={m.id} />
              <button class="mats__hide" aria-label="সরিয়ে দিন"><Icon name="close" size={16} /></button>
            </form>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .mats {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .mats li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    color: var(--green-700);
  }
  .mats small {
    display: block;
    color: var(--color-text-muted);
  }
  .mats__hide {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .mats__hide:hover {
    background: var(--bad-100);
    color: var(--bad-600);
  }
</style>
