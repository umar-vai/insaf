---
import Icon from './Icon.astro';
import type { Faq } from '../lib/faq';

interface Props {
  items: Faq[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((f, i) => (
      <details open={openFirst && i === 0}>
        <summary>
          <span>{f.q}</span>
          <Icon name="chevron" size={20} class="faq__chev" />
        </summary>
        <div class="faq__a">
          {f.a.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: var(--space-3);
  }
  details {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  details[open] {
    border-color: var(--leaf-200);
    box-shadow: var(--shadow);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font: 600 var(--text-base) / 1.5 var(--font-display);
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq :global(.faq__chev) {
    flex: none;
    color: var(--color-primary);
    transition: transform 0.3s var(--ease);
  }
  details[open] :global(.faq__chev) {
    transform: rotate(180deg);
  }
  .faq__a {
    padding: 0 var(--space-5) var(--space-2);
    color: var(--color-text-muted);
  }
</style>
