---
import Icon from './Icon.astro';
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
const isLandPage = path === '/land' || path === '/land/';
const links = [
  { href: '/about', label: 'আমাদের সম্পর্কে' },
  { href: '/admission', label: 'ভর্তি' },
  { href: '/land', label: 'জমি প্রজেক্ট' },
  { href: '/blog', label: 'নোটিশ' },
  { href: '/contact', label: 'যোগাযোগ' },
];
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
---

<header class:list={['header', isLandPage && 'header--foundation']} data-header>
  <div class="container header__row">
    <a class="brand" href="/" aria-label={`${SITE.name}, হোম`}>
      <img src="/logo-wide.webp" alt="" width="200" height="53" />
    </a>

    <nav class="nav" id="site-nav" aria-label="প্রধান মেনু">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav__me" href="/account" aria-current={current('/account')}>
        <Icon name="user" size={18} /> লগইন
      </a>
      <a class="button button--gold nav__cta" href={isLandPage ? '#donate-form' : '/donate'} aria-current={isLandPage ? undefined : current('/donate')}>
        <Icon name="heart" size={18} /> দান করুন
      </a>
    </nav>

    <button class="menu-button" type="button" aria-controls="site-nav" aria-expanded="false" data-menu-button>
      <Icon name="menu" size={24} class="menu-open" />
      <Icon name="close" size={24} class="menu-close" />
      <span class="visually-hidden">মেনু</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const button = header.querySelector<HTMLButtonElement>('[data-menu-button]')!;
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    button.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  button.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  /* The blur lives on a layer behind the header. On the header itself it
     would trap the fixed phone menu inside the header's box. */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(251 249 243 / 0.82);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .header[data-scrolled] {
    border-color: var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-h);
  }
  .brand img {
    height: 46px;
    width: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a:not(.button) {
    position: relative;
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    font: 550 var(--text-sm) / 1.4 var(--font-display);
    border-radius: var(--radius-sm);
    transition: color 0.2s;
  }
  .nav a:not(.button)::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.3s var(--ease);
  }
  .nav a:not(.button):hover,
  .nav a[aria-current='page'] {
    color: var(--color-primary);
  }
  .nav a:not(.button):hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav a.nav__me {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
  }
  .nav a.nav__me::after {
    display: none;
  }
  .nav__cta {
    min-height: 44px;
    padding-inline: var(--space-5);
    font-size: var(--text-sm);
  }
  .menu-button {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-surface);
    color: var(--color-primary-strong);
    cursor: pointer;
  }
  .menu-button :global(.menu-close) {
    display: none;
  }

  @media (max-width: 960px) {
    .menu-button {
      display: grid;
    }
    .brand img {
      height: 40px;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
      padding: var(--space-6) var(--gutter) var(--space-10);
      background-color: var(--color-bg);
      background-image: var(--pattern-light);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s var(--ease),
        transform 0.25s var(--ease),
        visibility 0.25s;
    }
    .header[data-open] .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .header[data-open] :global(.menu-open) {
      display: none;
    }
    .header[data-open] :global(.menu-close) {
      display: block;
    }
    ul {
      flex-direction: column;
      gap: 0;
    }
    .nav a:not(.button) {
      font-size: var(--text-xl);
      padding: var(--space-4) var(--space-2);
      border-bottom: 1px solid var(--color-line);
      border-radius: 0;
    }
    .nav a:not(.button)::after {
      display: none;
    }
    .nav__cta {
      min-height: 54px;
      font-size: var(--text-base);
    }
    .nav a.nav__me {
      display: flex;
      justify-content: center;
      min-height: 54px;
      font-size: var(--text-base);
      border-radius: 999px;
    }
  }

  /* Foundation-blue navigation is deliberately scoped to the land project. */
  .header--foundation {
    border-bottom-color: #b9dce9;
    background: #edf9fe;
  }
  .header--foundation::before { background: rgb(239 249 253 / 0.97); }
  .header--foundation[data-scrolled] {
    border-color: #a2ccd9;
    box-shadow: 0 5px 22px rgb(0 72 98 / 0.08);
  }
  .header--foundation .nav a:not(.button) { color: #144357; }
  .header--foundation .nav a[aria-current='page'],
  .header--foundation .nav a:not(.button):hover { color: #005f82; }
  .header--foundation .nav a:not(.button)::after { background: #188bb0; }
  .header--foundation .nav a.nav__me {
    background: #fff;
    color: #005f82;
    border-color: #badce8;
  }
  .header--foundation .nav__cta { background: #005f82; color: #fff; border-color: #005f82; }
  .header--foundation .nav__cta:hover { background: #003d57; }
  .header--foundation .menu-button { color: #005f82; border-color: #badce8; background: #fff; }
  @media (max-width: 960px) {
    .header--foundation .nav { background: #effafe; background-image: none; }
    .header--foundation .nav a:not(.button) { border-bottom-color: #d3e9f0; }
  }
</style>
