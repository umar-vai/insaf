---
// A money receipt to print or save as PDF, as a whole page. Used by the
// office (admin) and by the student's own panel.
import type { getReceipt } from '../server/offline';
import { dayBn, METHOD_BN, planBn } from '../lib/offline';
import { bnDigits, dateBn, taka } from '../lib/format';
import { env } from 'cloudflare:workers';
import { institute } from '../server/config';

interface Props {
  r: NonNullable<Awaited<ReturnType<typeof getReceipt>>>;
  /** Staff see who took the money; students see the institute. */
  forStaff?: boolean;
}
// Name, address, phone and logo as the owner set them on the system page.
const inst = await institute(env.DB);
const { r, forStaff = false } = Astro.props;
const { payment: p, enrollment: e, ledger: L } = r;
---


<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>রসিদ {bnDigits(p.receiptNo)} | {e.studentName}</title>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        background: #eef4ef;
        font-family: 'Hind Siliguri', 'Nirmala UI', system-ui, sans-serif;
        color: #10261b;
      }
      .sheet {
        max-width: 640px;
        margin: 24px auto;
        background: #fff;
        padding: 32px;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        border-bottom: 2px solid #0b3d2a;
        padding-bottom: 16px;
      }
      header img {
        height: 48px;
      }
      h1 {
        font-size: 20px;
        margin: 0;
        text-align: right;
      }
      .void {
        margin: 16px 0 0;
        padding: 10px;
        border: 2px solid #b42318;
        color: #b42318;
        font-weight: 700;
        text-align: center;
      }
      dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 8px 16px;
        margin: 20px 0;
      }
      dt {
        color: #4b6357;
      }
      dd {
        margin: 0;
        font-weight: 600;
      }
      .amount {
        font-size: 28px;
        font-weight: 800;
        text-align: center;
        padding: 16px;
        background: #e8f5e4;
        border-radius: 10px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      td {
        padding: 6px 0;
        border-bottom: 1px solid #e3ebe5;
      }
      td:last-child {
        text-align: right;
        font-weight: 600;
      }
      footer {
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: #4b6357;
      }
      .sign {
        border-top: 1px solid #10261b;
        padding-top: 4px;
        min-width: 160px;
        text-align: center;
      }
      .tools {
        text-align: center;
        margin: 16px;
      }
      .tools button {
        font: inherit;
        padding: 10px 20px;
        border-radius: 8px;
        border: 0;
        background: #0b3d2a;
        color: #fff;
        cursor: pointer;
      }
      @media print {
        body {
          background: #fff;
        }
        .sheet {
          box-shadow: none;
          margin: 0;
          max-width: none;
        }
        .tools {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="tools"><button type="button" onclick="print()">প্রিন্ট বা PDF</button></div>
    <main class="sheet">
      <header>
        <img src={inst.logo} alt={inst.name} />
        <h1>মানি রিসিপ্ট<br /><small>রসিদ নং {bnDigits(p.receiptNo)}</small></h1>
      </header>
      {p.voidedAt && <p class="void">এই রসিদটি বাতিল করা হয়েছে ({p.voidReason})</p>}
      <dl>
        <dt>তারিখ</dt><dd>{dayBn(p.paidOn)}</dd>
        <dt>ছাত্রের নাম</dt><dd>{e.studentName}</dd>
        <dt>ফোন</dt><dd>{bnDigits(e.studentPhone)}</dd>
        {r.address && <><dt>ঠিকানা</dt><dd>{r.address}</dd></>}
        <dt>কোর্স</dt><dd>{e.courseTitle}{e.batch && ` (${e.batch})`}</dd>
        <dt>পেমেন্ট প্ল্যান</dt><dd>{planBn(e.planMonths)}</dd>
        <dt>মাধ্যম</dt><dd>{METHOD_BN[p.method]}{p.reference && ` (${p.reference})`}</dd>
        {p.note && <><dt>নোট</dt><dd>{p.note}</dd></>}
      </dl>
      <div class="amount">জমা: {taka(p.amountMinor)}</div>
      <table>
        <tbody>
          <tr><td>কোর্সের মোট টাকা</td><td>{taka(L.totalMinor)}</td></tr>
          <tr><td>এই রসিদসহ মোট জমা</td><td>{taka(L.paidMinor)}</td></tr>
          <tr><td>বাকি</td><td>{taka(L.dueMinor)}</td></tr>
          {L.next && <tr><td>পরের কিস্তি</td><td>{dayBn(L.next.dueDate)}, {taka(L.next.amountMinor)}</td></tr>}
        </tbody>
      </table>
      <footer>
        <span>গ্রহণ করেছেন: {forStaff ? p.recordedBy : p.method === 'online' ? 'অনলাইন (SSLCommerz)' : inst.name}<br />তৈরি: {dateBn(p.createdAt, true)}</span>
        <span class="sign">স্বাক্ষর</span>
      </footer>
    </main>
  </body>
</html>
