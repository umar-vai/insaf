---
import Icon from './Icon.astro';
import { SITE, whatsappUrl } from '../lib/site';
import { bnDigits } from '../lib/format';
interface Props { foundationTheme?: boolean; }
const { foundationTheme = false } = Astro.props;
---

<footer class="footer on-dark">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img class="footer__logo" src="/logo-wide-white.webp" alt="" width="200" height="53" loading="lazy" />
      <div class="social">
        <a href={SITE.facebook} rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href={foundationTheme ? 'https://youtu.be/3Af1wPgcbm0' : SITE.youtube} rel="noopener" aria-label="YouTube"><Icon name="youtube" /></a>
        {!foundationTheme && <a href={whatsappUrl()} rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>}
      </div>
    </div>

    <div>
      <p class="footer__head">দান করুন</p>
      <ul>
        <li><a href="/land">জমি ক্রয় প্রজেক্ট</a></li>
        <li><a href="/donate">সকল তহবিল</a></li>
        <li><a href="/zakat">যাকাত ক্যালকুলেটর</a></li>
        <li><a href={foundationTheme ? '#foundation-payment-methods' : '/donate#bank'}>{foundationTheme ? 'ফাউন্ডেশনের ব্যাংক ও MFS' : 'ব্যাংকে দান'}</a></li>
      </ul>
    </div>

    <div>
      <p class="footer__head">মাদরাসা</p>
      <ul>
        <li><a href="/about">আমাদের সম্পর্কে</a></li>
        <li><a href="/blog">নোটিশ ও খবর</a></li>
        <li><a href="/admission">ভর্তি তথ্য</a></li>
        <li><a href="/account">স্টুডেন্ট ও শিক্ষক লগইন</a></li>
        <li><a href="/faq">প্রশ্নোত্তর</a></li>
        <li><a href="/contact">যোগাযোগ</a></li>
        <li><a href="/privacy-policy">প্রাইভেসি পলিসি</a></li>
        <li><a href="/terms-and-conditions">শর্তাবলি</a></li>
      </ul>
    </div>

    <div>
      <p class="footer__head">যোগাযোগ</p>
      <ul class="contact">
        {foundationTheme ? (
          <>
            <li><Icon name="phone" size={18} /><a href="tel:+8801334950777">01334950777 (হটলাইন)</a></li>
            <li><Icon name="phone" size={18} /><a href="tel:+8801612505599">01612505599 (যোগাযোগ)</a></li>
            <li><Icon name="pin" size={18} />27/A/3, Moneshwar 1st Lane, Hazaribagh, Dhaka-1209</li>
          </>
        ) : (
          <>
            <li><Icon name="phone" size={18} /><a href={`tel:${SITE.phone.tel}`}>{bnDigits(SITE.phone.display)}</a></li>
            <li><Icon name="mail" size={18} /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><Icon name="pin" size={18} /><a href={SITE.mapUrl} rel="noopener">{SITE.address}</a></li>
          </>
        )}
      </ul>
      <p class="footer__head footer__head--pay">পেমেন্ট করা যায়</p>
      <ul class="pay">
        {(foundationTheme ? ['Islami Bank', 'bKash', 'Nagad', 'CellFin'] : SITE.payments).map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {bnDigits(new Date().getFullYear())} {SITE.nameBn}। {SITE.slogan}।</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-16);
    position: relative;
  }
  .footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--leaf-500), var(--gold-300), var(--leaf-500));
  }
  .footer__grid {
    display: grid;
    gap: var(--space-10) var(--space-8);
    grid-template-columns: 1.4fr repeat(3, 1fr);
  }
  .footer__head {
    font: 650 var(--text-sm) / 1.4 var(--font-display);
    color: var(--gold-300);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-4);
  }
  .footer__head--pay {
    margin-top: var(--space-6);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .footer a:not(.button) {
    color: var(--color-on-dark);
    text-decoration: none;
  }
  .footer a:not(.button):hover {
    color: var(--leaf-400);
  }
  .contact li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--space-3);
    align-items: start;
  }
  .contact :global(svg) {
    margin-top: 0.3em;
    color: var(--leaf-400);
  }
  .contact a {
    overflow-wrap: anywhere;
  }
  .pay {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pay li {
    padding: 0.15em 0.8em;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    font-size: var(--text-xs);
  }
  .social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.18);
    transition: background 0.2s;
  }
  .social a:hover {
    background: rgb(255 255 255 / 0.08);
  }
  .footer__bottom {
    margin-top: var(--space-12);
    padding-block: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--text-xs);
    color: var(--color-on-dark-muted);
  }
  .footer__bottom p {
    margin: 0;
  }
  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
