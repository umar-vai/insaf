---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { decideReview, listDonations, listFunds, MANUAL_METHOD_BN, voidDonation, type DonationFilter } from '../../../server/donations';
import { localsMayDo } from '../../../server/staff';
import { bnDigits, dateBn, taka } from '../../../lib/format';

const actor = Astro.locals.staff!;
// Accepting a held payment or voiding an office entry is a decision: full level.
const full = localsMayDo(Astro.locals, 'online_sales', 'full');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const back = String(form.get('back') ?? '').startsWith('?') ? String(form.get('back')) : '?';
  if (!full) return Astro.redirect(`/admin/donations${back}&error=owner`, 303);
  const ref = String(form.get('ref') ?? '');
  const note = String(form.get('note') ?? '');
  const action = form.get('action');
  const ok =
    action === 'void' ? await voidDonation(env.DB, actor, ref, note) : action === 'accept' || action === 'reject' ? await decideReview(env.DB, actor, ref, action === 'accept', note) : false;
  return Astro.redirect(`/admin/donations${back}&${ok ? 'saved=1' : 'error=reason'}`, 303);
}

const p = Astro.url.searchParams;
const filter: DonationFilter = {
  fundId: p.get('fund') ?? undefined,
  status: p.get('status') ?? 'counted',
  q: p.get('q')?.trim().slice(0, 60) || undefined,
  from: p.get('from') ?? undefined,
  to: p.get('to') ?? undefined,
  source: p.get('source') ?? undefined,
};
const [funds, list] = await Promise.all([listFunds(env.DB, { all: true }), listDonations(env.DB, filter, 500)]);
const STATUS: Record<string, string> = { counted: 'নিশ্চিত দান', review: 'যাচাই বাকি', pending: 'পেমেন্ট শুরু হয়েছে', failed: 'ব্যর্থ', cancelled: 'বাতিল (দাতা)', voided: 'বাতিল (অফিস)', '': 'সব' };
const STATUS_BN: Record<string, string> = { paid: 'পরিশোধিত', review: 'যাচাই বাকি', pending: 'অসম্পূর্ণ', failed: 'ব্যর্থ', cancelled: 'বাতিল' };
const back = `?${p.toString()}`;
const csv = `/admin/donations/export.csv?${p.toString()}`;
---

<Admin title="সব দান">
  <header class="page-head">
    <div>
      <p class="eyebrow">দান CRM</p>
      <h1>সব দান</h1>
      <p>অনলাইন ও অফিসে পাওয়া সব দান। ভুল এন্ট্রি মুছে ফেলা যায় না, কারণসহ বাতিল করা যায়।</p>
    </div>
    <div class="actions">
      <a class="button button--ghost" href={csv}><Icon name="download" /> Excel (CSV)</a>
      <a class="button" href="/admin/donations/record"><Icon name="plus" /> অফিসে পাওয়া দান</a>
    </div>
  </header>

  <form class="card filters" method="get">
    <label class="field"><span>তহবিল</span><select name="fund"><option value="">সব তহবিল</option>{funds.map((f) => <option value={f.id} selected={f.id === filter.fundId}>{f.title}</option>)}</select></label>
    <label class="field"><span>অবস্থা</span><select name="status">{Object.entries(STATUS).map(([k, v]) => <option value={k} selected={k === (p.get('status') ?? 'counted')}>{v}</option>)}</select></label>
    <label class="field"><span>থেকে</span><input type="date" name="from" value={filter.from ?? ''} /></label>
    <label class="field"><span>পর্যন্ত</span><input type="date" name="to" value={filter.to ?? ''} /></label>
    <label class="field wide"><span>খুঁজুন</span><input name="q" value={filter.q ?? ''} placeholder="নাম, মোবাইল, ইমেইল বা রসিদ নম্বর" /></label>
    <button class="button">দেখুন</button>
  </form>

  <section class="card">
    <div class="card__head">
      <h2>{bnDigits(list.count)}টি এন্ট্রি</h2>
      <strong>নিশ্চিত: {taka(list.totalMinor)}</strong>
    </div>
    {
      list.rows.length === 0 ? (
        <div class="empty"><Icon name="receipt" size={28} /><p>কিছু পাওয়া যায়নি।</p></div>
      ) : (
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>তারিখ</th><th>দাতা</th><th>তহবিল</th><th class="num">টাকা</th><th>মাধ্যম</th><th>অবস্থা</th><th></th></tr>
            </thead>
            <tbody>
              {list.rows.map((d) => {
                const key = d.donorPhone || d.donorEmail || d.donorName.toLowerCase();
                return (
                  <tr class={d.voidedAt ? 'void' : ''}>
                    <td>{dateBn(d.paidAt ?? d.createdAt, true)}<small class="muted"><br />{d.reference}</small></td>
                    <td>
                      <a href={`/admin/donors/${encodeURIComponent(key)}`}><strong>{d.donorName}</strong></a>
                      {d.anonymous ? <span class="pill pill--info">নাম গোপন</span> : null}
                      <small class="muted"><br />{d.donorPhone || d.donorEmail}{d.onBehalf && ` · পক্ষে: ${d.onBehalf}`}</small>
                      {d.utmSource && <small class="muted"><br />উৎস: {d.utmSource}{d.utmCampaign && ` / ${d.utmCampaign}`}</small>}
                    </td>
                    <td>{d.fundTitle}</td>
                    <td class="num">{taka(d.amountMinor)}</td>
                    <td>{d.gateway === 'manual' ? `অফিস: ${MANUAL_METHOD_BN[d.method] ?? d.method}` : `অনলাইন${d.method ? `: ${d.method}` : ''}`}{d.recordedBy && <small class="muted"><br />{d.recordedBy}</small>}</td>
                    <td>
                      {d.voidedAt ? <span class="pill pill--cancelled">বাতিল</span> : <span class={`pill pill--${d.status}`}>{STATUS_BN[d.status]}</span>}
                      {d.reviewReason && <small class="muted"><br />{d.reviewReason}</small>}
                      {d.voidReason && <small class="bad"><br />{d.voidReason}</small>}
                    </td>
                    <td class="keep">
                      {full && d.status === 'review' && (
                        <form method="post" class="inline">
                          <input type="hidden" name="ref" value={d.reference} />
                          <input type="hidden" name="back" value={back} />
                          <input name="note" required minlength="2" placeholder="নোট (যেমন ব্যাংকে মিলেছে)" aria-label="নোট" />
                          <button class="button button--sm" name="action" value="accept">গ্রহণ</button>
                          <button class="button button--sm button--danger" name="action" value="reject">বাদ</button>
                        </form>
                      )}
                      {full && d.gateway === 'manual' && !d.voidedAt && (
                        <form method="post" class="inline" data-confirm="এই দান বাতিল করবেন? হিসাবে আর ধরা হবে না।">
                          <input type="hidden" name="action" value="void" />
                          <input type="hidden" name="ref" value={d.reference} />
                          <input type="hidden" name="back" value={back} />
                          <input name="note" required minlength="3" placeholder="কেন" aria-label="বাতিলের কারণ" />
                          <button class="button button--sm button--danger">বাতিল</button>
                        </form>
                      )}
                      {d.status === 'paid' && !d.voidedAt && <a href={`/donate/done?ref=${d.reference}`} target="_blank">রসিদ</a>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</Admin>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm!)) e.preventDefault();
    }),
  );
</script>

<style>
  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3);
    align-items: end;
    margin-bottom: var(--space-5);
  }
  .filters .wide {
    grid-column: span 2;
  }
  .inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-1);
  }
  .inline input {
    min-width: 9rem;
  }
  tr.void td {
    opacity: 0.6;
  }
  @media (max-width: 600px) {
    .filters .wide {
      grid-column: auto;
    }
  }
</style>
