---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { listDonors } from '../../../server/donations';
import { waNumber } from '../../../lib/offline';
import { bnDigits, dateBn, taka } from '../../../lib/format';

const q = Astro.url.searchParams.get('q')?.trim().slice(0, 60) ?? '';
const donors = await listDonors(env.DB, q, 500);
const total = donors.reduce((s, d) => s + d.totalMinor, 0);
const repeat = donors.filter((d) => d.gifts > 1).length;
---

<Admin title="দাতা (CRM)">
  <header class="page-head">
    <div>
      <p class="eyebrow">দান CRM</p>
      <h1>দাতাগণ</h1>
      <p>একই মোবাইল নম্বরের সব দান এক দাতার নামে ধরা হয়। নাম চাপলে তাঁর পুরো দানের ইতিহাস দেখা যাবে।</p>
    </div>
  </header>

  <div class="kpis">
    <div class="kpi"><span class="kpi__label">দাতা</span><strong class="kpi__value">{bnDigits(donors.length)}</strong></div>
    <div class="kpi"><span class="kpi__label">একাধিকবার দিয়েছেন</span><strong class="kpi__value">{bnDigits(repeat)}</strong></div>
    <div class="kpi"><span class="kpi__label">এই তালিকার মোট</span><strong class="kpi__value">{taka(total)}</strong></div>
  </div>

  <form class="toolbar" method="get">
    <input name="q" value={q} placeholder="নাম, মোবাইল বা ইমেইল" aria-label="খুঁজুন" />
    <button class="button button--ghost">খুঁজুন</button>
  </form>

  <section class="card">
    {
      donors.length === 0 ? (
        <div class="empty"><Icon name="users" size={28} /><p>কোনো দাতা পাওয়া যায়নি।</p></div>
      ) : (
        <div class="table-wrap">
          <table>
            <thead><tr><th>দাতা</th><th class="num">মোট</th><th class="num">দান</th><th>প্রথম / শেষ</th><th>তহবিল</th><th></th></tr></thead>
            <tbody>
              {donors.map((d) => {
                const wa = d.phone ? waNumber(d.phone) : null;
                return (
                  <tr>
                    <td><a href={`/admin/donors/${encodeURIComponent(d.key)}`}><strong>{d.name}</strong></a><small class="muted"><br />{d.phone || d.email}</small></td>
                    <td class="num">{taka(d.totalMinor)}</td>
                    <td class="num">{bnDigits(d.gifts)}</td>
                    <td><small>{dateBn(d.firstAt)}<br />{dateBn(d.lastAt)}</small></td>
                    <td><small>{d.funds}</small></td>
                    <td class="keep">
                      {d.phone && <a class="button button--sm button--ghost" href={`tel:${d.phone}`} aria-label="ফোন"><Icon name="phone" size={16} /></a>}
                      {wa && <a class="button button--sm button--wa" href={`https://wa.me/${wa}`} rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={16} /></a>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</Admin>

<style>
  .toolbar {
    display: flex;
    gap: var(--space-2);
    margin: var(--space-5) 0;
    max-width: 520px;
  }
  .keep {
    display: flex;
    gap: var(--space-1);
  }
</style>
