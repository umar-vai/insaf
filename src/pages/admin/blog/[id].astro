---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { adminPost, blogCategories, deletePost, parsePostForm, removePostCover, setPostCover, updatePost, uploadPostImage } from '../../../server/blog';
import { mediaUrl } from '../../../lib/format';

const id = Astro.params.id ?? '';
const actor = Astro.locals.staff!;
const ERRORS: Record<string, string> = {
  title: 'শিরোনাম ২ থেকে ২০০ অক্ষরের মধ্যে দিন।',
  slug: 'ঠিকানায় শুধু ছোট হাতের ইংরেজি অক্ষর, সংখ্যা আর হাইফেন দিন (যেমন surah-kahf), আর অন্য লেখার সাথে মিলবে না।',
  status: 'অবস্থা বেছে নিন।',
  date: 'তারিখ ঠিক নেই।',
  missing: 'ছবি বেছে নিন।',
  type: 'ছবি JPG, PNG বা WebP হতে হবে।',
  size: 'ছবি ৫ MB এর মধ্যে রাখুন।',
};
let error: string | null = null;
let posted: FormData | null = null;

if (Astro.request.method === 'POST') {
  posted = await Astro.request.formData();
  const action = posted.get('action');
  if (action === 'image') {
    // Picture dropped into the article; the editor puts the URL in place.
    const r = await uploadPostImage(env.DB, env.MEDIA, id, posted.get('image'));
    return Response.json(r.ok ? { url: r.url } : { error: ERRORS[r.reason] }, { status: r.ok ? 200 : 400 });
  }
  if (action === 'cover') {
    const r = await setPostCover(env.DB, env.MEDIA, actor, id, posted.get('cover'));
    if (r.ok) return Astro.redirect(`/admin/blog/${id}?saved=1`, 303);
    error = ERRORS[r.reason]!;
    posted = null;
  } else if (action === 'cover.remove') {
    await removePostCover(env.DB, env.MEDIA, actor, id);
    return Astro.redirect(`/admin/blog/${id}?saved=1`, 303);
  } else if (action === 'delete') {
    if (posted.get('confirm') === 'yes' && (await deletePost(env.DB, env.MEDIA, actor, id))) return Astro.redirect('/admin/blog?saved=1', 303);
    error = 'মুছতে হলে নিশ্চিত করার ঘরে টিক দিন।';
    posted = null;
  } else {
    const parsed = parsePostForm(posted);
    if (parsed.ok) {
      const r = await updatePost(env.DB, env.MEDIA, actor, id, parsed.value);
      if (r === true) return Astro.redirect(`/admin/blog/${id}?saved=1`, 303);
      error = r === 'slug' ? ERRORS.slug! : 'সংরক্ষণ করা যায়নি।';
    } else error = ERRORS[parsed.error] ?? 'তথ্য ঠিক নেই।';
  }
}

const p = await adminPost(env.DB, id);
if (!p) return new Response(null, { status: 404 });
const categories = await blogCategories(env.DB);
const val = (k: string, saved: string) => (posted ? String(posted.get(k) ?? '') : saved);
const body = posted ? String(posted.get('body') ?? '') : p.bodyHtml;
const isNew = Astro.url.searchParams.get('new') === '1';
---

<Admin title={p.title}>
  <p>
    <a href="/admin/blog">← সব লেখা</a>
    {p.status === 'published' && <> · <a href={`/blog/${p.slug}`} target="_blank" rel="noopener">সাইটে দেখুন</a></>}
  </p>
  <h1>{p.title}</h1>
  {isNew && <p class="panel muted">লেখাটি খসড়া হিসেবে তৈরি হয়েছে। নিচে লিখুন, ছবি দিন, তারপর অবস্থা "চালু" করে সংরক্ষণ করুন।</p>}
  {error && <p class="err" role="alert">{error}</p>}

  <section class="panel cover">
    <div class="cover__img">
      {p.coverKey ? <img src={mediaUrl(p.coverKey)} alt="" width="320" height="180" /> : <span class="muted">কভার ছবি নেই</span>}
    </div>
    <form method="post" enctype="multipart/form-data" class="cover__form">
      <input type="hidden" name="action" value="cover" />
      <strong>কভার ছবি</strong>
      <small class="muted">JPG, PNG বা WebP দিন, আপলোডের সময় নিজে থেকেই ছোট WebP হয়ে যাবে। ১৬:৯ মাপ (যেমন ১৬০০×৯০০) সবচেয়ে ভালো দেখায়। শেয়ার করলে ফেসবুকেও এই ছবি দেখাবে।</small>
      <input type="file" name="cover" accept="image/jpeg,image/png,image/webp" required />
      <div class="row">
        <button class="button" type="submit">ছবি আপলোড করুন</button>
      </div>
    </form>
    {
      p.coverKey && (
        <form method="post">
          <input type="hidden" name="action" value="cover.remove" />
          <button class="button button--ghost" type="submit">ছবি সরান</button>
        </form>
      )
    }
  </section>

  <form method="post" class="form" data-post-form>
    <div class="panel main">
      <label class="field"><span>শিরোনাম</span><input name="title" value={val('title', p.title)} required maxlength="200" class="big" /></label>

      <div class="field">
        <span>লেখা</span>
        <div class="editor">
          <div class="tools" role="toolbar" aria-label="লেখার সরঞ্জাম">
            <button type="button" data-cmd="formatBlock" data-arg="h2" title="বড় শিরোনাম">H2</button>
            <button type="button" data-cmd="formatBlock" data-arg="h3" title="ছোট শিরোনাম">H3</button>
            <button type="button" data-cmd="formatBlock" data-arg="p" title="সাধারণ লেখা">¶</button>
            <span class="sep"></span>
            <button type="button" data-cmd="bold" title="মোটা"><b>B</b></button>
            <button type="button" data-cmd="italic" title="বাঁকা"><i>I</i></button>
            <button type="button" data-cmd="underline" title="নিচে দাগ"><u>U</u></button>
            <button type="button" data-cmd="strikeThrough" title="কাটা দাগ"><s>S</s></button>
            <span class="sep"></span>
            <button type="button" data-cmd="insertUnorderedList" title="বুলেট তালিকা">• তালিকা</button>
            <button type="button" data-cmd="insertOrderedList" title="নম্বর তালিকা">১. তালিকা</button>
            <button type="button" data-cmd="formatBlock" data-arg="blockquote" title="উদ্ধৃতি">❝ উদ্ধৃতি</button>
            <button type="button" data-cmd="insertHorizontalRule" title="বিভাজক">―</button>
            <span class="sep"></span>
            <button type="button" data-link title="লিংক">🔗 লিংক</button>
            <button type="button" data-cmd="unlink" title="লিংক সরান">লিংক সরান</button>
            <button type="button" data-image title="ছবি">🖼 ছবি</button>
            <button type="button" data-video title="YouTube ভিডিও">▶ ভিডিও</button>
            <span class="sep"></span>
            <button type="button" data-cmd="removeFormat" title="ফরম্যাট মুছুন">ফরম্যাট মুছুন</button>
            <button type="button" data-cmd="undo" title="আগের অবস্থায়">↶</button>
            <button type="button" data-cmd="redo" title="আবার">↷</button>
          </div>
          <div class="prose content" contenteditable="true" data-editor set:html={body || '<p></p>'} aria-label="লেখা" role="textbox" aria-multiline="true"></div>
          <input type="file" accept="image/jpeg,image/png,image/webp" data-image-file hidden />
          <p class="status muted" data-status aria-live="polite"></p>
        </div>
        <textarea name="body" data-body hidden></textarea>
        <small class="muted">লেখার মাঝে ছবি দিতে "ছবি" চাপুন। YouTube ভিডিও দিতে "ভিডিও" চাপুন, লিংকটি নিজের লাইনে থাকলে সাইটে ভিডিও হিসেবে দেখাবে।</small>
      </div>

      <label class="field">
        <span>সংক্ষেপ (ব্লগের তালিকায় আর গুগলে দেখায়; খালি রাখলে লেখার শুরু থেকে নেওয়া হবে)</span>
        <textarea name="excerpt" rows="3" maxlength="400">{val('excerpt', p.excerpt)}</textarea>
      </label>
    </div>

    <aside class="side-col">
      <div class="panel">
        <h2>প্রকাশ</h2>
        <label class="field">
          <span>অবস্থা</span>
          <select name="status">
            <option value="draft" selected={val('status', p.status) === 'draft'}>খসড়া (লুকানো)</option>
            <option value="published" selected={val('status', p.status) === 'published'}>চালু (সবাই দেখবে)</option>
          </select>
        </label>
        <label class="field"><span>প্রকাশের তারিখ</span><input type="date" name="publishedDate" value={val('publishedDate', p.publishedAt?.slice(0, 10) ?? '')} /></label>
        <label class="check"><input type="checkbox" name="featured" checked={posted ? posted.get('featured') === 'on' : p.featured} /> ব্লগ পেজের সবার উপরে দেখান</label>
        <button class="button button--block" type="submit">সংরক্ষণ করুন</button>
      </div>

      <div class="panel">
        <h2>বিস্তারিত</h2>
        <label class="field">
          <span>বিষয়</span>
          <input name="category" list="cats" maxlength="60" value={val('category', p.category)} placeholder="যেমন: নোটিশ" />
          <datalist id="cats">{categories.map((c) => <option value={c.name} />)}</datalist>
        </label>
        <label class="field"><span>লেখক</span><input name="authorName" maxlength="80" value={val('authorName', p.authorName)} placeholder="যেমন: মাদরাসাতুল ইনসাফ" /></label>
        <label class="field">
          <span>ওয়েব ঠিকানা: /blog/<b>{p.slug}</b></span>
          <input name="slug" maxlength="120" value={val('slug', p.slug)} pattern="[a-z0-9]+(-[a-z0-9]+)*" />
          <small class="muted">চালু লেখার ঠিকানা বদলালে পুরোনো লিংক আর কাজ করবে না।</small>
        </label>
      </div>

      <div class="panel">
        <h2>গুগল (SEO)</h2>
        <label class="field"><span>গুগলে শিরোনাম (খালি রাখলে লেখার শিরোনাম)</span><input name="seoTitle" maxlength="120" value={val('seoTitle', p.seoTitle ?? '')} /></label>
        <label class="field"><span>গুগলে বিবরণ (খালি রাখলে সংক্ষেপ)</span><textarea name="seoDescription" rows="3" maxlength="300">{val('seoDescription', p.seoDescription ?? '')}</textarea></label>
      </div>
    </aside>
  </form>

  <form method="post" class="panel danger">
    <input type="hidden" name="action" value="delete" />
    <strong>লেখাটি মুছে ফেলুন</strong>
    <label class="check"><input type="checkbox" name="confirm" value="yes" /> হ্যাঁ, লেখা আর এর ছবিগুলো চিরতরে মুছে যাবে</label>
    <button class="button button--ghost" type="submit"><Icon name="close" size={18} /> মুছুন</button>
  </form>
</Admin>

<script>
  import { toWebp } from '../../../lib/to-webp';

  const editor = document.querySelector('[data-editor]') as HTMLElement;
  const body = document.querySelector('[data-body]') as HTMLTextAreaElement;
  const status = document.querySelector('[data-status]') as HTMLElement;
  const fileInput = document.querySelector('[data-image-file]') as HTMLInputElement;
  const form = document.querySelector('[data-post-form]') as HTMLFormElement;
  let dirty = false;

  // Remember where the cursor was, since toolbar clicks and dialogs move focus.
  let saved: Range | null = null;
  const keep = () => {
    const sel = getSelection();
    if (sel && sel.rangeCount && editor.contains(sel.anchorNode)) saved = sel.getRangeAt(0).cloneRange();
  };
  const restore = () => {
    editor.focus();
    if (saved) {
      const sel = getSelection()!;
      sel.removeAllRanges();
      sel.addRange(saved);
    }
  };
  editor.addEventListener('keyup', keep);
  editor.addEventListener('mouseup', keep);
  editor.addEventListener('input', () => {
    dirty = true;
    keep();
  });
  document.execCommand('defaultParagraphSeparator', false, 'p');

  const run = (cmd: string, arg?: string) => {
    restore();
    document.execCommand(cmd, false, arg);
    dirty = true;
    keep();
  };
  document.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) => {
    b.addEventListener('mousedown', (e) => e.preventDefault());
    b.addEventListener('click', () => run(b.dataset.cmd!, b.dataset.arg ? `<${b.dataset.arg}>` : undefined));
  });

  document.querySelector('[data-link]')!.addEventListener('click', () => {
    keep();
    const url = prompt('লিংক দিন (https:// দিয়ে শুরু, অথবা সাইটের পেজ যেমন /courses)');
    if (!url) return;
    if (!/^(https?:\/\/|\/|mailto:|tel:)/i.test(url.trim())) return alert('লিংকটি https:// অথবা / দিয়ে শুরু হতে হবে।');
    const sel = getSelection();
    if (saved && saved.collapsed) run('insertHTML', `<a href="${url.trim().replace(/"/g, '&quot;')}">${url.trim().replace(/</g, '&lt;')}</a>`);
    else if (sel) run('createLink', url.trim());
  });

  document.querySelector('[data-video]')!.addEventListener('click', () => {
    keep();
    const url = prompt('YouTube ভিডিওর লিংক দিন');
    if (!url) return;
    if (!/^https?:\/\/(www\.|m\.)?(youtube\.com|youtu\.be)\//i.test(url.trim())) return alert('শুধু YouTube এর লিংক দেওয়া যাবে।');
    run('insertHTML', `<p>${url.trim().replace(/</g, '&lt;')}</p><p><br></p>`);
    status.textContent = 'ভিডিও যোগ হয়েছে। সাইটে এটি প্লেয়ার হিসেবে দেখাবে।';
  });

  const upload = async (picked: File) => {
    status.textContent = 'ছবি আপলোড হচ্ছে…';
    // Small WebP, made here in the browser before sending.
    const file = await toWebp(picked);
    const data = new FormData();
    data.append('action', 'image');
    data.append('image', file);
    try {
      const res = await fetch(location.pathname, { method: 'POST', body: data });
      const out = (await res.json()) as { url?: string; error?: string };
      if (!out.url) throw new Error(out.error ?? 'ছবি আপলোড করা যায়নি।');
      const alt = (file.name.replace(/\.[^.]+$/, '') || '').replace(/[<>"]/g, '');
      run('insertHTML', `<img src="${out.url}" alt="${alt}"><p><br></p>`);
      status.textContent = 'ছবি যোগ হয়েছে। সংরক্ষণ করতে ভুলবেন না।';
    } catch (err) {
      status.textContent = (err as Error).message;
    }
  };
  document.querySelector('[data-image]')!.addEventListener('click', () => {
    keep();
    fileInput.click();
  });
  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (f) upload(f);
    fileInput.value = '';
  });
  // Pictures can also be pasted or dropped straight into the article.
  editor.addEventListener('paste', (e) => {
    const f = [...(e.clipboardData?.files ?? [])].find((x) => x.type.startsWith('image/'));
    if (f) {
      e.preventDefault();
      keep();
      upload(f);
    }
  });
  editor.addEventListener('drop', (e) => {
    const f = [...(e.dataTransfer?.files ?? [])].find((x) => x.type.startsWith('image/'));
    if (f) {
      e.preventDefault();
      keep();
      upload(f);
    }
  });

  form.addEventListener('input', () => (dirty = true));
  form.addEventListener('submit', () => {
    body.value = editor.innerHTML;
    dirty = false;
  });
  addEventListener('beforeunload', (e) => {
    if (dirty) e.preventDefault();
  });
</script>

<style>
  .form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-4);
    align-items: start;
  }
  .main {
    display: grid;
    gap: var(--space-4);
  }
  .side-col {
    display: grid;
    gap: var(--space-4);
    position: sticky;
    top: var(--space-4);
  }
  .side-col .panel {
    display: grid;
    gap: var(--space-3);
  }
  .side-col h2 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .big {
    font: 650 var(--text-xl) / 1.3 var(--font-display) !important;
  }
  .check {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .editor {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--white);
  }
  .tools {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-line);
    background: var(--mint-50);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  .tools button {
    min-width: 36px;
    height: 34px;
    padding: 0 var(--space-2);
    border: 1px solid transparent;
    border-radius: 8px;
    background: none;
    color: var(--color-text);
    font: 600 var(--text-sm) / 1 var(--font-display);
    cursor: pointer;
  }
  .tools button:hover {
    background: var(--white);
    border-color: var(--color-line);
  }
  .sep {
    width: 1px;
    margin: 4px 2px;
    background: var(--color-line);
  }
  .content {
    max-width: none;
    min-height: 420px;
    padding: var(--space-5);
    outline: none;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .content :global(img) {
    max-width: 100%;
    border-radius: 8px;
    outline: 2px dashed transparent;
  }
  .content :global(img:hover) {
    outline-color: var(--color-accent);
  }
  .status {
    margin: 0;
    padding: 0 var(--space-5) var(--space-3);
    font-size: var(--text-sm);
  }
  .cover {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-4);
  }
  .cover__img {
    width: 240px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-tint);
    display: grid;
    place-items: center;
  }
  .cover__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover__form {
    display: grid;
    gap: var(--space-2);
    flex: 1;
    min-width: 240px;
  }
  .row {
    display: flex;
    gap: var(--space-2);
  }
  .danger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    border-color: #f3c2bc;
  }
  .err {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: #fde4e1;
    color: #8a1c12;
  }
  @media (max-width: 1000px) {
    .form {
      grid-template-columns: 1fr;
    }
    .side-col {
      position: static;
    }
  }
</style>
