---
import { env } from 'cloudflare:workers';
import Admin from '../../../../layouts/Admin.astro';
import Icon from '../../../../components/Icon.astro';
import MarkSheet from '../../../../components/MarkSheet.astro';
import { localsMayDo } from '../../../../server/staff';
import { addExamCandidate, configureAssessment, correctPublishedMark, examAssessment, examMarks, examRosterCandidates, markInputsFromForm, publishAssessment, saveExamMarks } from '../../../../server/assessment';
import { bnDigits } from '../../../../lib/format';
import { dayBn, todayDhaka } from '../../../../lib/offline';

// One exam's gradebook. Academic Full sets it up and publishes; anyone with
// Academic Edit (and the batch's teachers, on their own page) enters marks.
const id = Astro.params.id!;
const here = `/admin/offline/gradebook/${encodeURIComponent(id)}`;
const actor = Astro.locals.staff!;
const edit = localsMayDo(Astro.locals, 'academic', 'edit');
const full = localsMayDo(Astro.locals, 'academic', 'full');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  let result: { ok: boolean; error?: string } = { ok: false, error: 'permission' };
  if (action === 'configure' && full) {
    result = await configureAssessment(env.DB, actor, id, form.get('max'), form.get('pass'), form.get('confirm') === 'yes');
  } else if (action === 'add-candidate' && full) {
    result = await addExamCandidate(env.DB, actor, id, String(form.get('enrollmentId') ?? ''), todayDhaka());
  } else if (action === 'correct' && full) {
    result = await correctPublishedMark(env.DB, actor, id, { enrollmentId: String(form.get('enrollmentId') ?? ''), obtained: form.get('obtained'), absent: form.get('absent') === 'on', comment: form.get('comment') }, String(form.get('reason') ?? ''));
  } else if (action === 'marks' && edit) {
    result = await saveExamMarks(env.DB, actor, id, markInputsFromForm(form));
  } else if (action === 'publish' && full) {
    result = form.get('confirm') === 'yes' ? await publishAssessment(env.DB, actor, id) : { ok: false, error: 'confirm' };
  }
  return Astro.redirect(`${here}?${result.ok ? 'saved=1' : `error=${encodeURIComponent(result.error ?? 'invalid')}`}`, 303);
}

const exam = await examAssessment(env.DB, id);
if (!exam) return new Response('পরীক্ষাটি পাওয়া যায়নি।', { status: 404 });
const rows = exam.status || exam.rosterFrozen ? await examMarks(env.DB, id) : [];
const candidates = full && exam.rosterFrozen && exam.examStatus === 'scheduled' && exam.status !== 'published' && exam.examDate >= todayDhaka()
  ? await examRosterCandidates(env.DB, exam) : [];
const ready = exam.status === 'draft' && exam.examStatus === 'scheduled' && exam.examinees > 0 && exam.completed === exam.examinees;
const ERRORS: Record<string, string> = {
  reason: 'সংশোধনের কারণ লিখুন।', no_change: 'আগের ফলের সাথে কোনো পরিবর্তন নেই।', not_eligible: 'ছাত্রটি এই পরীক্ষার জন্য যোগ করা যাচ্ছে না।',
  marks: 'নম্বর পূর্ণমানের মধ্যে লিখুন। কিছুই সংরক্ষণ হয়নি, ঠিক করে আবার সংরক্ষণ করুন।',
  confirm: 'নিশ্চিত করার ঘরে টিক দিন।',
  exam: 'বাতিল পরীক্ষার গ্রেডবুক তৈরি করা যায় না।',
  empty_roster: 'পরীক্ষার্থীর তালিকা খালি। আগে ব্যাচে ছাত্র যুক্ত করুন।',
  already_configured: 'গ্রেডবুক আগেই তৈরি হয়েছে। পরীক্ষার্থী ও পূর্ণমান আর বদলানো যায় না।',
  roster_too_large: 'একটি পরীক্ষায় সর্বোচ্চ ১০০০ জন পরীক্ষার্থী রাখা যায়।',
  locked: 'ফল প্রকাশিত বা পরীক্ষা বাতিল, তাই নম্বর বদলানো যাবে না।',
  incomplete: 'সবার নম্বর বা অনুপস্থিতি না দেওয়া পর্যন্ত ফল প্রকাশ করা যাবে না।',
  permission: 'এই কাজের অনুমতি আপনার নেই।',
};
const err = Astro.url.searchParams.get('error');
---

<Admin title={`গ্রেডবুক · ${exam.title}`}>
  <header class="page-head">
    <div>
      <p class="eyebrow"><a href="/admin/offline/results">ফল ও গ্রেডবুক</a> · <a href={`/admin/offline/batches/${exam.batchId}`}>{exam.batchName}</a></p>
      <h1>{exam.title}</h1>
      <p>{exam.subject || 'বিষয় লেখা নেই'} · {dayBn(exam.examDate)}</p>
    </div>
  </header>
  {err && <p class="note note--bad" role="alert">{ERRORS[err] ?? 'কাজটি করা যায়নি।'}</p>}
  {exam.examStatus === 'cancelled' && <p class="note note--bad">এই পরীক্ষা বাতিল হয়েছে। এর নম্বর দেওয়া বা ফল প্রকাশ করা যাবে না।</p>}

  <div class="kpis">
    <div class="kpi"><span class="kpi__icon"><Icon name="users" /></span><span class="kpi__label">পরীক্ষার্থী</span><strong class="kpi__value">{bnDigits(exam.examinees)}</strong></div>
    <div class="kpi"><span class="kpi__icon"><Icon name="check" /></span><span class="kpi__label">নম্বর দেওয়া হয়েছে</span><strong class="kpi__value">{bnDigits(exam.completed)}</strong></div>
    <div class={`kpi ${exam.status === 'published' ? 'kpi--info' : ''}`}><span class="kpi__icon"><Icon name="chart" /></span><span class="kpi__label">ফল</span><strong class="kpi__value">{exam.status === 'published' ? 'প্রকাশিত' : exam.status === 'draft' ? 'খসড়া' : 'শুরু হয়নি'}</strong></div>
  </div>

  {candidates.length > 0 && <details class="card block">
    <summary>পরে ভর্তি হওয়া পরীক্ষার্থী যোগ করুন</summary>
    <form method="post" class="form-grid" data-confirm="পরীক্ষার্থী ও প্রযোজ্য পরীক্ষার ফি যোগ করবেন?">
      <input type="hidden" name="action" value="add-candidate" />
      <label class="field"><span>যোগ্য ছাত্র</span><select name="enrollmentId" required><option value="">বাছুন</option>{candidates.map((r) => <option value={r.id}>{r.name} · {r.roll}</option>)}</select></label>
      <button class="button">পরীক্ষার্থী যোগ করুন</button>
    </form>
  </details>}
  {!exam.status && exam.examStatus === 'scheduled' && (
    <section class="card block">
      <h2>গ্রেডবুক তৈরি করুন</h2>
      <p class="muted">পরীক্ষার্থীর তালিকা যাচাই করে পূর্ণমান ও পাস নম্বর দিন।</p>
      {exam.rosterFrozen > 0 && (rows.length ? <details><summary>পরীক্ষার্থীর তালিকা ({bnDigits(rows.length)} জন)</summary><ul>{rows.map((r) => <li>{r.roll && `${r.roll} · `}{r.studentName}</li>)}</ul></details> : <p class="note note--warn">পরীক্ষার্থী নেই। ক্লাসের ভর্তি যাচাই করে তালিকা হালনাগাদ করুন।</p>)}
      {full ? (
        <form method="post" class="form-grid" data-confirm="পরীক্ষার্থী তালিকা, পূর্ণমান ও পাস নম্বর স্থির করবেন?">
          <input type="hidden" name="action" value="configure" />
          <label class="field"><span>পূর্ণমান</span><input name="max" type="number" min="1" max="1000" required value="100" /></label>
          <label class="field"><span>পাস নম্বর</span><input name="pass" type="number" min="0" max="1000" required /></label>
          <label class="check wide"><input name="confirm" type="checkbox" value="yes" required /> ব্যাচের ছাত্র তালিকা ও নম্বরের নিয়ম যাচাই করেছি।</label>
          <button class="button">গ্রেডবুক তৈরি করুন</button>
        </form>
      ) : (
        <p class="note">একাডেমিক বিভাগে Full অনুমতি আছে এমন কেউ গ্রেডবুক তৈরি করবেন।</p>
      )}
    </section>
  )}

  {exam.status && (
    <>
      <MarkSheet exam={exam} rows={rows} editable={edit && exam.status === 'draft' && exam.examStatus === 'scheduled'} />
      {exam.status === 'draft' && !ready && exam.examStatus === 'scheduled' && (
        <p class="note">সব {bnDigits(exam.examinees)} জনের নম্বর বা অনুপস্থিতি দেওয়া হলে ফল প্রকাশ করা যাবে। বাকি {bnDigits(exam.examinees - exam.completed)} জন।</p>
      )}
      {ready && full && (
        <form method="post" class="card block publish" data-confirm="যাচাই করা ফল প্রকাশ করবেন? প্রকাশিত ফল সংশোধনে কারণ লিখতে হবে।">
          <input type="hidden" name="action" value="publish" />
          <h2>ফল প্রকাশ</h2>
          <label class="check"><input type="checkbox" name="confirm" value="yes" required /> সবার নম্বর ও অনুপস্থিতি যাচাই করেছি। ছাত্র ও যাচাই করা অভিভাবকের জন্য ফল প্রকাশ করছি।</label>
          <button class="button"><Icon name="check" /> ফল প্রকাশ করুন</button>
        </form>
      )}
      {ready && !full && <p class="note">সব নম্বর দেওয়া হয়েছে। একাডেমিক Full অনুমতির কেউ ফল প্রকাশ করবেন।</p>}
      {exam.status === 'published' && <p class="note note--good">ফল প্রকাশিত। ছাত্র ও যাচাই করা অভিভাবক তাদের রিপোর্ট কার্ডে এটি দেখতে পাচ্ছেন।</p>}
    </>
  )}
  {exam.status === 'published' && full && <details class="card block">
    <summary>প্রকাশিত ফল সংশোধন</summary>
    <form method="post" class="form-grid" data-confirm="সংশোধিত ফল প্রকাশ করবেন? আগের নম্বর ইতিহাসে থাকবে।">
      <input type="hidden" name="action" value="correct" />
      <label class="field"><span>পরীক্ষার্থী</span><select name="enrollmentId" required><option value="">বাছুন</option>{rows.map((r) => <option value={r.enrollmentId}>{r.studentName} · {r.obtained === null ? 'অনুপস্থিত' : bnDigits(r.obtained)}</option>)}</select></label>
      <label class="field"><span>সংশোধিত নম্বর</span><input name="obtained" inputmode="numeric" /></label>
      <label class="check"><input name="absent" type="checkbox" /> অনুপস্থিত</label>
      <label class="field"><span>মন্তব্য (ঐচ্ছিক)</span><input name="comment" maxlength="500" /></label>
      <label class="field wide"><span>সংশোধনের কারণ</span><textarea name="reason" minlength="3" maxlength="300" required></textarea></label>
      <button class="button">সংশোধিত ফল প্রকাশ করুন</button>
    </form>
  </details>}
</Admin>

<style>
  .block {
    margin-top: var(--space-5);
  }
  .publish {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
</style>
