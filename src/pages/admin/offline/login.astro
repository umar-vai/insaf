---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { grantPasswordLogin } from '../../../server/password';
import { localsMayDo } from '../../../server/staff';
import { SITE } from '../../../lib/site';
import { bnDigits } from '../../../lib/format';

// Switches on a mobile number login for a student (guardian) or a teacher, or
// gives a new password. The password is shown here once, never stored in the
// clear, so the office writes it down or sends it now.
if (Astro.request.method !== 'POST') return Astro.redirect('/admin/offline', 303);
const form = await Astro.request.formData();
const kind = form.get('kind') === 'teacher' ? 'teacher' : 'student';
const id = String(form.get('id') ?? '');
const back = kind === 'teacher' ? `/admin/offline/teachers/${id}` : `/admin/offline/students/${id}`;
if (kind === 'teacher' && !localsMayDo(Astro.locals, 'hr', 'edit')) return Astro.redirect(`${back}?error=owner`, 303);
const r = await grantPasswordLogin(env.DB, Astro.locals.staff!, kind, id);
if (!r.ok) return Astro.redirect(`${back}?error=${r.reason === 'phone' ? 'login_phone' : 'login'}`, 303);
const site = new URL('/account', Astro.url).href;
const message = `আসসালামু আলাইকুম। ${SITE.nameBn} পোর্টালে লগইন করুন:\n${site}\nমোবাইল: ${r.login}\nপাসওয়ার্ড: ${r.password}\nলগইনের পর পাসওয়ার্ড বদলে নিতে পারবেন।`;
const phone = /^01\d{9}$/.test(r.login) ? `88${r.login}` : '';
---

<Admin title="পোর্টাল লগইন">
  <header class="page-head">
    <div>
      <p class="eyebrow"><a href={back}>ফিরে যান</a></p>
      <h1>পোর্টাল লগইন চালু হয়েছে</h1>
      <p>এই পাসওয়ার্ড শুধু এখন একবার দেখা যাবে। লিখে নিন বা এখনই পাঠিয়ে দিন। আগের পাসওয়ার্ড (যদি থাকে) আর কাজ করবে না।</p>
    </div>
  </header>
  <section class="card creds">
    <dl>
      <div><dt>লগইন</dt><dd>{/^\d+$/.test(r.login) ? bnDigits(r.login) : r.login}</dd></div>
      <div><dt>পাসওয়ার্ড</dt><dd class="pw">{r.password}</dd></div>
      <div><dt>ঠিকানা</dt><dd>{site}</dd></div>
    </dl>
    <div class="actions">
      {phone && <a class="button button--wa" href={`https://wa.me/${phone}?text=${encodeURIComponent(message)}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp এ পাঠান</a>}
      {phone && <a class="button button--ghost" href={`sms:+${phone}?body=${encodeURIComponent(message)}`}><Icon name="mail" /> SMS</a>}
      <button class="button button--ghost" type="button" onclick="print()"><Icon name="printer" /> প্রিন্ট</button>
      <a class="button" href={back}>হয়ে গেছে</a>
    </div>
  </section>
</Admin>

<style>
  .creds dl {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
  }
  .creds dl div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
  }
  dd {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .pw {
    font: 700 1.6rem/1.2 ui-monospace, monospace;
    letter-spacing: 0.08em;
    color: var(--green-700);
  }
</style>
