---
import { env } from 'cloudflare:workers';
import { institute } from '../../../../server/config';
import { CERT_KIND_BN, getCertificate } from '../../../../server/certificates';
import { dayBn, studentCode } from '../../../../lib/offline';
import { bnDigits } from '../../../../lib/format';

// The certificate as a whole page, to print or save as PDF.
const c = await getCertificate(env.DB, Astro.params.id!);
if (!c) return new Response('Not found', { status: 404 });
const inst = await institute(env.DB);
const verifyUrl = `${Astro.url.origin}/verify/${c.code}`;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{c.title} | {c.studentName}</title>
    <style>
      :root { color-scheme: light; }
      body { margin: 0; background: #eef4ef; font-family: 'Hind Siliguri', 'Nirmala UI', system-ui, sans-serif; color: #10261b; }
      .tools { text-align: center; margin: 16px; display: flex; gap: 8px; justify-content: center; }
      .tools button, .tools a { font: inherit; padding: 10px 20px; border-radius: 8px; border: 0; background: #0b3d2a; color: #fff; cursor: pointer; text-decoration: none; }
      .tools a { background: #fff; color: #0b3d2a; border: 1px solid #0b3d2a; }
      .sheet { max-width: 760px; margin: 16px auto; background: #fff; padding: 48px 56px; border: 6px double #0b3d2a; box-shadow: 0 2px 10px rgb(0 0 0 / 0.08); position: relative; }
      header { text-align: center; border-bottom: 2px solid #b8913a; padding-bottom: 16px; }
      header img { height: 60px; }
      header p { margin: 4px 0; color: #4b6357; font-size: 14px; }
      .meta { display: flex; justify-content: space-between; margin: 16px 0 0; font-size: 14px; color: #4b6357; }
      h1 { text-align: center; font-size: 28px; margin: 28px 0 8px; color: #0b3d2a; }
      .kind { text-align: center; margin: 0 0 24px; color: #4b6357; }
      .body { font-size: 18px; line-height: 2.1; text-align: justify; white-space: pre-line; min-height: 160px; }
      .revoked { margin: 16px 0; padding: 10px; border: 2px solid #b42318; color: #b42318; font-weight: 700; text-align: center; }
      footer { margin-top: 64px; display: flex; justify-content: space-between; align-items: end; gap: 24px; font-size: 13px; color: #4b6357; }
      .sign { border-top: 1px solid #10261b; padding-top: 4px; min-width: 180px; text-align: center; color: #10261b; }
      .verify { font-size: 12px; word-break: break-all; }
      @media print { body { background: #fff; } .tools { display: none; } .sheet { box-shadow: none; margin: 0 auto; } }
    </style>
  </head>
  <body>
    <div class="tools"><button type="button" onclick="print()">প্রিন্ট বা PDF</button><a href="/admin/offline/certificates">ফিরে যান</a></div>
    <main class="sheet">
      <header>
        <img src={inst.logo} alt={inst.name} />
        <p><strong>{inst.name}</strong></p>
        <p>{inst.address} · {bnDigits(inst.phone)}</p>
      </header>
      <div class="meta"><span>ক্রমিক নং: {bnDigits(c.serialNo)}</span><span>তারিখ: {dayBn(c.issuedOn)}</span></div>
      {c.status === 'revoked' && <p class="revoked">এই সনদ বাতিল করা হয়েছে: {c.revokeReason}</p>}
      <h1>{c.title}</h1>
      <p class="kind">{CERT_KIND_BN[c.kind]} · {c.studentName} {studentCode(c.studentNo)}</p>
      <p class="body">{c.body}</p>
      <footer>
        <div class="verify">যাচাই করুন: {verifyUrl}<br />কোড: <strong>{c.code}</strong></div>
        <div class="sign">মুহতামিম / প্রধানের স্বাক্ষর ও সিল</div>
      </footer>
    </main>
  </body>
</html>
