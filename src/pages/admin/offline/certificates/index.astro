---
import { env } from 'cloudflare:workers';
import Admin from '../../../../layouts/Admin.astro';
import Icon from '../../../../components/Icon.astro';
import { localsMayDo } from '../../../../server/staff';
import {
  CERT_KIND_BN, CERT_KINDS, certificateTemplate, issueCertificate, listCertificates, parseCertificateForm, revokeCertificate, studentFacts, type CertKind,
} from '../../../../server/certificates';
import { dayBn, studentCode, todayDhaka } from '../../../../lib/offline';
import { bnDigits } from '../../../../lib/format';

// Issue a certificate in two steps: pick the student and the kind (the
// template is filled from the record), edit the wording, then issue.
const actor = Astro.locals.staff!;
const full = localsMayDo(Astro.locals, 'office', 'full');
const today = todayDhaka();
const here = '/admin/offline/certificates';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'revoke') {
    if (!full) return Astro.redirect(`${here}?error=full`, 303);
    const ok = await revokeCertificate(env.DB, actor, String(form.get('id') ?? ''), String(form.get('reason') ?? ''));
    return Astro.redirect(`${here}?${ok ? 'saved=1' : 'error=revoke'}`, 303);
  }
  const v = parseCertificateForm(form, today);
  if (!v.ok) return Astro.redirect(`${here}?error=${v.error}`, 303);
  const r = await issueCertificate(env.DB, actor, v.value);
  if (!r.ok) return Astro.redirect(`${here}?error=${r.error}`, 303);
  return Astro.redirect(`${here}/${r.value}`, 303);
}

const q = Astro.url.searchParams;
const studentId = (q.get('studentId') ?? '').slice(0, 40);
const kind = ((CERT_KINDS as readonly string[]).includes(q.get('kind') ?? '') ? q.get('kind') : '') as CertKind | '';
const facts = studentId && kind ? await studentFacts(env.DB, studentId) : null;
const draft = facts && kind ? certificateTemplate(kind, facts) : null;
const [list, students] = await Promise.all([
  listCertificates(env.DB),
  env.DB.prepare('SELECT id, name, student_no AS no, status FROM offline_students ORDER BY status, student_no, name LIMIT 5000').all<{ id: string; name: string; no: number | null; status: string }>(),
]);
const ERR: Record<string, string> = {
  student: 'ছাত্র বাছুন।', kind: 'সনদের ধরন বাছুন।', title: 'শিরোনাম লিখুন।', body: 'সনদের লেখা দিন।', date: 'তারিখ সঠিক নয় (ভবিষ্যতের তারিখ হবে না)।',
  busy: 'আবার চেষ্টা করুন।', full: 'সনদ বাতিল করতে অফিসে সম্পূর্ণ অনুমতি লাগবে।', revoke: 'বাতিলের কারণ লিখুন।',
};
const err = q.get('error');
---

<Admin title="সনদ ও ছাড়পত্র">
  <header class="page-head">
    <div>
      <p class="eyebrow">ছাত্র ও ফি</p>
      <h1>সনদ ও ছাড়পত্র</h1>
      <p>ছাড়পত্র, চারিত্রিক সনদ, প্রত্যয়নপত্র ও সমাপনী সনদ তৈরি করে প্রিন্ট করুন। প্রতিটি সনদে ক্রমিক নম্বর ও যাচাই কোড থাকে; কোডটি দিয়ে যে কেউ ওয়েবসাইটে সনদটি সঠিক কিনা দেখতে পারবেন।</p>
    </div>
  </header>
  {err && <p class="note note--bad" role="alert">{ERR[err] ?? 'কাজটি করা যায়নি।'}</p>}

  <section class="card">
    <div class="card__head"><h2>নতুন সনদ</h2></div>
    <form method="get" class="form-grid">
      <label class="field wide"><span>ছাত্র</span>
        <select name="studentId" required><option value="">বাছুন</option>
          {students.results.map((s) => <option value={s.id} selected={s.id === studentId}>{s.name} {studentCode(s.no)}{s.status !== 'active' ? ' (বন্ধ)' : ''}</option>)}
        </select>
      </label>
      <label class="field"><span>ধরন</span>
        <select name="kind" required><option value="">বাছুন</option>{CERT_KINDS.map((k) => <option value={k} selected={k === kind}>{CERT_KIND_BN[k]}</option>)}</select>
      </label>
      <button class="button button--ghost"><Icon name="text" /> লেখা তৈরি করুন</button>
    </form>
    {draft && (
      <form method="post" class="form-grid draft">
        <input type="hidden" name="studentId" value={studentId} />
        <input type="hidden" name="kind" value={kind} />
        <p class="wide note">নিচের লেখাটি ছাত্রের রেকর্ড থেকে বসানো একটি শুরু মাত্র। প্রিন্টের আগে মাদরাসার অনুমোদিত ভাষা অনুযায়ী পড়ে ঠিক করে নিন।</p>
        <label class="field wide"><span>শিরোনাম</span><input name="title" required maxlength="120" value={draft.title} /></label>
        <label class="field wide"><span>সনদের লেখা</span><textarea name="body" rows="6" required maxlength="3000">{draft.body}</textarea></label>
        <label class="field"><span>তারিখ</span><input type="date" name="issuedOn" max={today} value={today} /></label>
        <button class="button"><Icon name="certificate" /> সনদ তৈরি করুন</button>
      </form>
    )}
  </section>

  <section class="card section-block">
    <div class="card__head"><h2>দেওয়া সনদ</h2></div>
    {list.length === 0 ? <p class="muted">এখনো কোনো সনদ দেওয়া হয়নি।</p> : (
      <div class="table-wrap"><table>
        <thead><tr><th>ক্রমিক</th><th>ছাত্র</th><th>ধরন</th><th>তারিখ</th><th>অবস্থা</th><th></th></tr></thead>
        <tbody>{list.map((c) => (
          <tr>
            <td>{bnDigits(c.serialNo)}</td>
            <td><a href={`/admin/offline/students/${c.studentId}`}>{c.studentName}</a> <small class="muted">{studentCode(c.studentNo)}</small></td>
            <td>{CERT_KIND_BN[c.kind]}</td>
            <td>{dayBn(c.issuedOn)}</td>
            <td>{c.status === 'issued' ? <span class="pill pill--paid">বৈধ</span> : <span class="pill pill--cancelled" title={c.revokeReason ?? ''}>বাতিল</span>}</td>
            <td class="row-actions">
              <a class="button button--sm button--ghost" href={`${here}/${c.id}`}><Icon name="printer" /> প্রিন্ট</a>
              {full && c.status === 'issued' && (
                <form method="post" class="inline" data-confirm="এই সনদ বাতিল করবেন? যাচাই পাতায় বাতিল দেখাবে।">
                  <input type="hidden" name="action" value="revoke" /><input type="hidden" name="id" value={c.id} />
                  <input name="reason" required minlength="2" maxlength="300" placeholder="কারণ" aria-label="বাতিলের কারণ" />
                  <button class="button button--sm button--danger">বাতিল</button>
                </form>
              )}
            </td>
          </tr>
        ))}</tbody>
      </table></div>
    )}
  </section>
</Admin>
<style>
  .section-block { margin-top: var(--space-5); }
  .table-wrap { overflow: auto; }
  .draft { margin-top: var(--space-5); border-top: 1px solid var(--line, #dfe8e2); padding-top: var(--space-5); }
  .inline { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; }
  .row-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }
</style>
