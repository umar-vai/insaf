---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { decideExpense, expensesBetween, parseExpenseForm, pendingExpenses, recordExpense, usedCategories, voidExpense } from '../../../server/office';
import { getSettings } from '../../../server/settings';
import { IMAGE_TYPES, storeUpload } from '../../../server/files';
import { localsMayDo } from '../../../server/staff';
import { addMonths, dayBn, EXPENSE_CATEGORIES, METHOD_BN, monthBn, PAY_METHODS, todayDhaka, type PayMethod } from '../../../lib/offline';
import { bnDigits, taka } from '../../../lib/format';
import AccountsNav from '../../../components/admin/AccountsNav.astro';
import { GENERAL_FUND, listFunds, listProjects, newExpenseStage, voucherCode } from '../../../server/accounts';

const today = todayDhaka();
const actor = Astro.locals.staff!;
// Owners, and team members with full power in this part, approve and void.
const owner = localsMayDo(Astro.locals, 'accounts', 'full');
// The real owners give the second step of a large expense.
const isOwner = Boolean(Astro.locals.staffOwner);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'approve' || form.get('action') === 'reject') {
    if (!owner) return Astro.redirect('/admin/offline/expenses?error=owner', 303);
    const rules = await getSettings(env.DB);
    const r = await decideExpense(env.DB, actor, String(form.get('id') ?? ''), form.get('action') === 'approve' ? 'approved' : 'rejected', { owner: isOwner, full: owner }, rules.expenseOwnerOver);
    const okay = r === 'approved' || r === 'rejected' || r === 'checked';
    return Astro.redirect(`/admin/offline/expenses?${okay ? `saved=1${r === 'checked' ? '&checked=1' : ''}` : `error=${r === 'missing' ? 'expense' : r}`}`, 303);
  }
  if (form.get('action') === 'void') {
    if (!owner) return Astro.redirect('/admin/offline/expenses?error=owner', 303);
    const ok = await voidExpense(env.DB, actor, String(form.get('id') ?? ''), String(form.get('reason') ?? ''));
    return Astro.redirect(`/admin/offline/expenses?m=${form.get('m')}&${ok ? 'saved=1' : 'error=reason'}`, 303);
  }
  const v = parseExpenseForm(form, today);
  if (!v.ok) return Astro.redirect(`/admin/offline/expenses?new=1&error=${v.error}`, 303);
  let voucher: string | null = null;
  const file = form.get('voucher');
  if (file instanceof File && file.size > 0) {
    const stored = await storeUpload(env.MEDIA, file, 'private/vouchers', IMAGE_TYPES, 5 * 1024 * 1024);
    if (!stored.ok) return Astro.redirect(`/admin/offline/expenses?new=1&error=voucher_${stored.reason}`, 303);
    voucher = stored.file.key;
  }
  // One or two approval steps, depending on the amount and who records it.
  const rules = await getSettings(env.DB);
  const stage = newExpenseStage(v.value.amountTaka, { owner: isOwner, full: owner }, { approvalOver: rules.expenseApprovalOver, ownerOver: rules.expenseOwnerOver });
  const newId = await recordExpense(env.DB, actor, v.value, voucher, stage === 'approved' ? false : stage);
  return Astro.redirect(`/admin/offline/expenses?m=${v.value.spentOn.slice(0, 7)}&saved=1&done=${newId}${stage !== 'approved' ? `&waits=${stage}` : ''}`, 303);
}

const asked = Astro.url.searchParams.get('m') ?? '';
const thisMonth = today.slice(0, 7);
const month = /^\d{4}-(0[1-9]|1[0-2])$/.test(asked) ? asked : thisMonth;
const [r, used, pending, s, projects, funds] = await Promise.all([expensesBetween(env.DB, `${month}-01`, `${month}-31`), usedCategories(env.DB), pendingExpenses(env.DB), getSettings(env.DB), listProjects(env.DB), listFunds(env.DB)]);
const needsOwner = (minor: number) => s.expenseOwnerOver > 0 && minor > s.expenseOwnerOver * 100;
const done = Astro.url.searchParams.get('done');
const ERR: Record<string, string> = { owner: 'অনুমোদন বা বাতিল করতে হিসাবে সম্পূর্ণ ক্ষমতা লাগবে।', self: 'নিজের লেখা খরচ নিজে অনুমোদন করা যায় না, অন্য কেউ অনুমোদন দেবেন।', expense: 'খরচটি আর অপেক্ষায় নেই।', reason: 'বাতিলের কারণ লিখুন।', amount: 'টাকার অঙ্ক সঠিক নয়।', spentOn: 'তারিখ সঠিক নয়।', category: 'খাত লিখুন।' };
const err = Astro.url.searchParams.get('error');
const categories = [...new Set([...used, ...EXPENSE_CATEGORIES])];
const top = r.byCategory[0]?.totalMinor ?? 1;
---

<Admin title="খরচ ও ভাউচার">
  <header class="page-head">
    <div>
      <p class="eyebrow">হিসাব</p>
      <h1>খরচ ও ভাউচার</h1>
      <p>প্রতিষ্ঠানের প্রতিটি খরচ লিখে রাখুন, ভাউচারের ছবি থাকলে সাথে দিন। ভুল হলে মালিক কারণসহ বাতিল করতে পারেন, মুছে ফেলা যায় না।</p>
    </div>
    <div class="actions"><a class="button" href="?new=1#new"><Icon name="plus" /> খরচ লিখুন</a></div>
  </header>

  <AccountsNav />
  {err && <p class="note note--bad" role="alert">{ERR[err] ?? 'কাজটি করা যায়নি।'}</p>}
  {Astro.url.searchParams.get('waits') === 'pending' && <p class="note note--warn" role="status">খরচটি অনুমোদনের অপেক্ষায় আছে। অনুমোদনের আগে হিসাবে ধরা হবে না।</p>}
  {Astro.url.searchParams.get('waits') === 'checked' && <p class="note note--warn" role="status">খরচটি {taka(s.expenseOwnerOver * 100)} এর বেশি। আপনার যাচাই (১ম ধাপ) হয়ে গেছে, এখন মালিকের চূড়ান্ত অনুমোদন লাগবে।</p>}
  {Astro.url.searchParams.has('checked') && <p class="note note--good" role="status">১ম ধাপের যাচাই হয়েছে। মালিক চূড়ান্ত অনুমোদন দিলে হিসাবে ধরা হবে।</p>}
  {done && <p class="note note--good" role="status"><span>খরচ সংরক্ষণ হয়েছে।</span> <a class="button button--sm" href={`/admin/offline/accounts/voucher/${done}`} target="_blank"><Icon name="printer" /> ভাউচার প্রিন্ট</a></p>}

  {
    pending.length > 0 && (
      <section class="card waiting">
        <div class="card__head"><h2><Icon name="alert" /> অনুমোদনের অপেক্ষায় ({bnDigits(pending.length)})</h2></div>
        <ul class="list">
          {pending.map((e) => (
            <li>
              <div>
                <strong>{voucherCode('expense', e.voucherNo)} {e.category}: {taka(e.amountMinor)}</strong>
                <small>{dayBn(e.spentOn)} · {e.party || e.description || 'বিবরণ নেই'} · লিখেছেন {e.recordedBy}{e.voucherKey && <> · <a href={`/admin/offline/voucher/${e.id}`} target="_blank">ভাউচারের ছবি</a></>}</small>
                <small>{needsOwner(e.amountMinor) ? (e.checkedBy ? `১ম ধাপ যাচাই করেছেন ${e.checkedBy} · মালিকের চূড়ান্ত অনুমোদন বাকি` : 'দুই ধাপ: হিসাবরক্ষকের যাচাই, তারপর মালিক') : 'এক ধাপের অনুমোদন'}</small>
              </div>
              {owner && (isOwner || e.recordedBy !== actor) && !(needsOwner(e.amountMinor) && e.checkedBy && !isOwner) ? (
                <form method="post" class="decide">
                  <input type="hidden" name="id" value={e.id} />
                  <button class="button button--sm" name="action" value="approve"><Icon name="check" /> {needsOwner(e.amountMinor) && !isOwner ? 'যাচাই করলাম (১ম ধাপ)' : 'অনুমোদন'}</button>
                  <button class="button button--sm button--danger" name="action" value="reject">নামঞ্জুর</button>
                </form>
              ) : (
                <small class="muted">{e.recordedBy === actor && !isOwner ? 'অন্য কেউ অনুমোদন দেবেন' : 'মালিক দেখবেন'}</small>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <details class="card new" id="new" open={Astro.url.searchParams.has('new')}>
    <summary><strong>নতুন খরচ</strong></summary>
    <form method="post" class="form-grid" enctype="multipart/form-data">
      <input type="hidden" name="nonce" value={crypto.randomUUID()} />
      <label class="field"><span>খাত</span><input name="category" required list="exp-cats" maxlength="60" placeholder="যেমন বাড়ি ভাড়া" /></label>
      <datalist id="exp-cats">{categories.map((c) => <option value={c} />)}</datalist>
      <label class="field"><span>টাকা</span><input name="amount" required inputmode="numeric" /></label>
      <label class="field"><span>তারিখ</span><input name="spentOn" type="date" required value={today} max={today} /></label>
      <label class="field"><span>কীভাবে দেওয়া হয়েছে</span><select name="method">{PAY_METHODS.map((m) => <option value={m}>{METHOD_BN[m]}</option>)}</select></label>
      <label class="field"><span>যাঁকে দেওয়া হয়েছে</span><input name="party" maxlength="120" placeholder="দোকান, ব্যক্তি বা প্রতিষ্ঠান" /></label>
      <label class="field"><span>তহবিল</span><select name="fundId">{funds.map((f) => <option value={f.id} selected={f.id === GENERAL_FUND}>{f.name}</option>)}</select></label>
      <label class="field"><span>প্রকল্প (ঐচ্ছিক)</span><select name="projectId"><option value="">কোনোটি নয়</option>{projects.map((p) => <option value={p.id}>{p.name}</option>)}</select></label>
      <label class="field wide"><span>বিবরণ (ঐচ্ছিক)</span><input name="description" maxlength="500" placeholder="কী বাবদ" /></label>
      {!isOwner && (s.expenseApprovalOver > 0 || s.expenseOwnerOver > 0) && <p class="wide muted"><small>{!owner && s.expenseApprovalOver > 0 && `${taka(s.expenseApprovalOver * 100)} এর বেশি খরচ হিসাবরক্ষক অনুমোদন দিলে তবেই হিসাবে ধরা হবে। `}{s.expenseOwnerOver > 0 && `${taka(s.expenseOwnerOver * 100)} এর বেশি হলে মালিকের চূড়ান্ত অনুমোদনও লাগবে।`}</small></p>}
      <label class="field wide"><span>ভাউচারের ছবি (ঐচ্ছিক, JPG বা PNG)</span><input name="voucher" type="file" accept="image/jpeg,image/png,image/webp" /></label>
      <button class="button">খরচ সংরক্ষণ করুন</button>
    </form>
  </details>

  <form class="toolbar" method="get">
    <a class="button button--ghost" href={`?m=${addMonths(`${month}-01`, -1).slice(0, 7)}`} aria-label="আগের মাস">‹</a>
    <input type="month" name="m" value={month} aria-label="মাস বাছুন" />
    <button class="button button--ghost">দেখুন</button>
    {month < thisMonth && <a class="button button--ghost" href={`?m=${addMonths(`${month}-01`, 1).slice(0, 7)}`} aria-label="পরের মাস">›</a>}
  </form>

  <div class="cols cols--wide top">
    <section class="card">
      <div class="card__head"><h2>{monthBn(month, true)} এর খরচ</h2><strong>{taka(r.totalMinor)}</strong></div>
      {
        r.expenses.length === 0 ? (
          <div class="empty"><Icon name="wallet" size={28} /><p>এই মাসে কোনো খরচ লেখা হয়নি।</p></div>
        ) : (
          <div class="table-wrap">
            <table>
              <thead><tr><th>তারিখ</th><th>খাত ও বিবরণ</th><th>মাধ্যম</th><th class="num">টাকা</th><th>ভাউচার</th><th></th></tr></thead>
              <tbody>
                {r.expenses.map((e) => (
                  <tr class={e.voidedAt || e.status === 'rejected' ? 'void' : ''}>
                    <td>{dayBn(e.spentOn)}{e.status !== 'approved' && <><br /><span class={`pill pill--${e.status === 'pending' ? 'pending' : 'absent'}`}>{e.status === 'pending' ? 'অপেক্ষায়' : 'নামঞ্জুর'}</span></>}</td>
                    <td><strong>{e.category}</strong>{e.party && <small class="muted"><br />{e.party}</small>}{e.description && <small class="muted"><br />{e.description}</small>}{(e.projectName || (e.fundName && e.fundId !== GENERAL_FUND)) && <small class="muted"><br />{[e.fundId !== GENERAL_FUND ? e.fundName : '', e.projectName].filter(Boolean).join(' · ')}</small>}<small class="muted"><br />{e.recordedBy}</small></td>
                    <td>{METHOD_BN[e.method as PayMethod] ?? e.method}</td>
                    <td class="num">{taka(e.amountMinor)}</td>
                    <td><a href={`/admin/offline/accounts/voucher/${e.id}`} target="_blank">{voucherCode('expense', e.voucherNo) || 'প্রিন্ট'}</a>{e.voucherKey && <><br /><a href={`/admin/offline/voucher/${e.id}`} target="_blank"><small>ছবি</small></a></>}</td>
                    <td class="keep">
                      {e.voidedAt ? (
                        <small class="bad">বাতিল: {e.voidReason}</small>
                      ) : (
                        owner && (
                          <form method="post" class="void-form" data-confirm="এই খরচ বাতিল করবেন? হিসাবে আর ধরা হবে না।">
                            <input type="hidden" name="action" value="void" />
                            <input type="hidden" name="id" value={e.id} />
                            <input type="hidden" name="m" value={month} />
                            <input name="reason" required minlength="2" placeholder="কেন" aria-label="বাতিলের কারণ" />
                            <button class="button button--sm button--danger">বাতিল</button>
                          </form>
                        )
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
    <section class="card">
      <div class="card__head"><h2>খাত অনুযায়ী</h2></div>
      {
        r.byCategory.length === 0 ? (
          <p class="muted">কিছু নেই।</p>
        ) : (
          <ul class="bars">
            {r.byCategory.map((c) => (
              <li>
                <span class="bars__label">{c.label}</span>
                <span class="bars__val">{taka(c.totalMinor)} <small class="muted">({bnDigits(Math.round((c.totalMinor / r.totalMinor) * 100))}%)</small></span>
                <span class="bars__track"><span style={`width:${Math.max(2, (c.totalMinor / top) * 100)}%`}></span></span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Admin>

<style>
  .new {
    margin-bottom: var(--space-5);
  }
  .new[open] summary {
    margin-bottom: var(--space-4);
  }
  .top {
    margin-top: 0;
  }
  .waiting {
    margin-bottom: var(--space-5);
    border-color: var(--warn-700);
  }
  .waiting h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .decide {
    display: flex;
    gap: var(--space-2);
  }
  .void td.keep {
    text-decoration: none;
    opacity: 1;
  }
  .void-form {
    display: flex;
    gap: var(--space-1);
  }
  .void-form input {
    min-width: 90px;
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1);
  }
  .bars__track {
    grid-column: 1 / -1;
    height: 8px;
    border-radius: 99px;
    background: var(--chart-grid);
  }
  .bars__track span {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: var(--chart-expense);
  }
</style>
