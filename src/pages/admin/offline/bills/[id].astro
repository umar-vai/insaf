---
import { env } from 'cloudflare:workers';
import Admin from '../../../../layouts/Admin.astro';
import Icon from '../../../../components/Icon.astro';
import { localsMayDo } from '../../../../server/staff';
import { billRunCharges, cancelBillRun, getBillRun } from '../../../../server/fee-bills';
import { dayBn, studentCode } from '../../../../lib/offline';
import { bnDigits, dateBn, taka } from '../../../../lib/format';

const id = Astro.params.id!;
const here = `/admin/offline/bills/${encodeURIComponent(id)}`;
const full = localsMayDo(Astro.locals, 'office', 'full');
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (!full) return Astro.redirect(`${here}?error=full`, 303);
  const ok = await cancelBillRun(env.DB, Astro.locals.staff!, id, String(form.get('reason') ?? ''));
  return Astro.redirect(`${here}?${ok ? 'saved=1' : 'error=cancel'}`, 303);
}
const run = await getBillRun(env.DB, id);
if (!run) return new Response('Not found', { status: 404 });
const charges = await billRunCharges(env.DB, id);
---

<Admin title={run.title}>
  <header class="page-head">
    <div>
      <p class="eyebrow"><a href="/admin/offline/bills">একসাথে ফি বিল</a></p>
      <h1>{run.title}</h1>
      <p>
        {run.targetKind === 'all' ? 'সব চালু ছাত্র' : run.targetName} · প্রতি জন {taka(run.amountMinor)} · শেষ তারিখ {dayBn(run.dueDate)} ·
        {bnDigits(run.createdCount)} জন, মোট {taka(run.totalMinor)} · {run.createdBy}, {dateBn(run.createdAt, true)}
      </p>
    </div>
    <div class="actions">
      <a class="button button--ghost" href={`/admin/offline/bills/print?kind=${run.targetKind}&id=${encodeURIComponent(run.targetId)}`}><Icon name="printer" /> বকেয়া বিল প্রিন্ট</a>
    </div>
  </header>
  {Astro.url.searchParams.get('error') === 'full' && <p class="note note--bad">বিল বাতিল করতে অফিসে সম্পূর্ণ অনুমতি লাগবে।</p>}
  {Astro.url.searchParams.get('error') === 'cancel' && <p class="note note--bad">বাতিলের কারণ লিখুন। আগেই বাতিল হয়ে থাকলে আর করা যাবে না।</p>}
  {run.status === 'cancelled' && <p class="note note--warn">এই বিল বাতিল করা হয়েছে: {run.cancelReason}। সব চার্জ বাতিল হিসেবে রেকর্ডে আছে।</p>}

  <section class="card">
    <div class="card__head"><h2>যাদের বিল হয়েছে</h2></div>
    {charges.length === 0 ? <p class="muted">কারো বিল হয়নি।</p> : (
      <div class="table-wrap"><table>
        <thead><tr><th>ছাত্র</th><th>বিভাগ</th><th>টাকা</th><th></th></tr></thead>
        <tbody>{charges.map((c) => (
          <tr><td><a href={`/admin/offline/students/${c.studentId}`}>{c.studentName}</a> <small class="muted">{studentCode(c.studentNo)}</small></td>
            <td>{c.courseTitle}</td><td>{taka(c.amountMinor)}</td><td>{c.voidedAt && <span class="pill pill--cancelled">বাতিল</span>}</td></tr>
        ))}</tbody>
      </table></div>
    )}
  </section>

  {run.status === 'posted' && full && (
    <section class="card section-block">
      <div class="card__head"><h2>পুরো বিল বাতিল</h2></div>
      <p class="muted">ভুল বিল হলে বাতিল করুন। সব ছাত্রের এই চার্জ বাতিল হয়ে রেকর্ডে থাকবে। কেউ টাকা দিয়ে থাকলে সেই টাকা তার অন্য বকেয়াতে জমা হিসেবে থাকবে।</p>
      <form method="post" class="form-grid" data-confirm="পুরো বিল বাতিল করবেন?">
        <label class="field wide"><span>কারণ</span><input name="reason" required minlength="2" maxlength="300" /></label>
        <button class="button button--danger">বিল বাতিল করুন</button>
      </form>
    </section>
  )}
</Admin>
<style>
  .section-block { margin-top: var(--space-5); }
  .table-wrap { overflow: auto; }
</style>
