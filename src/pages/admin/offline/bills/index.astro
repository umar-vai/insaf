---
import { env } from 'cloudflare:workers';
import Admin from '../../../../layouts/Admin.astro';
import Icon from '../../../../components/Icon.astro';
import { localsMayDo } from '../../../../server/staff';
import { listOfflineCourses } from '../../../../server/offline';
import { listBatches } from '../../../../server/office';
import {
  BILL_HEAD_BN, billPreview, billPreviewKey, endConcession, listBillRuns, listConcessions, parseBillForm, parseConcessionForm, postBillRun, setConcession, type BillInput,
} from '../../../../server/fee-bills';
import { addMonths, dayBn, studentCode, todayDhaka } from '../../../../lib/offline';
import { bnDigits, dateBn, taka } from '../../../../lib/format';

// Fee bills for many students at once, with a preview first, and the
// concession list. Posting needs the office edit level (the middleware
// already refuses view only); ending a concession or cancelling a run needs full.
const actor = Astro.locals.staff!;
const full = localsMayDo(Astro.locals, 'office', 'full');
const today = todayDhaka();
const here = '/admin/offline/bills';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'post') {
    const v = parseBillForm(form);
    if (!v.ok) return Astro.redirect(`${here}?error=${v.error}`, 303);
    if (form.get('confirm') !== 'yes') return Astro.redirect(`${here}?error=confirm`, 303);
    const r = await postBillRun(env.DB, actor, v.value, String(form.get('runKey') ?? ''), today, true);
    if (!r.ok) return Astro.redirect(`${here}?error=${r.error}`, 303);
    return Astro.redirect(`${here}/${r.value.runId}?saved=1`, 303);
  }
  if (action === 'concession') {
    const v = parseConcessionForm(form);
    if (!v.ok) return Astro.redirect(`${here}?error=${v.error}#concessions`, 303);
    const ok = await setConcession(env.DB, actor, v.value);
    return Astro.redirect(`${here}?${ok ? 'saved=1' : 'error=student'}#concessions`, 303);
  }
  if (action === 'end-concession') {
    if (!full) return Astro.redirect(`${here}?error=full#concessions`, 303);
    const ok = await endConcession(env.DB, actor, String(form.get('id') ?? ''));
    return Astro.redirect(`${here}?${ok ? 'saved=1' : 'error=action'}#concessions`, 303);
  }
  return Astro.redirect(`${here}?error=action`, 303);
}

// The preview comes from the same form sent with GET (?preview=1).
const q = Astro.url.searchParams;
let preview: { input: BillInput; lines: Awaited<ReturnType<typeof billPreview>>; runKey: string } | null = null;
let previewError = '';
if (q.get('preview') === '1') {
  const f = new FormData();
  for (const [k, val] of q) f.set(k, val);
  const v = parseBillForm(f);
  if (v.ok) {
    const lines = await billPreview(env.DB, v.value, today);
    preview = { input: v.value, lines, runKey: await billPreviewKey(v.value, lines) };
  }
  else previewError = v.error;
}
const [courses, batches, runs, concessions, students] = await Promise.all([
  listOfflineCourses(env.DB, false),
  listBatches(env.DB, { activeOnly: true }),
  listBillRuns(env.DB),
  listConcessions(env.DB),
  env.DB.prepare("SELECT id, name, student_no AS no FROM offline_students WHERE status = 'active' ORDER BY student_no, name LIMIT 3000").all<{ id: string; name: string; no: number | null }>(),
]);
const billable = preview?.lines.filter((l) => !l.skip) ?? [];
const previewTotal = billable.reduce((a, l) => a + l.amountMinor, 0);
const ERR: Record<string, string> = {
  title: 'বিলের নাম লিখুন।', amount: 'সঠিক টাকার পরিমাণ লিখুন।', dueDate: 'শেষ তারিখ সঠিকভাবে দিন।', target: 'কাদের বিল হবে বাছুন।',
  head: 'ফির খাত বাছুন।', period: 'বিলিং মাস সঠিকভাবে বাছুন।',
  already: 'এই তালিকায় নতুন কোনো বিল নেই।', changed: 'তালিকা বা টাকার হিসাব বদলেছে। আবার প্রিভিউ দেখুন।',
  too_many: 'একবারে সর্বোচ্চ ৩,০০০ ভর্তি রেকর্ডে বিল করা যায়। বিভাগ বা ক্লাস বাছুন।',
  confirm: 'যাচাইয়ের টিক দিন।', nobody: 'এই তালিকায় কোনো চালু ছাত্র নেই।', key: 'আবার প্রিভিউ দেখে পোস্ট করুন।',
  student: 'ছাত্র বাছুন।', percent: 'ছাড় ১ থেকে ১০০ শতাংশের মধ্যে দিন।', reason: 'ছাড়ের কারণ লিখুন।', full: 'এই কাজে সম্পূর্ণ অনুমতি লাগবে।', action: 'কাজটি করা যায়নি।',
};
const err = q.get('error') ?? previewError;
const targetLabel = (i: BillInput) =>
  i.target.kind === 'all' ? 'সব চালু ছাত্র' : i.target.kind === 'course' ? `বিভাগ: ${courses.find((c) => c.id === i.target.id)?.title ?? ''}` : `ক্লাস: ${batches.find((b) => b.id === i.target.id)?.name ?? ''}`;
const defaultDue = addMonths(today.slice(0, 8) + '10', today.slice(8) > '10' ? 1 : 0);
---

<Admin title="একসাথে ফি বিল">
  <header class="page-head">
    <div>
      <p class="eyebrow">ছাত্র ও ফি</p>
      <h1>একসাথে ফি বিল</h1>
      <p>মাসিক টিউশন, সেশন ফি, বই বা অন্য ফি যোগ করুন। আগে দেখুন কার বিল হবে এবং কার ফি আগেই নির্ধারিত আছে। পরীক্ষার ফি ক্লাসের পরীক্ষা থেকে যোগ করুন।</p>
    </div>
    <div class="actions"><a class="button button--ghost" href={`${here}/print`}><Icon name="printer" /> বকেয়া বিল প্রিন্ট</a></div>
  </header>
  {err && <p class="note note--bad" role="alert">{ERR[err] ?? 'কাজটি করা যায়নি।'}</p>}

  <section class="card">
    <div class="card__head"><h2>নতুন বিল</h2></div>
    <form method="get" action={here} class="form-grid">
      <input type="hidden" name="preview" value="1" />
      <label class="field"><span>ফির খাত</span><select name="feeHead">{Object.entries(BILL_HEAD_BN).map(([key, name]) => <option value={key} selected={key === (q.get('feeHead') ?? 'other')}>{name}</option>)}</select></label>
      <label class="field"><span>বিলিং মাস</span><input name="billingPeriod" type="month" value={q.get('billingPeriod') ?? defaultDue.slice(0, 7)} required /></label>
      <label class="field wide"><span>বিলের নাম (রসিদে এভাবেই লেখা থাকবে)</span><input name="title" required minlength="2" maxlength="120" value={q.get('title') ?? ''} placeholder="যেমন: ডিসেম্বর মাসের বেতন" /></label>
      <label class="field"><span>প্রতি ছাত্রের টাকা</span><input name="amount" inputmode="numeric" required value={q.get('amount') ?? ''} /></label>
      <label class="field"><span>পরিশোধের শেষ তারিখ</span><input name="dueDate" type="date" required value={q.get('dueDate') ?? defaultDue} /></label>
      <label class="field"><span>কাদের বিল</span>
        <select name="targetKind">
          <option value="all" selected={q.get('targetKind') === 'all'}>সব চালু ছাত্র</option>
          <option value="course" selected={q.get('targetKind') === 'course'}>একটি বিভাগ</option>
          <option value="batch" selected={q.get('targetKind') === 'batch'}>একটি ক্লাস</option>
        </select>
      </label>
      <label class="field"><span>বিভাগ (বিভাগ বাছলে)</span>
        <select name="courseId"><option value="">বাছুন</option>{courses.map((c) => <option value={c.id} selected={q.get('courseId') === c.id}>{c.title}</option>)}</select>
      </label>
      <label class="field"><span>ক্লাস (ক্লাস বাছলে)</span>
        <select name="batchId"><option value="">বাছুন</option>{batches.map((b) => <option value={b.id} selected={q.get('batchId') === b.id}>{b.courseTitle} · {b.name}</option>)}</select>
      </label>
      <label class="field"><span>ছাড়</span>
        <select name="useConcessions">
          <option value="on">ছাড়ের তালিকা অনুযায়ী কম ধরুন</option>
          <option value="off" selected={q.get('useConcessions') === 'off'}>কারো ছাড় ধরবেন না</option>
        </select>
      </label>
      <button class="button button--ghost"><Icon name="search" /> আগে তালিকা দেখুন</button>
    </form>
  </section>

  {preview && (
    <section class="card section-block">
      <div class="card__head"><h2>যাচাই করুন: {preview.input.title}</h2><span class="pill pill--info">{targetLabel(preview.input)}</span></div>
      <p>
        {bnDigits(billable.length)} জনের বিল হবে, মোট <strong>{taka(previewTotal)}</strong>, শেষ তারিখ {dayBn(preview.input.dueDate)}।
        {preview.lines.length - billable.length > 0 && ` ${bnDigits(preview.lines.length - billable.length)}টি রেকর্ডে নতুন বিল হবে না।`}
      </p>
      {preview.lines.length === 0 ? <p class="muted">এই তালিকায় কোনো চালু ছাত্র নেই।</p> : (
        <div class="table-wrap"><table>
          <thead><tr><th>ছাত্র</th><th>বিভাগ ও ক্লাস</th><th>ছাড়</th><th>বিল</th></tr></thead>
          <tbody>{preview.lines.slice(0, 500).map((l) => (
            <tr><td>{l.studentName} <small class="muted">{studentCode(l.studentNo)}</small></td><td>{l.courseTitle}{l.batch && ` · ${l.batch}`}</td>
              <td>{l.percent ? `${bnDigits(l.percent)}%` : ''}</td><td>{l.skip === 'free' ? 'সম্পূর্ণ ছাড়' : l.skip === 'already' ? 'আগেই বিল হয়েছে' : l.skip === 'tuition' ? 'ভর্তির ফিতে অন্তর্ভুক্ত' : taka(l.amountMinor)}</td></tr>
          ))}</tbody>
        </table></div>
      )}
      {preview.lines.length > 500 && <p class="muted">প্রথম ৫০০ জন দেখানো হলো; পোস্ট করলে সবার বিল হবে।</p>}
      {preview.lines.length > 3000 && <p class="note note--warn">{ERR.too_many}</p>}
      {billable.length > 0 && preview.lines.length <= 3000 && (
        <form method="post" class="confirm" data-confirm={`${bnDigits(billable.length)} জনের বিল পোস্ট করবেন?`}>
          <input type="hidden" name="action" value="post" />
          <input type="hidden" name="runKey" value={preview.runKey} />
          <input type="hidden" name="title" value={preview.input.title} />
          <input type="hidden" name="amount" value={String(preview.input.amountMinor / 100)} />
          <input type="hidden" name="dueDate" value={preview.input.dueDate} />
          <input type="hidden" name="feeHead" value={preview.input.feeHead} />
          <input type="hidden" name="billingPeriod" value={preview.input.billingPeriod} />
          <input type="hidden" name="targetKind" value={preview.input.target.kind} />
          <input type="hidden" name="courseId" value={preview.input.target.kind === 'course' ? preview.input.target.id : ''} />
          <input type="hidden" name="batchId" value={preview.input.target.kind === 'batch' ? preview.input.target.id : ''} />
          <input type="hidden" name="useConcessions" value={preview.input.useConcessions ? 'on' : 'off'} />
          <label class="check"><input type="checkbox" name="confirm" value="yes" required /> তালিকা ও টাকা যাচাই করেছি</label>
          <button class="button"><Icon name="check" /> বিল পোস্ট করুন</button>
        </form>
      )}
    </section>
  )}

  <section class="card section-block">
    <div class="card__head"><h2>আগের বিল</h2></div>
    {runs.length === 0 ? <p class="muted">এখনো কোনো বিল পোস্ট হয়নি।</p> : (
      <div class="table-wrap"><table>
        <thead><tr><th>বিল</th><th>কাদের</th><th>জন</th><th>মোট</th><th>শেষ তারিখ</th><th>অবস্থা</th></tr></thead>
        <tbody>{runs.map((r) => (
          <tr>
            <td><a href={`${here}/${r.id}`}><strong>{r.title}</strong></a><br /><small class="muted">{dateBn(r.createdAt, true)}</small></td>
            <td>{r.targetKind === 'all' ? 'সব ছাত্র' : r.targetName}</td>
            <td>{bnDigits(r.createdCount)}</td>
            <td>{taka(r.totalMinor)}</td>
            <td>{dayBn(r.dueDate)}</td>
            <td><span class={`pill pill--${r.status === 'posted' ? 'paid' : 'cancelled'}`}>{r.status === 'posted' ? 'চালু' : 'বাতিল'}</span></td>
          </tr>
        ))}</tbody>
      </table></div>
    )}
  </section>

  <section class="card section-block" id="concessions">
    <div class="card__head"><h2>ছাড়ের তালিকা</h2><span class="pill pill--info">{bnDigits(concessions.length)} জন</span></div>
    <p class="muted">এখানে দেওয়া শতাংশ ছাড় শুধু একসাথে করা বিলে কাটা হয়। ভর্তির সময় ঠিক করা কোর্স ফির ছাড় ছাত্রের পাতায় আলাদা থাকে। নতুন ছাড় দিলে আগেরটি শেষ হয়ে ইতিহাসে থাকে।</p>
    <form method="post" class="form-grid">
      <input type="hidden" name="action" value="concession" />
      <label class="field wide"><span>ছাত্র</span>
        <select name="studentId" required><option value="">বাছুন</option>{students.results.map((s) => <option value={s.id}>{s.name} {studentCode(s.no)}</option>)}</select>
      </label>
      <label class="field"><span>ছাড় (শতাংশ, ১০০ মানে পুরো মাফ)</span><input name="percent" inputmode="numeric" required /></label>
      <label class="field"><span>কারণ</span><input name="reason" required minlength="2" maxlength="300" placeholder="যেমন: এতিম" /></label>
      <button class="button"><Icon name="plus" /> ছাড় দিন</button>
    </form>
    {concessions.length > 0 && (
      <ul class="list">{concessions.map((c) => (
        <li>
          <div><a href={`/admin/offline/students/${c.studentId}`}><strong>{c.studentName}</strong></a> <small class="muted">{studentCode(c.studentNo)}</small>
            <br /><small>{bnDigits(c.percent)}% · {c.reason} · {c.createdBy}</small></div>
          {full && <form method="post" data-confirm="এই ছাড় শেষ করবেন?"><input type="hidden" name="action" value="end-concession" /><input type="hidden" name="id" value={c.id} /><button class="button button--sm button--ghost">শেষ করুন</button></form>}
        </li>
      ))}</ul>
    )}
  </section>
</Admin>
<style>
  .section-block { margin-top: var(--space-5); }
  .table-wrap { overflow: auto; }
  .confirm { display: grid; gap: var(--space-3); justify-items: start; margin-top: var(--space-4); }
</style>
