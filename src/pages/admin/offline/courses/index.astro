---
import { env } from 'cloudflare:workers';
import Admin from '../../../../layouts/Admin.astro';
import { createOfflineCourse, listOfflineCourses, parseOfflineCourseForm } from '../../../../server/offline';
import { durationBn } from '../../../../lib/offline';
import { bnDigits, taka } from '../../../../lib/format';

if (Astro.request.method === 'POST') {
  const parsed = parseOfflineCourseForm(await Astro.request.formData());
  if (!parsed.ok) return Astro.redirect(`/admin/offline/courses?error=${parsed.error}`, 303);
  await createOfflineCourse(env.DB, Astro.locals.staff!, parsed.value);
  return Astro.redirect('/admin/offline/courses?saved=1', 303);
}
const courses = await listOfflineCourses(env.DB);
---

<Admin title="বিভাগ">
  <header class="page-head"><div><p class="eyebrow">একাডেমিক</p><h1>বিভাগ</h1></div></header>
  <p class="muted">এই কোর্সগুলো ওয়েবসাইটে দেখানো হয় না। শুধু অফলাইনে ভর্তি হওয়া ছাত্রদের হিসাবের জন্য।</p>

  {
    courses.length === 0 ? (
      <p class="panel muted">এখনো কোনো বিভাগ নেই। নিচের ফর্ম থেকে প্রথম কোর্সটি যোগ করুন।</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead><tr><th>কোর্স</th><th>কোর্স ফি</th><th>ভর্তি ফি</th><th>মেয়াদ</th><th>চলমান ছাত্র</th><th>অবস্থা</th></tr></thead>
          <tbody>
            {courses.map((c) => (
              <tr>
                <td><a href={`/admin/offline/courses/${c.id}`}>{c.title}</a></td>
                <td>{taka(c.feeMinor)}</td>
                <td>{c.admissionFeeMinor ? taka(c.admissionFeeMinor) : <span class="muted">নেই</span>}</td>
                <td>{durationBn(c.durationMonths)}</td>
                <td>{bnDigits(c.activeStudents ?? 0)}</td>
                <td><span class={`pill pill--${c.status === 'active' ? 'active' : 'archived'}`}>{c.status === 'active' ? 'চালু' : 'বন্ধ'}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>নতুন বিভাগ</h2>
  <form method="post" class="panel grid">
    <label class="field wide"><span>কোর্সের নাম</span><input name="title" required minlength="2" maxlength="200" /></label>
    <label class="field"><span>মোট কোর্স ফি (টাকা)</span><input name="fee" inputmode="numeric" required placeholder="যেমন ১২০০০" /></label>
    <label class="field"><span>ভর্তি ফি (টাকা, না থাকলে খালি রাখুন)</span><input name="admission" inputmode="numeric" /></label>
    <div class="field">
      <span>কোর্সের মেয়াদ</span>
      <div class="pair">
        <input name="duration" inputmode="numeric" required value="12" aria-label="মেয়াদ" />
        <select name="unit" aria-label="মাস না বছর"><option value="month">মাস</option><option value="year">বছর</option></select>
      </div>
    </div>
    <label class="field wide"><span>নোট (ক্লাসের সময়, শিক্ষক ইত্যাদি)</span><textarea name="note" maxlength="2000"></textarea></label>
    <button class="button">কোর্স যোগ করুন</button>
  </form>
</Admin>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    max-width: 820px;
  }
  .wide {
    grid-column: 1 / -1;
  }
  .grid .button {
    justify-self: start;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
</style>
