---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import { listBatches } from '../../../server/office';
import { assignmentsForBatch } from '../../../server/assessment';
const batches=await listBatches(env.DB);
const current=batches.filter(x=>x.status==='active');
const results=(await Promise.all(current.map(b=>assignmentsForBatch(env.DB,b.id,true)))).flat();
const totalPublished=results.filter(x=>x.status==='published').length;
---
<Admin title="হোমওয়ার্ক ও পাঠ পরিকল্পনা">
 <header class="page-head"><div><p class="eyebrow">একাডেমিক</p><h1>হোমওয়ার্ক ও পাঠ পরিকল্পনা</h1>
 <p>প্রতিটি ব্যাচের কাজ, প্রকাশ, শিক্ষার্থীর সাবমিশন ও শিক্ষক মূল্যায়ন পরিচালনা করুন।</p></div></header>
 <div class="kpis"><div class="kpi"><span class="kpi__label">ব্যাচ</span><strong class="kpi__value">{current.length}</strong></div>
 <div class="kpi"><span class="kpi__label">কাজের সংখ্যা</span><strong class="kpi__value">{results.length}</strong></div>
 <div class="kpi"><span class="kpi__label">প্রকাশিত</span><strong class="kpi__value">{totalPublished}</strong></div></div>
 <section class="card">
  <div class="card__head"><h2>ব্যাচ নির্বাচন করুন</h2></div>
  {current.length===0?<p class="muted">কোনো চালু ব্যাচ নেই।</p>:
   <ul class="list">{current.map(b=>{
    const items=results.filter(x=>x.batchId===b.id);
    return <li><div><strong>{b.name}</strong><small>{b.courseTitle} · কাজ {items.length}</small></div>
      <a class="button button--ghost button--sm" href={`/admin/offline/homework/${b.id}`}>কাজ পরিচালনা</a></li>;
   })}</ul>}
 </section>
</Admin>
