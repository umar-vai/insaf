---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import AttendanceSheet from '../../../components/AttendanceSheet.astro';
import { attendanceMonth, classesOn, getBatch, listBatches, roster, saveAttendance } from '../../../server/office';
import { addMonths, ATTENDANCE, ATTENDANCE_BN, DAY_BN, dayBn, isYmd, monthBn, studentCode, timeBn, todayDhaka, weekday } from '../../../lib/offline';
import { bnDigits } from '../../../lib/format';

const today = todayDhaka();
const p = Astro.url.searchParams;
const batchId = p.get('batch') ?? '';
const askedDay = p.get('day') ?? today;
const day = isYmd(askedDay) && askedDay <= today ? askedDay : today;
const view = p.get('view') === 'month' ? 'month' : 'day';
const askedMonth = p.get('m') ?? '';
const month = /^\d{4}-(0[1-9]|1[0-2])$/.test(askedMonth) ? askedMonth : today.slice(0, 7);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const marks: Record<string, string> = {};
  for (const [k, v] of form) if (k.startsWith('s_')) marks[k.slice(2)] = String(v);
  const n = await saveAttendance(env.DB, Astro.locals.staff!, batchId, String(form.get('day') ?? ''), marks, today);
  return Astro.redirect(`/admin/offline/attendance?batch=${encodeURIComponent(batchId)}&day=${form.get('day')}&${n ? 'saved=1' : 'error=attendance'}`, 303);
}

const [batches, todays, batch] = await Promise.all([listBatches(env.DB, { activeOnly: true }), classesOn(env.DB, today), batchId ? getBatch(env.DB, batchId) : null]);
const rows = batch && view === 'day' ? await roster(env.DB, batch.id, day) : [];
const month_ = batch && view === 'month' ? await attendanceMonth(env.DB, batch.id, month) : null;
const marked = rows.filter((r) => r.status).length;
const here = (extra: Record<string, string>) => `?${new URLSearchParams({ batch: batchId, ...extra })}`;
---

<Admin title="হাজিরা">
  <header class="page-head">
    <div>
      <p class="eyebrow">একাডেমিক</p>
      <h1>হাজিরা</h1>
      <p>ব্যাচ আর তারিখ বাছুন, প্রত্যেকের পাশে উপস্থিত বা অনুপস্থিত চাপুন, তারপর সংরক্ষণ করুন। একই দিন আবার সংরক্ষণ করলে আগেরটা বদলে যায়।</p>
    </div>
  </header>

  <form class="card pick" method="get">
    <label class="field">
      <span>ব্যাচ</span>
      <select name="batch" required onchange="this.form.submit()">
        <option value="">ব্যাচ বাছুন</option>
        {batches.map((b) => <option value={b.id} selected={b.id === batchId}>{b.name} · {b.courseTitle}</option>)}
      </select>
    </label>
    <label class="field"><span>তারিখ</span><input type="date" name="day" value={day} max={today} onchange="this.form.batch.value && this.form.submit()" /></label>
    <button class="button">খুলুন</button>
  </form>

  {
    !batch && (
      <section class="card">
        <div class="card__head"><h2>আজকের ক্লাস ({DAY_BN[weekday(today)]})</h2></div>
        {todays.length === 0 ? (
          <p class="muted">আজ রুটিনে কোনো ক্লাস নেই। উপরের তালিকা থেকে যেকোনো ব্যাচ বাছতে পারেন।</p>
        ) : (
          <ul class="list">
            {todays.map((b) => (
              <li>
                <div><strong>{b.name}</strong> <span class="muted">· {b.courseTitle}</span><small>{[timeBn(b.startTime), b.teacherName].filter(Boolean).join(' · ')} · {bnDigits(b.students)} জন</small></div>
                {b.marked > 0 ? <a class="pill pill--present" href={`?batch=${b.id}&day=${today}`}>নেওয়া হয়েছে, দেখুন</a> : <a class="button button--sm" href={`?batch=${b.id}&day=${today}`}>হাজিরা নিন</a>}
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  {
    batch && (
      <>
        <nav class="tabs" aria-label="দেখার ধরন">
          <a href={here({ day })} aria-current={view === 'day' ? 'page' : undefined}>এক দিনের হাজিরা</a>
          <a href={here({ view: 'month', m: month })} aria-current={view === 'month' ? 'page' : undefined}>মাসের হিসাব</a>
        </nav>

        {view === 'day' ? (
          rows.length === 0 ? (
            <div class="card empty"><Icon name="users" size={28} /><p>এই ব্যাচে কোনো চলমান ছাত্র নেই।</p><a href={`/admin/offline/batches/${batch.id}`}>ব্যাচ দেখুন</a></div>
          ) : (
            <AttendanceSheet rows={rows} day={day} batchName={batch.name} marked={marked} />
          )
        ) : (
          <section class="card">
            <div class="card__head">
              <h2>{batch.name} · {monthBn(month, true)}</h2>
              <span class="actions">
                <a class="button button--sm button--ghost" href={here({ view: 'month', m: addMonths(`${month}-01`, -1).slice(0, 7) })}>‹ আগের মাস</a>
                {month < today.slice(0, 7) && <a class="button button--sm button--ghost" href={here({ view: 'month', m: addMonths(`${month}-01`, 1).slice(0, 7) })}>পরের মাস ›</a>}
              </span>
            </div>
            <p class="muted">এই মাসে {bnDigits(month_!.days.length)} দিন হাজিরা নেওয়া হয়েছে।</p>
            <div class="table-wrap">
              <table>
                <thead><tr><th>রোল</th><th>ছাত্র</th><th class="num">উপস্থিত</th><th class="num">দেরিতে</th><th class="num">অনুপস্থিত</th><th class="num">ছুটি</th><th class="num">উপস্থিতির হার</th></tr></thead>
                <tbody>
                  {month_!.rows.map((r) => {
                    const rate = r.days ? Math.round(((r.present + r.late) / r.days) * 100) : null;
                    return (
                      <tr class={rate !== null && rate < 60 ? 'late' : ''}>
                        <td>{bnDigits(r.roll)}</td>
                        <td><a href={`/admin/offline/students/${r.studentId}`}>{r.name}</a></td>
                        <td class="num">{bnDigits(r.present)}</td>
                        <td class="num">{bnDigits(r.late)}</td>
                        <td class="num">{bnDigits(r.absent)}</td>
                        <td class="num">{bnDigits(r.leave)}</td>
                        <td class="num"><strong class={rate !== null && rate < 60 ? 'bad' : ''}>{rate === null ? '' : `${bnDigits(rate)}%`}</strong></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </>
    )
  }
</Admin>



<style>
  .pick {
    display: grid;
    grid-template-columns: minmax(200px, 2fr) minmax(150px, 1fr) auto;
    gap: var(--space-3);
    align-items: end;
    margin-bottom: var(--space-5);
  }
  @media (max-width: 640px) {
    .pick {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
