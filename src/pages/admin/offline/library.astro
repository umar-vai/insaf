---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { localsMayDo } from '../../../server/staff';
import { listTeachers } from '../../../server/office';
import { getSettings } from '../../../server/settings';
import { issueBook, lateFine, libraryCounts, listBooks, listLoans, parseBookForm, parseIssueForm, removeBook, returnBook, saveBook } from '../../../server/library';
import { addDays, dayBn, studentCode, todayDhaka } from '../../../lib/offline';
import { bnDigits, taka } from '../../../lib/format';

const actor = Astro.locals.staff!;
const full = localsMayDo(Astro.locals, 'academic', 'full');
const today = todayDhaka();
const here = '/admin/offline/library';
const s = await getSettings(env.DB);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const back = (r: { ok: boolean; error?: string }, hash = '') => Astro.redirect(`${here}?${r.ok ? 'saved=1' : `error=${r.error ?? 'action'}`}${hash}`, 303);
  if (action === 'book') {
    const v = parseBookForm(form);
    if (!v.ok) return back(v, '#books');
    const r = await saveBook(env.DB, actor, String(form.get('id') ?? '') || null, v.value);
    return back(r.ok ? { ok: true } : r, '#books');
  }
  if (action === 'remove') return back({ ok: await removeBook(env.DB, actor, String(form.get('id') ?? '')), error: 'on_loan' }, '#books');
  if (action === 'issue') {
    const v = parseIssueForm(form, today, s.libraryLoanDays);
    if (!v.ok) return back(v, '#issue');
    const r = await issueBook(env.DB, actor, v.value, today);
    return back(r.ok ? { ok: true } : r, '#issue');
  }
  if (action === 'return') {
    const waive = form.get('waive') === 'yes';
    if (waive && !full) return back({ ok: false, error: 'full' }, '#loans');
    const r = await returnBook(env.DB, actor, String(form.get('loanId') ?? ''), today, s.libraryFinePerDayTaka, waive);
    return back(r.ok ? { ok: true } : r, '#loans');
  }
  return back({ ok: false });
}

const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 80);
const editId = Astro.url.searchParams.get('edit') ?? '';
const [counts, books, loans, teachers, students] = await Promise.all([
  libraryCounts(env.DB, today),
  listBooks(env.DB, q),
  listLoans(env.DB, { open: true }),
  listTeachers(env.DB, true),
  env.DB.prepare("SELECT id, name, student_no AS no FROM offline_students WHERE status = 'active' ORDER BY student_no, name LIMIT 3000").all<{ id: string; name: string; no: number | null }>(),
]);
const editing = editId ? books.find((b) => b.id === editId) : undefined;
const ERR: Record<string, string> = {
  title: 'বইয়ের নাম লিখুন।', accession: 'অ্যাকসেশন নম্বর সঠিক নয়।', accession_taken: 'এই অ্যাকসেশন নম্বর অন্য বইয়ে আছে।', copies: 'কপির সংখ্যা সঠিক নয়।',
  copies_on_loan: 'ধার দেওয়া কপির চেয়ে কম কপি রাখা যাবে না।', on_loan: 'বইটির কপি ধারে আছে, আগে ফেরত নিন।', book: 'বই বাছুন।', borrower: 'চালু ছাত্র বা শিক্ষক বাছুন।',
  due: 'ফেরতের তারিখ সঠিক নয়।', none_left: 'এই বইয়ের কোনো কপি এখন তাকে নেই।', already: 'এই ব্যক্তি বইটি আগেই নিয়েছেন অথবা কপি শেষ।', missing: 'ধারটি পাওয়া যায়নি বা আগেই ফেরত হয়েছে।',
  full: 'জরিমানা মাফ করতে একাডেমিকে সম্পূর্ণ অনুমতি লাগবে।', action: 'কাজটি করা যায়নি।',
};
const err = Astro.url.searchParams.get('error');
---

<Admin title="লাইব্রেরি">
  <header class="page-head">
    <div>
      <p class="eyebrow">একাডেমিক</p>
      <h1>লাইব্রেরি</h1>
      <p>বইয়ের তালিকা, ছাত্র ও শিক্ষককে বই দেওয়া এবং ফেরত নেওয়া। ছাত্র দেরিতে ফেরত দিলে জরিমানা তার ফির হিসাবে চার্জ হিসেবে যোগ হয় (অফিসের নিয়মে দৈনিক জরিমানা ঠিক করা থাকলে)।</p>
    </div>
    <div class="actions"><a class="button button--ghost" href="/admin/offline/settings#library"><Icon name="layers" /> লাইব্রেরির নিয়ম</a></div>
  </header>
  {err && <p class="note note--bad" role="alert">{ERR[err] ?? 'কাজটি করা যায়নি।'}</p>}

  <div class="stats">
    <div class="card"><small class="muted">বই (শিরোনাম)</small><strong>{bnDigits(counts.titles)}</strong></div>
    <div class="card"><small class="muted">মোট কপি</small><strong>{bnDigits(counts.copies)}</strong></div>
    <div class="card"><small class="muted">ধারে আছে</small><strong>{bnDigits(counts.onLoan)}</strong></div>
    <div class="card"><small class="muted">সময় পার</small><strong>{bnDigits(counts.overdue)}</strong></div>
  </div>

  <div class="cols">
    <section class="card" id="issue">
      <div class="card__head"><h2>বই দিন</h2></div>
      <form method="post" class="form-grid">
        <input type="hidden" name="action" value="issue" />
        <label class="field wide"><span>বই</span>
          <select name="bookId" required><option value="">বাছুন</option>
            {books.filter((b) => b.available > 0).map((b) => <option value={b.id}>{b.title} (#{bnDigits(b.accessionNo)}, তাকে {bnDigits(b.available)})</option>)}
          </select>
        </label>
        <label class="field"><span>কে নেবেন</span>
          <select name="borrowerKind"><option value="student">ছাত্র</option><option value="teacher">শিক্ষক বা কর্মী</option></select>
        </label>
        <label class="field"><span>ছাত্র</span>
          <select name="studentId"><option value="">বাছুন</option>{students.results.map((x) => <option value={x.id}>{x.name} {studentCode(x.no)}</option>)}</select>
        </label>
        <label class="field"><span>শিক্ষক বা কর্মী</span>
          <select name="teacherId"><option value="">বাছুন</option>{teachers.map((t) => <option value={t.id}>{t.name}</option>)}</select>
        </label>
        <label class="field"><span>ফেরতের শেষ তারিখ</span><input type="date" name="dueOn" min={today} value={addDays(today, s.libraryLoanDays)} /></label>
        <label class="field wide"><span>নোট (ঐচ্ছিক)</span><input name="note" maxlength="300" /></label>
        <button class="button"><Icon name="book" /> বই দিন</button>
      </form>
    </section>

    <section class="card" id="book-form">
      <div class="card__head"><h2>{editing ? 'বইয়ের তথ্য বদলান' : 'নতুন বই যোগ করুন'}</h2></div>
      <form method="post" class="form-grid">
        <input type="hidden" name="action" value="book" />
        {editing && <input type="hidden" name="id" value={editing.id} />}
        <label class="field wide"><span>নাম</span><input name="title" required maxlength="200" value={editing?.title ?? ''} /></label>
        <label class="field"><span>লেখক</span><input name="author" maxlength="160" value={editing?.author ?? ''} /></label>
        <label class="field"><span>বিষয় বা ধরন</span><input name="category" maxlength="80" value={editing?.category ?? ''} /></label>
        <label class="field"><span>তাক</span><input name="shelf" maxlength="40" value={editing?.shelf ?? ''} /></label>
        <label class="field"><span>কপি</span><input name="copies" inputmode="numeric" required value={String(editing?.copies ?? 1)} /></label>
        <label class="field"><span>অ্যাকসেশন নম্বর (খালি রাখলে নিজে বসবে)</span><input name="accessionNo" inputmode="numeric" value={editing ? String(editing.accessionNo) : ''} /></label>
        <label class="field"><span>ISBN (ঐচ্ছিক)</span><input name="isbn" maxlength="20" value={editing?.isbn ?? ''} /></label>
        <button class="button"><Icon name="check" /> সংরক্ষণ</button>
        {editing && <a class="button button--ghost" href={here}>বাতিল</a>}
      </form>
    </section>
  </div>

  <section class="card section-block" id="loans">
    <div class="card__head"><h2>যাদের কাছে বই আছে</h2><span class="pill pill--info">{bnDigits(loans.length)}</span></div>
    {loans.length === 0 ? <p class="muted">এখন কারো কাছে বই নেই।</p> : (
      <div class="table-wrap"><table>
        <thead><tr><th>বই</th><th>কার কাছে</th><th>দেওয়া</th><th>ফেরতের শেষ দিন</th><th>ফেরত নিন</th></tr></thead>
        <tbody>{loans.map((l) => {
          const fine = l.borrowerKind === 'student' ? lateFine(l.dueOn, today, s.libraryFinePerDayTaka) : 0;
          return (
            <tr>
              <td>{l.bookTitle} <small class="muted">#{bnDigits(l.accessionNo)}</small></td>
              <td>{l.borrowerName} <small class="muted">{l.borrowerKind === 'student' ? studentCode(l.borrowerCode) : 'শিক্ষক'}</small></td>
              <td>{dayBn(l.issuedOn)}</td>
              <td>{dayBn(l.dueOn)} {l.dueOn < today && <span class="pill pill--late">সময় পার</span>}</td>
              <td>
                <form method="post" class="inline" data-confirm={fine ? `ফেরত নিলে ${taka(fine)} জরিমানা যোগ হবে।` : 'বইটি ফেরত নেবেন?'}>
                  <input type="hidden" name="action" value="return" /><input type="hidden" name="loanId" value={l.id} />
                  {fine > 0 && full && <label class="check"><input type="checkbox" name="waive" value="yes" /> জরিমানা মাফ</label>}
                  <button class="button button--sm">ফেরত{fine > 0 && ` (${taka(fine)})`}</button>
                </form>
              </td>
            </tr>
          );
        })}</tbody>
      </table></div>
    )}
  </section>

  <section class="card section-block" id="books">
    <div class="card__head"><h2>বইয়ের তালিকা</h2></div>
    <form method="get" class="search"><input type="search" name="q" value={q} placeholder="নাম, লেখক, বিষয় বা অ্যাকসেশন নম্বর" /><button class="button button--ghost"><Icon name="search" /> খুঁজুন</button></form>
    {books.length === 0 ? <p class="muted">{q ? 'কিছু পাওয়া যায়নি।' : 'এখনো কোনো বই যোগ হয়নি।'}</p> : (
      <div class="table-wrap"><table>
        <thead><tr><th>#</th><th>নাম</th><th>লেখক</th><th>বিষয়</th><th>তাক</th><th>কপি</th><th>তাকে</th><th></th></tr></thead>
        <tbody>{books.map((b) => (
          <tr>
            <td>{bnDigits(b.accessionNo)}</td><td>{b.title}</td><td>{b.author}</td><td>{b.category}</td><td>{b.shelf}</td>
            <td>{bnDigits(b.copies)}</td><td>{bnDigits(b.available)}</td>
            <td class="row-actions">
              <a class="button button--sm button--ghost" href={`?edit=${encodeURIComponent(b.id)}#book-form`}>বদলান</a>
              {b.onLoan === 0 && <form method="post" class="inline" data-confirm="বইটি তালিকা থেকে সরাবেন?"><input type="hidden" name="action" value="remove" /><input type="hidden" name="id" value={b.id} /><button class="button button--sm button--ghost">সরান</button></form>}
            </td>
          </tr>
        ))}</tbody>
      </table></div>
    )}
  </section>
</Admin>
<style>
  .section-block { margin-top: var(--space-5); }
  .table-wrap { overflow: auto; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-5); }
  .stats .card { display: grid; gap: var(--space-1); }
  .stats strong { font-size: 1.6rem; }
  .inline { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; }
  .row-actions { display: flex; gap: var(--space-2); }
  .search { display: flex; gap: var(--space-2); margin-bottom: var(--space-4); }
  .search input { flex: 1; min-width: 0; }
</style>
