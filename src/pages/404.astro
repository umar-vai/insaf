---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { whatsappUrl } from '../lib/site';

Astro.response.status = 404;
---

<Base title="পেজটি পাওয়া যায়নি">
  <meta slot="head" name="robots" content="noindex" />
  <section class="nf">
    <div class="nf__card">
      <p class="nf__kufi arabic" lang="ar">تمرين</p>
      <h1>পেজটি পাওয়া যায়নি</h1>
      <p class="muted">যে পেজটি খুঁজছেন সেটি সরানো হয়েছে অথবা ঠিকানায় ভুল আছে।</p>
      <div class="nf__actions">
        <a class="button" href="/">হোমপেজে যান <Icon name="arrow" /></a>
        <a class="button button--ghost" href="/account/courses">আমার কোর্স</a>
      </div>
      <p class="nf__help">
        সমস্যা থাকলে <a href={whatsappUrl(`আসসালামু আলাইকুম, মাদরাসাতুল ইনসাফের সাইটে একটি পেজ খুলছে না: ${Astro.url.pathname}`)} rel="noopener">WhatsApp এ জানান</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: calc(100vh - var(--header-h));
    display: grid;
    place-items: center;
    padding: var(--space-12) var(--gutter);
    background: var(--mint-50) var(--pattern-light);
  }
  .nf__card {
    width: min(100%, 480px);
    padding: clamp(1.5rem, 1rem + 3vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }
  .nf__kufi {
    margin: 0;
    font-family: var(--font-kufi);
    font-size: 2.4rem;
    line-height: 1.3;
    color: var(--color-accent);
  }
  .nf h1 {
    font-size: var(--text-2xl);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .nf__help {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }
</style>
