---
import { env } from 'cloudflare:workers';
import AccountShell from '../../../components/AccountShell.astro';
import NotTeacher from '../../../components/NotTeacher.astro';
import AttendanceSheet from '../../../components/AttendanceSheet.astro';
import MaterialList from '../../../components/MaterialList.astro';
import Icon from '../../../components/Icon.astro';
import { createNotice, listNotices, roster, saveAttendance } from '../../../server/office';
import { addMaterial, batchForTeacher, hideMaterial, listMaterials, teacherSession } from '../../../server/panels';
import { getSettings } from '../../../server/settings';
import { sameOrigin } from '../../../server/session';
import { assignmentStatusBn, assignmentsForBatch, createAssignment, homeworkKindBn, listBatchAssessments } from '../../../server/assessment';
import { DAY_BN, dayBn, isYmd, parseDays, studentCode, timeBn, todayDhaka } from '../../../lib/offline';
import { bnDigits, dateBn } from '../../../lib/format';

Astro.response.headers.set('Cache-Control', 'no-store');
const id = Astro.params.id!;
const here = `/teacher/batch/${id}`;
const { me, teacher } = await teacherSession(env.DB, env, Astro.request.headers.get('Cookie'));
if (!me) return Astro.redirect(`/account?return=${encodeURIComponent(here)}`, 303);
const batch = teacher ? await batchForTeacher(env.DB, teacher.id, id) : null;
if (teacher && !batch) return new Response('এই ব্যাচটি আপনার নয়।', { status: 403 });
const s = await getSettings(env.DB);
const today = todayDhaka();

if (Astro.request.method === 'POST' && teacher && batch) {
  const form = await Astro.request.formData();
  const action = form.get('action');
  const back = (q: string, hash = '') => Astro.redirect(`${here}?${q}${hash}`, 303);
  if (!action && s.teacherTakesAttendance) {
    // The attendance sheet posts without an action.
    const marks: Record<string, string> = {};
    for (const [k, v] of form) if (k.startsWith('s_')) marks[k.slice(2)] = String(v);
    const day = String(form.get('day') ?? '');
    const n = await saveAttendance(env.DB, me.email, id, day, marks, today);
    return back(`day=${day}&${n ? 'saved=1' : 'error=1'}`);
  }
  if (action === 'material' && s.teacherCanShareMaterial) {
    const r = await addMaterial(env.DB, env.MEDIA, me.email, id, form);
    return back(r.ok ? 'saved=1' : `error=${r.error}`, '#materials');
  }
  if (action === 'hide-material' && s.teacherCanShareMaterial) {
    await hideMaterial(env.DB, me.email, String(form.get('materialId') ?? ''), [id]);
    return back('saved=1', '#materials');
  }
  if (action === 'homework') {
    if (!sameOrigin(Astro.request)) return new Response('Bad origin', { status: 403 });
    const r = await createAssignment(env.DB, me.email, id, {
      title: String(form.get('title') ?? ''),
      details: String(form.get('details') ?? ''),
      dueOn: String(form.get('dueOn') ?? ''),
      kind: form.get('kind') === 'lesson' ? 'lesson' : 'homework',
    });
    if (r.ok) return Astro.redirect(`/teacher/homework/${r.value}?saved=1`, 303);
    return back(`error=${r.error}`, '#homework');
  }
  if (action === 'notice' && s.teacherCanPostNotice) {
    const title = String(form.get('title') ?? '').trim().slice(0, 160);
    if (title.length < 2) return back('error=title', '#notices');
    await createNotice(env.DB, me.email, { title, body: String(form.get('body') ?? '').trim().slice(0, 5000), audience: 'batch', targetId: id, pinned: false }, { bucket: env.MEDIA, file: form.get('file') });
    return back('saved=1', '#notices');
  }
  return back('error=1');
}

const askedDay = Astro.url.searchParams.get('day') ?? today;
const day = isYmd(askedDay) && askedDay <= today ? askedDay : today;
const [rows, materials, notices, assignments, allExams] = batch
  ? await Promise.all([
      roster(env.DB, id, day),
      listMaterials(env.DB, [id]),
      listNotices(env.DB, ['batch'], 200),
      assignmentsForBatch(env.DB, id, true),
      listBatchAssessments(env.DB, id),
    ])
  : [[], [], [], [], []];
const exams = allExams.filter((x) => x.examStatus === 'scheduled');
const batchNotices = notices.filter((n) => n.targetId === id && n.status === 'published');
const saved = Astro.url.searchParams.has('saved');
const failed = Astro.url.searchParams.has('error');
---

{
  !teacher || !batch ? (
    <NotTeacher me={me} />
  ) : (
    <AccountShell me={me} active="t-home" title={batch.name} mode="teacher">
      <div class="ui">
        <header class="page-head">
          <div>
            <p class="eyebrow"><a href="/teacher">শিক্ষক ড্যাশবোর্ড</a></p>
            <h1>{batch.name}</h1>
            <p>{batch.courseTitle} · {parseDays(batch.days).map((d) => DAY_BN[d]).join(', ')} · {timeBn(batch.startTime)}{batch.room && ` · ${batch.room}`}</p>
          </div>
        </header>
        {saved && <p class="note note--good" role="status">সংরক্ষণ হয়েছে।</p>}
        {failed && <p class="note note--bad" role="alert">কাজটি করা যায়নি। তথ্য দেখে আবার চেষ্টা করুন।</p>}

        {s.teacherTakesAttendance && (
          <section id="attendance">
            <form class="card pick" method="get">
              <label class="field"><span>হাজিরার তারিখ</span><input type="date" name="day" value={day} max={today} onchange="this.form.submit()" /></label>
              <button class="button button--ghost">অন্য দিনের হাজিরা</button>
            </form>
            {rows.length === 0 ? (
              <p class="card muted">এই ব্যাচে কোনো চলমান ছাত্র নেই।</p>
            ) : (
              <AttendanceSheet rows={rows} day={day} batchName={batch.name} marked={rows.filter((r) => r.status).length} />
            )}
          </section>
        )}

        <section class="card block">
          <div class="card__head"><h2>ছাত্র তালিকা ({bnDigits(rows.length)} জন)</h2></div>
          <ul class="list">
            {rows.map((r) => (
              <li>
                <span>{r.roll && <span class="muted">রোল {bnDigits(r.roll)} · </span>}{r.name} <span class="id">{studentCode(r.studentNo)}</span></span>
                {s.teacherSeesPhones && <a href={`tel:${r.phone}`}>{bnDigits(r.phone)}</a>}
              </li>
            ))}
          </ul>
        </section>

        <section class="card block" id="assessment">
          <div class="card__head"><h2>পরীক্ষার নম্বর</h2></div>
          {exams.length === 0 ? (
            <p class="muted">এই ব্যাচে কোনো পরীক্ষা নেই।</p>
          ) : (
            <ul class="list">
              {exams.map((x) => (
                <li>
                  <div>
                    <strong>{x.title}</strong>
                    <small>{dayBn(x.examDate)}{x.subject && ` · ${x.subject}`}</small>
                  </div>
                  <span class={`pill pill--${x.status === 'published' ? 'published' : x.status === 'draft' ? 'draft' : 'pending'}`}>
                    {x.status === 'published' ? 'ফল প্রকাশিত' : x.status === 'draft' ? `নম্বর ${bnDigits(x.completed)} / ${bnDigits(x.examinees)}` : 'অফিস গ্রেডবুক খুলবে'}
                  </span>
                  {x.status && <a class="button button--ghost button--sm" href={`/teacher/exam/${x.examId}`}>{x.status === 'draft' ? 'নম্বর দিন' : 'দেখুন'}</a>}
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="card block" id="homework">
          <div class="card__head"><h2>হোমওয়ার্ক ও পাঠ পরিকল্পনা</h2></div>
          {assignments.length === 0 ? (
            <p class="muted">এখনো কোনো কাজ দেওয়া হয়নি।</p>
          ) : (
            <ul class="list">
              {assignments.map((a) => (
                <li>
                  <div>
                    <strong>{a.title}</strong>
                    <small>{homeworkKindBn(a.kind)} · {dayBn(a.dueOn)}{a.kind === 'homework' && ` · জমা ${bnDigits(a.submissions)}, মূল্যায়িত ${bnDigits(a.reviewed)}`}</small>
                  </div>
                  <span class={`pill pill--${a.status === 'closed' ? 'archived' : a.status}`}>{assignmentStatusBn(a.status)}</span>
                  <a class="button button--ghost button--sm" href={`/teacher/homework/${a.id}`}>খুলুন</a>
                </li>
              ))}
            </ul>
          )}
          <details>
            <summary>নতুন হোমওয়ার্ক বা পাঠ</summary>
            <form method="post" class="form-grid add">
              <input name="action" type="hidden" value="homework" />
              <label class="field"><span>ধরন</span><select name="kind"><option value="homework">হোমওয়ার্ক</option><option value="lesson">পাঠ পরিকল্পনা</option></select></label>
              <label class="field"><span>জমার শেষ দিন / পাঠের দিন</span><input name="dueOn" type="date" required value={today} /></label>
              <label class="field wide"><span>শিরোনাম</span><input name="title" required minlength="2" maxlength="160" /></label>
              <label class="field wide"><span>নির্দেশনা</span><textarea name="details" rows="4" maxlength="4000"></textarea></label>
              <button class="button">খসড়া তৈরি করুন</button>
            </form>
            <p class="muted">খসড়া তৈরি হলে খুলে "প্রকাশ করুন" চাপলে তবেই ছাত্র ও অভিভাবক দেখতে পাবেন।</p>
          </details>
        </section>

        <section class="card block" id="materials">
          <div class="card__head"><h2>পড়ার উপকরণ</h2></div>
          <MaterialList materials={materials} canHide={s.teacherCanShareMaterial} />
          {s.teacherCanShareMaterial && (
            <details>
              <summary>নতুন উপকরণ দিন</summary>
              <form method="post" enctype="multipart/form-data" class="form-grid add">
                <input type="hidden" name="action" value="material" />
                <label class="field wide"><span>শিরোনাম</span><input name="title" required minlength="2" maxlength="160" /></label>
                <label class="field"><span>ফাইল (PDF, Word, অডিও, ছবি; ২৫ MB পর্যন্ত)</span><input type="file" name="file" /></label>
                <label class="field"><span>অথবা লিংক (Google Drive, YouTube)</span><input name="url" type="url" placeholder="https://" /></label>
                <button class="button">দিন</button>
              </form>
            </details>
          )}
        </section>

        <section class="card block" id="notices">
          <div class="card__head"><h2>এই ব্যাচের নোটিশ</h2></div>
          {batchNotices.length === 0 ? <p class="muted">কোনো নোটিশ নেই।</p> : (
            <ul class="list">
              {batchNotices.map((n) => <li><div><strong>{n.title}</strong><small>{dateBn(n.createdAt)}</small>{n.body && <p class="body">{n.body}</p>}{n.fileName && <a href={`/api/notice-file/${n.id}`} target="_blank">{n.fileName}</a>}</div></li>)}
            </ul>
          )}
          {s.teacherCanPostNotice && (
            <details>
              <summary>ব্যাচে নোটিশ দিন</summary>
              <form method="post" class="form-grid add" enctype="multipart/form-data">
                <input type="hidden" name="action" value="notice" />
                <label class="field wide"><span>শিরোনাম</span><input name="title" required minlength="2" maxlength="160" /></label>
                <label class="field wide"><span>বিস্তারিত</span><textarea name="body" rows="4" maxlength="5000"></textarea></label>
                <label class="field wide"><span>ফাইল (ঐচ্ছিক)</span><input name="file" type="file" accept=".pdf,.doc,.docx,image/*" /></label>
                <button class="button"><Icon name="bell" /> প্রকাশ করুন</button>
              </form>
            </details>
          )}
        </section>
      </div>
    </AccountShell>
  )
}

<style>
  .pick {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .pick .field {
    flex: 1 1 200px;
  }
  .block {
    margin-top: var(--space-5);
  }
  .add {
    margin-top: var(--space-3);
  }
  .body {
    margin: var(--space-1) 0 0;
    white-space: pre-line;
  }
</style>
