---
import { env } from 'cloudflare:workers';
import AccountShell from '../../../components/AccountShell.astro';
import NotTeacher from '../../../components/NotTeacher.astro';
import { teacherSession, batchForTeacher } from '../../../server/panels';
import { sameOrigin } from '../../../server/session';
import { assignmentStatusBn, assignmentSubmissions, closeAssignment, getAssignment, homeworkKindBn, publishAssignment, reviewHomework } from '../../../server/assessment';
import { bnDigits } from '../../../lib/format';
import { dayBn, studentCode } from '../../../lib/offline';

// A teacher's homework or lesson plan: publish, close, and review answers.
// Only for a batch the teacher teaches now.
Astro.response.headers.set('Cache-Control', 'no-store');
const id = Astro.params.id!;
const here = `/teacher/homework/${encodeURIComponent(id)}`;
const { me, teacher } = await teacherSession(env.DB, env, Astro.request.headers.get('Cookie'));
if (!me) return Astro.redirect(`/account?return=${encodeURIComponent(here)}`, 303);
const item = teacher ? await getAssignment(env.DB, id) : null;
if (teacher && !item) return new Response('কাজটি পাওয়া যায়নি।', { status: 404 });
const batch = teacher && item ? await batchForTeacher(env.DB, teacher.id, item.batchId) : null;
if (teacher && item && !batch) return new Response('এই কাজটি আপনার ব্যাচের নয়।', { status: 403 });

if (Astro.request.method === 'POST' && teacher && item && batch) {
  if (!sameOrigin(Astro.request)) return new Response('Bad origin', { status: 403 });
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const r =
    action === 'publish'
      ? await publishAssignment(env.DB, me.email, id, batch.id)
      : action === 'close'
        ? await closeAssignment(env.DB, me.email, id, batch.id)
        : action === 'review'
          ? await reviewHomework(env.DB, me.email, id, String(form.get('enrollmentId') ?? ''), form.get('feedback'), form.get('score'))
          : { ok: false as const, error: 'action' };
  return Astro.redirect(`${here}?${r.ok ? 'saved=1' : `error=${encodeURIComponent(r.error)}`}`, 303);
}
const submissions = item && batch ? await assignmentSubmissions(env.DB, id, batch.id) : [];
---

{
  !teacher || !item || !batch ? (
    <NotTeacher me={me} />
  ) : (
    <AccountShell me={me} mode="teacher" active="t-home" title={item.title}>
      <div class="ui">
        <header class="page-head">
          <div>
            <p class="eyebrow"><a href={`/teacher/batch/${batch.id}#homework`}>{batch.name}</a></p>
            <h1>{item.title}</h1>
            <p>{homeworkKindBn(item.kind)} · {item.kind === 'homework' ? 'জমার শেষ দিন' : 'পাঠের দিন'} {dayBn(item.dueOn)} · <span class={`pill pill--${item.status === 'closed' ? 'archived' : item.status}`}>{assignmentStatusBn(item.status)}</span></p>
          </div>
        </header>
        {Astro.url.searchParams.has('saved') && <p class="note note--good" role="status">সংরক্ষণ হয়েছে।</p>}
        {Astro.url.searchParams.has('error') && <p class="note note--bad" role="alert">কাজটি করা যায়নি। আবার দেখে চেষ্টা করুন।</p>}

        <section class="card block">
          <div class="card__head">
            <h2>নির্দেশনা</h2>
            {item.status === 'draft' && (
              <form method="post" data-confirm="ছাত্রদের জন্য প্রকাশ করবেন? প্রকাশের পর ছাত্র ও অভিভাবক দেখতে পাবেন।">
                <input type="hidden" name="action" value="publish" />
                <button class="button button--sm">প্রকাশ করুন</button>
              </form>
            )}
            {item.status === 'published' && item.kind === 'homework' && (
              <form method="post" data-confirm="বন্ধ করলে আর নতুন উত্তর জমা হবে না। বন্ধ করবেন?">
                <input type="hidden" name="action" value="close" />
                <button class="button button--ghost button--sm">জমা বন্ধ করুন</button>
              </form>
            )}
          </div>
          <p class="body">{item.details || 'বিস্তারিত লেখা নেই।'}</p>
        </section>

        {item.kind === 'homework' && (
          <section class="card block">
            <div class="card__head"><h2>জমা দেওয়া উত্তর</h2><small class="muted">{bnDigits(item.submissions)} জন · মূল্যায়িত {bnDigits(item.reviewed)} জন</small></div>
            {submissions.length === 0 ? (
              <p class="muted">এখনো কেউ উত্তর জমা দেয়নি।</p>
            ) : (
              <div class="answers">
                {submissions.map((s) => (
                  <article class="answer">
                    <h3>{s.studentName} <span class="id">{studentCode(s.studentNo)}</span></h3>
                    <p class="body">{s.body}</p>
                    {s.state === 'reviewed' ? (
                      <p class="note note--good">মূল্যায়ন: {s.score === null ? 'নম্বর ছাড়া' : `${bnDigits(s.score)} / ১০০`}{s.feedback && ` · ${s.feedback}`}</p>
                    ) : (
                      <form method="post" class="form-grid" data-confirm="মূল্যায়ন সংরক্ষণের পর আর বদলানো যাবে না। সংরক্ষণ করবেন?">
                        <input type="hidden" name="action" value="review" />
                        <input type="hidden" name="enrollmentId" value={s.enrollmentId} />
                        <label class="field"><span>নম্বর (ঐচ্ছিক, ১০০ এর মধ্যে)</span><input name="score" type="number" min="0" max="100" /></label>
                        <label class="field wide"><span>আপনার মতামত</span><textarea name="feedback" rows="3" maxlength="1200"></textarea></label>
                        <button class="button button--sm">মূল্যায়ন সংরক্ষণ</button>
                      </form>
                    )}
                  </article>
                ))}
              </div>
            )}
          </section>
        )}
      </div>
    </AccountShell>
  )
}

<style>
  .block {
    margin-top: var(--space-5);
  }
  .body {
    white-space: pre-wrap;
  }
  .answers {
    display: grid;
    gap: var(--space-4);
  }
  .answer {
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }
</style>
