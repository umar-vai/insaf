---
import { env } from 'cloudflare:workers';
import AccountShell from '../../../components/AccountShell.astro';
import NotTeacher from '../../../components/NotTeacher.astro';
import MarkSheet from '../../../components/MarkSheet.astro';
import { teacherSession, batchForTeacher } from '../../../server/panels';
import { sameOrigin } from '../../../server/session';
import { examAssessment, examMarks, markInputsFromForm, saveExamMarks, submitAssessment, teacherCanGrade } from '../../../server/assessment';
import { bnDigits } from '../../../lib/format';
import { dayBn } from '../../../lib/offline';

// A teacher enters marks only for exams of a batch they teach now. Setting up
// the gradebook and publishing stay with the office.
Astro.response.headers.set('Cache-Control', 'no-store');
const id = Astro.params.id!;
const here = `/teacher/exam/${encodeURIComponent(id)}`;
const { me, teacher } = await teacherSession(env.DB, env, Astro.request.headers.get('Cookie'));
if (!me) return Astro.redirect(`/account?return=${encodeURIComponent(here)}`, 303);
const exam = teacher ? await examAssessment(env.DB, id) : null;
if (teacher && !exam) return new Response('পরীক্ষাটি পাওয়া যায়নি।', { status: 404 });
if (teacher && exam && !(await batchForTeacher(env.DB, teacher.id, exam.batchId))) return new Response('এই পরীক্ষাটি আপনার ব্যাচের নয়।', { status: 403 });

const assigned = Boolean(teacher && exam && await teacherCanGrade(env.DB, id, teacher.id));
if (teacher && exam && !assigned) return new Response('এই বিষয়ের নম্বর দেওয়ার দায়িত্ব আপনার কাছে নেই।', { status: 403 });

if (Astro.request.method === 'POST' && teacher && exam) {
  if (!sameOrigin(Astro.request)) return new Response('Bad origin', { status: 403 });
  const form = await Astro.request.formData();
  const r = form.get('action') === 'submit'
    ? await submitAssessment(env.DB, me.email, id, teacher.id)
    : await saveExamMarks(env.DB, me.email, id, markInputsFromForm(form), teacher.id);
  return Astro.redirect(`${here}?${r.ok ? 'saved=1' : `error=${encodeURIComponent(r.error)}`}`, 303);
}
const rows = exam?.status ? await examMarks(env.DB, id) : [];
const canEdit = exam?.status === 'draft' && exam.examStatus === 'scheduled' && !exam.submittedAt;
const err = Astro.url.searchParams.get('error');
---

{
  !teacher || !exam ? (
    <NotTeacher me={me} />
  ) : (
    <AccountShell me={me} active="t-home" title={`নম্বর · ${exam.title}`} mode="teacher">
      <div class="ui">
        <header class="page-head">
          <div>
            <p class="eyebrow"><a href={`/teacher/batch/${exam.batchId}#assessment`}>{exam.batchName}</a></p>
            <h1>{exam.title}</h1>
            <p>{exam.subject || 'বিষয় লেখা নেই'} · {dayBn(exam.examDate)}</p>
          </div>
        </header>
        {Astro.url.searchParams.has('saved') && <p class="note note--good" role="status">নম্বর সংরক্ষণ হয়েছে।</p>}
        {err && <p class="note note--bad" role="alert">{err === 'marks' ? 'কোনো নম্বর পূর্ণমানের বেশি বা ভুল। কিছুই সংরক্ষণ হয়নি, ঠিক করে আবার সংরক্ষণ করুন।' : 'এই পরীক্ষার নম্বর এখন আর বদলানো যাবে না।'}</p>}
        {exam.examStatus === 'cancelled' ? (
          <p class="note note--bad">এই পরীক্ষা বাতিল হয়েছে।</p>
        ) : !exam.status ? (
          <p class="note">অফিস পূর্ণমান, পাস নম্বর ও পরীক্ষার্থী তালিকা ঠিক করলে এখানে নম্বর দিতে পারবেন।</p>
        ) : (
          <>
            {exam.status === 'published' && <p class="note note--good">ফল প্রকাশিত। নম্বর আর বদলানো যাবে না।</p>}
            {canEdit && <p class="muted">প্রত্যেকের নম্বর লিখুন বা "অনুপস্থিত" চাপুন, তারপর নিচের বোতামে একবারে সংরক্ষণ করুন। ফাঁকা রাখলে সেটি পরে দেওয়া যাবে। সব {bnDigits(exam.examinees)} জনের হয়ে গেলে অফিস ফল প্রকাশ করবে।</p>}
            {exam.status === 'draft' && exam.submittedAt && <p class="note">অফিসের পর্যালোচনায় নম্বরপত্র পাঠানো হয়েছে।</p>}
            {exam.reviewNote && <p class="note">পর্যালোচনার নোট · {exam.reviewNote}</p>}
            <MarkSheet exam={exam} rows={rows} editable={canEdit} />
            {canEdit && exam.examinees > 0 && exam.completed === exam.examinees && <form method="post" class="card">
              <input type="hidden" name="action" value="submit" /><button class="button">অফিসে পর্যালোচনার জন্য পাঠান</button>
            </form>}
          </>
        )}
      </div>
    </AccountShell>
  )
}
