---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE, whatsappUrl } from '../lib/site';
import { bnDigits } from '../lib/format';

const WAYS = [
  { icon: 'whatsapp', title: 'WhatsApp', value: 'মেসেজ পাঠান', href: whatsappUrl('আসসালামু আলাইকুম, মাদরাসাতুল ইনসাফ সম্পর্কে জানতে চাই।'), note: 'সবচেয়ে দ্রুত উত্তর পাবেন' },
  { icon: 'phone', title: 'ফোন', value: bnDigits(SITE.phone.display), href: `tel:${SITE.phone.tel}`, note: SITE.officeHours },
  { icon: 'mail', title: 'ইমেইল', value: SITE.email, href: `mailto:${SITE.email}`, note: 'বিস্তারিত প্রশ্ন বা প্রস্তাবের জন্য' },
  { icon: 'pin', title: 'কার্যালয়', value: SITE.address, href: SITE.mapUrl, note: 'ম্যাপে দেখুন' },
] as const;
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=3600');
---

<Base title="যোগাযোগ" description="মাদরাসাতুল ইনসাফের সাথে ফোন, WhatsApp বা ইমেইলে যোগাযোগ করুন।">
  <PageHero
    crumbs={[{ href: '/contact', label: 'যোগাযোগ' }]}
    eyebrow="যোগাযোগ"
    title="ভর্তি, দান বা যেকোনো প্রশ্নে আমরা আছি"
    lead="আপনার প্রশ্ন বা ফিডব্যাক জানাতে নিচের যেকোনো উপায়ে যোগাযোগ করুন। অফিস খোলা রবি থেকে বৃহস্পতিবার, সকাল ৯টা থেকে দুপুর ৩টা।"
    overlap
  />

  <section class="container ways">
    {
      WAYS.map((w) => (
        <a class="way" href={w.href} rel={w.href.startsWith('http') ? 'noopener' : undefined}>
          <span class="way__icon"><Icon name={w.icon} size={26} /></span>
          <span class="way__title">{w.title}</span>
          <strong>{w.value}</strong>
          <span class="muted">{w.note} <Icon name="arrow" size={16} /></span>
        </a>
      ))
    }
  </section>

  <section class="section container join">
    <div class="join__box">
      <div>
        <h2>মাদরাসার পাশে দাঁড়াতে চান?</h2>
        <p class="muted">স্থায়ী ক্যাম্পাসের জমি ক্রয় প্রজেক্ট চলছে। আপনার দান হতে পারে সদকায়ে জারিয়া।</p>
      </div>
      <a class="button button--gold" href="/land">
        <Icon name="heart" /> জমি প্রজেক্ট দেখুন
      </a>
    </div>
    <div class="social">
      <p class="muted">আমাদের সাথে থাকুন</p>
      <a href={SITE.facebook} rel="noopener"><Icon name="facebook" /> Facebook</a>
      <a href={SITE.youtube} rel="noopener"><Icon name="youtube" /> YouTube</a>
    </div>
  </section>
</Base>

<style>
  .ways {
    position: relative;
    margin-top: calc(-1 * var(--space-16));
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .way {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .way:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .way__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    margin-bottom: var(--space-2);
    background: var(--color-tint);
    color: var(--color-primary);
  }
  .way:first-child .way__icon {
    background: #25d366;
    color: var(--white);
  }
  .way__title {
    font: 600 var(--text-sm) / 1.4 var(--font-display);
    color: var(--color-ornament);
  }
  .way strong {
    font: 650 var(--text-lg) / 1.4 var(--font-display);
    color: var(--color-primary-strong);
    overflow-wrap: anywhere;
  }
  .way .muted {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .join__box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: var(--color-tint) var(--pattern-light);
    border: 1px solid var(--leaf-200);
  }
  .join__box h2 {
    font-size: var(--text-xl);
  }
  .join__box p {
    margin: 0;
    max-width: 60ch;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
  }
  .social p {
    margin: 0;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 1024px) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .ways {
      grid-template-columns: 1fr;
    }
    .join__box {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
