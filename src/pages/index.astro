---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import HomeHeroSlider from '../components/HomeHeroSlider.astro';
import FundProgress from '../components/donate/FundProgress.astro';
import DonateForm from '../components/donate/DonateForm.astro';
import { landDonorProgress, listFunds } from '../server/donations';
import { publishedPosts } from '../server/blog';
import { LAND } from '../lib/land';
import { FOUNDER, SITE, whatsappUrl } from '../lib/site';
import FeatureList from '../components/FeatureList.astro';
import { publicDepartments } from '../server/departments';
import { ADMISSION_CLASSES, FACILITIES } from '../lib/madrasa';
import { bnDigits, dateBn } from '../lib/format';

const [funds, posts, departments] = await Promise.all([listFunds(env.DB), publishedPosts(env.DB, { limit: 6 }), publicDepartments(env.DB)]);
const buy = funds.find((f) => f.slug === LAND.fund);
const members = funds.find((f) => f.slug === LAND.memberFund);
const landRaised = (buy?.raisedMinor ?? 0) + (members?.raisedMinor ?? 0);
const landDonors = buy ? (await landDonorProgress(env.DB, buy.id, members?.id, LAND.memberShareTaka * 100)).donors : 0;
const error = Astro.url.searchParams.get('error');
Astro.response.headers.set('Cache-Control', error ? 'no-store' : 'public, max-age=60, s-maxage=120');
---

<Base title={SITE.name}>
  <HomeHeroSlider />

  {
    posts.length > 0 && (
      <section class="container notices" aria-label="জরুরি আপডেট">
        <p class="notices__label"><Icon name="bell" size={18} /> জরুরি আপডেট</p>
        <div class="notices__track">
          <ul>
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.slug}`}>
                  <time>{dateBn(p.publishedAt)}</time> {p.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <a class="notices__all" href="/blog">সব নোটিশ</a>
      </section>
    )
  }

  {
    buy && (
      <section class="section">
        <div class="container land" data-reveal>
          <div class="land__copy">
            <p class="land__eyebrow">স্থায়ী ক্যাম্পাস ও ভূমি ক্রয় প্রজেক্ট</p>
            <h2>মাদরাসার নিজস্ব জমিতে স্থায়ী ক্যাম্পাস</h2>
            <p>যতদিন একজন শিক্ষার্থী এই জমিতে বসে কুরআন তিলাওয়াত করবে, ততদিন আপনার সদকায়ে জারিয়ার সাওয়াব জারি থাকবে ইন শা আল্লাহ।</p>
            <FundProgress raisedMinor={landRaised} goalMinor={buy.goalMinor ?? LAND.goalMinor} donors={landDonors} />
            <div class="land__cta">
              <a class="button" href="/land">প্রজেক্ট দেখুন ও দান করুন <Icon name="arrow" /></a>
            </div>
          </div>
          <img class="land__img" src="/images/home-campus-project-640.webp" srcset="/images/home-campus-project-640.webp 640w, /images/home-campus-project-1280.webp 1280w" sizes="(max-width: 900px) 100vw, 45vw" alt="মাদরাসার সবুজ মাঠে বসে থাকা শিক্ষার্থীরা" width="640" height="427" loading="lazy" />
        </div>
      </section>
    )
  }

  <section class="section section--tint">
    <div class="container about">
      <div data-reveal>
        <SectionHead align="start" eyebrow="পরিচিতি" title="কেন মাদরাসাতুল ইনসাফ?" />
        <div class="prose">
          <p>মাদরাসাতুল ইনসাফ একটি কুরআন ও সুন্নাহভিত্তিক ইলমি মারকাজ, যা আহলে সুন্নাত ওয়াল জামাআতের আকিদা ও উলামায়ে কেরামের বিশ্বস্ত ধারার আলোকে পরিচালিত। প্রতিষ্ঠানটি প্রতিষ্ঠা করেন {FOUNDER.name}, {FOUNDER.about.replace('।', '')}, যিনি এর নীতিগত অভিভাবক ও দিকনির্দেশক।</p>
          <p>এখানে ইলম শিক্ষা কেবল পাঠ্যসূচির মধ্যে সীমাবদ্ধ নয়; তালিম, তারবিয়ত ও দাওয়াতের সমন্বয়ে এমন হাফেজ, আলেম ও দীনি কর্মী গড়ে তোলার প্রয়াস চলে, যারা ব্যক্তি, সমাজ ও রাষ্ট্রজীবনে ন্যায়, ইনসাফ ও নৈতিকতার প্রতিনিধিত্ব করতে সক্ষম।</p>
          <p>মাদরাসাটি শূরাভিত্তিক পরিচালনা, সুস্পষ্ট গঠনতন্ত্র ও জবাবদিহিমূলক ব্যবস্থাপনার মাধ্যমে পরিচালিত হয়। শিক্ষা, প্রশাসন ও অর্থনীতিতে স্বচ্ছতা, আমানতদারি ও শৃঙ্খলা মৌলিক নীতি।</p>
        </div>
        <a class="button button--ghost" href="/about">বিস্তারিত পড়ুন <Icon name="arrow" /></a>
      </div>
      <div class="about__img" data-reveal>
        <img src="/images/home-why-insaf-640.webp" srcset="/images/home-why-insaf-640.webp 640w, /images/home-why-insaf-1280.webp 1280w" sizes="(max-width: 900px) 100vw, 40vw" alt="আলোচনায় বসা মাদরাসার উস্তাদগণ" width="640" height="427" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="শিক্ষা কার্যক্রম" title="মাদরাসাতুল ইনসাফের বিভাগসমূহ" />
      <div class="depts">
        {
          departments.map((d, i) => (
            <article class="dept" data-reveal>
              <span class="dept__no">{bnDigits(String(i + 1).padStart(2, '0'))}</span>
              <h3>{d.title}</h3>
              {d.summary && <p>{d.summary}</p>}
              <a class="dept__apply" href={`/admission/apply?dept=${d.slug}`}>ভর্তির আবেদন <Icon name="arrow" size={16} /></a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHead eyebrow="আমাদের বৈশিষ্ট্যসমূহ" title="কেন আপনার সন্তান এখানে নিরাপদ ও সমৃদ্ধ হবে" lead={`ভর্তি চলছে: ${ADMISSION_CLASSES}`} />
      <FeatureList />
      <p class="admit-cta"><a class="button" href="/admission/apply">অনলাইনে ভর্তির আবেদন <Icon name="arrow" size={18} /></a> <a class="button button--ghost" href="/blog">ভর্তির বিজ্ঞপ্তি দেখুন</a></p>
    </div>
  </section>

  <section class="section on-dark facilities">
    <div class="container">
      <SectionHead eyebrow="সুযোগ-সুবিধা" title="মাদরাসার সুযোগ-সুবিধাসমূহ" />
      <div class="fac">
        {
          FACILITIES.map((f) => (
            <article data-reveal>
              <span class="fac__icon"><Icon name={f.icon} size={24} /></span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container give">
      <div>
        <SectionHead align="start" eyebrow="দান করুন" title="আপনার অনুদান প্রদান করুন" lead="প্রতিটি তহবিলের হিসাব আলাদা রাখা হয়। আপনার দান ধন্যবাদের সাথে গৃহীত হবে।" />
        <ul class="give__funds">
          {
            funds.slice(0, 7).map((f) => (
              <li>
                <a href={f.slug === LAND.fund ? '/land' : `/donate/${f.slug}`}>
                  <span>{f.title}</span>
                  <Icon name="arrow" size={18} />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="give__zakat"><a href="/zakat"><Icon name="coins" size={18} /> যাকাত ক্যালকুলেটর দিয়ে আপনার যাকাত হিসাব করুন</a></p>
      </div>
      <DonateForm funds={funds} from="/" error={error} />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container contact">
      <SectionHead eyebrow="যোগাযোগ" title="আমাদের সাথে যোগাযোগ" />
      <div class="contact__grid">
        <a class="contact__card" href={`tel:${SITE.phone.tel}`} data-reveal>
          <Icon name="phone" size={26} />
          <strong>ফোন করুন</strong>
          <span>{bnDigits(SITE.phone.display)}</span>
          <small>{SITE.officeHours}</small>
        </a>
        <a class="contact__card" href={whatsappUrl()} rel="noopener" data-reveal>
          <Icon name="whatsapp" size={26} />
          <strong>WhatsApp</strong>
          <span>{bnDigits(SITE.phone.display)}</span>
          <small>প্রশ্ন বা ফিডব্যাক পাঠান</small>
        </a>
        <a class="contact__card" href={SITE.mapUrl} rel="noopener" data-reveal>
          <Icon name="pin" size={26} />
          <strong>আমাদের অবস্থান</strong>
          <span>{SITE.address}</span>
          <small>ম্যাপে দেখুন</small>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notices {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: center;
    margin-top: calc(-1 * var(--space-6));
    position: relative;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow);
    border: 1px solid var(--color-line);
  }
  .notices__label {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: 0;
    font-weight: 700;
    color: var(--bad-600);
    white-space: nowrap;
  }
  .notices__track {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .notices__track ul {
    display: flex;
    gap: var(--space-10);
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    animation: ticker 40s linear infinite;
  }
  .notices__track:hover ul {
    animation-play-state: paused;
  }
  @keyframes ticker {
    from {
      transform: translateX(30%);
    }
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .notices__track ul {
      animation: none;
    }
  }
  .notices a {
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .notices time {
    color: var(--gold-500);
    font-size: var(--text-sm);
  }
  .notices__all {
    font-weight: 650;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .notices {
      grid-template-columns: 1fr auto;
    }
    .notices__track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  .land {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--gold-100), var(--white) 65%);
    border: 1px solid color-mix(in srgb, var(--gold-500) 35%, transparent);
    box-shadow: var(--shadow);
  }
  @media (min-width: 900px) {
    .land {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .land__eyebrow {
    color: var(--gold-500);
    font-weight: 700;
    margin: 0;
  }
  .land h2 {
    margin: var(--space-2) 0;
  }
  .land__copy > p:not(.land__eyebrow) {
    color: var(--color-text-muted);
  }
  .land__cta {
    margin-top: var(--space-5);
  }
  .land__img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .section--tint {
    background: var(--color-tint);
    background-image: var(--pattern-light);
  }
  .about {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .about__img img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .admit-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .dept__apply {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-weight: 600;
  }
  .depts {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .dept {
    position: relative;
    padding: var(--space-8) var(--space-6) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .dept__no {
    font: 800 2.6rem / 1 var(--font-display);
    color: var(--gold-300);
  }
  .dept h3 {
    margin: var(--space-3) 0 var(--space-2);
  }
  .dept p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .facilities {
    background-color: var(--green-900);
    background-image: var(--pattern-dark);
  }
  .fac {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .fac article {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
  }
  .fac__icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgb(201 162 78 / 0.18);
    color: var(--gold-300);
  }
  .fac h3 {
    color: var(--white);
    margin: var(--space-3) 0 var(--space-2);
  }
  .fac p {
    margin: 0;
    color: var(--color-on-dark-muted);
  }
  .give {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }
  @media (min-width: 960px) {
    .give {
      grid-template-columns: 1fr 1fr;
    }
  }
  .give__funds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .give__funds a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
  }
  .give__funds a:hover {
    border-color: var(--green-700);
    color: var(--green-700);
  }
  .give__zakat a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font-weight: 600;
  }
  .contact__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .contact__card {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    text-align: center;
    padding: var(--space-8) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    transition: transform 0.25s var(--ease);
  }
  .contact__card:hover {
    transform: translateY(-3px);
  }
  .contact__card :global(svg) {
    color: var(--green-700);
    margin-bottom: var(--space-2);
  }
  .contact__card small {
    color: var(--color-text-muted);
  }
</style>
