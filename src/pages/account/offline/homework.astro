---
import { env } from 'cloudflare:workers';
import AccountShell from '../../../components/AccountShell.astro';
import NotOffline from '../../../components/NotOffline.astro';
import { currentStudent } from '../../../server/students';
import { offlineIdsForEmail } from '../../../server/panels';
import { sameOrigin } from '../../../server/session';
import { homeworkForEmail, homeworkKindBn, submitHomework } from '../../../server/assessment';
import { dayBn, todayDhaka } from '../../../lib/offline';
Astro.response.headers.set('Cache-Control','no-store');
const me=await currentStudent(env.DB,env,Astro.request.headers.get('Cookie'));
if(!me)return Astro.redirect('/account?return=%2Faccount%2Foffline%2Fhomework',303);
const today=todayDhaka();
const here='/account/offline/homework';
if(Astro.request.method==='POST'){
 if(!sameOrigin(Astro.request))return new Response('Bad origin',{status:403});
 const form=await Astro.request.formData();
 const r=await submitHomework(env.DB,me.email,String(form.get('assignmentId')??''),
  String(form.get('enrollmentId')??''),form.get('body'),today);
 return Astro.redirect(`${here}?${r.ok?'saved=1':`error=${encodeURIComponent(r.error)}`}`,303);
}
const [ids,list,direct]=await Promise.all([
 offlineIdsForEmail(env.DB,me.email),homeworkForEmail(env.DB,me.email),
 env.DB.prepare("SELECT id FROM offline_students WHERE lower(email)=lower(?) AND status='active'")
  .bind(me.email).all<{id:string}>()
]);
const directIds=new Set(direct.results.map(x=>x.id));
---
{ids.length===0?<NotOffline me={me}/>:<AccountShell me={me} active="offline-homework" title="হোমওয়ার্ক ও পাঠ">
 <header class="page-head"><div><p class="eyebrow">মাদরাসাতুল ইনসাফ</p><h1>আমার হোমওয়ার্ক ও পাঠ পরিকল্পনা</h1><p>প্রকাশিত কাজ, জমা দেওয়ার সময় এবং শিক্ষকের মতামত এখানে পাবেন।</p></div></header>
 {Astro.url.searchParams.has('saved')&&<p class="note note--good" role="status">উত্তর জমা হয়েছে।</p>}
 {Astro.url.searchParams.has('error')&&<p class="note note--bad" role="alert">জমা দেওয়া যায়নি। সময়সীমা, শিক্ষার্থীর অ্যাকাউন্ট ও উত্তরের দৈর্ঘ্য যাচাই করুন।</p>}
 {list.length===0?<p class="panel muted">এখনো কোনো প্রকাশিত হোমওয়ার্ক বা পাঠ পরিকল্পনা নেই।</p>:(
 <div class="homework-list">{list.map(a=><article class="panel hw" id={`a-${a.id}`}>
  <header><div><small>{homeworkKindBn(a.kind)} · {a.batchName} · {a.studentName}</small><h2>{a.title}</h2>
   <small>শেষ সময়: {dayBn(a.dueOn)} · {a.status==='closed'?'বন্ধ':'চালু'}</small></div>
   <span class="pill pill--info">{a.submissionState==='reviewed'?'মূল্যায়িত':a.submissionState==='submitted'?'জমা হয়েছে':a.kind==='lesson'?'পাঠ পরিকল্পনা':'জমা বাকি'}</span></header>
  {a.details&&<p class="details">{a.details}</p>}
  {a.body&&<section class="answer"><strong>জমা দেওয়া উত্তর</strong><p>{a.body}</p></section>}
  {a.submissionState==='reviewed'&&<div class="note note--good"><strong>শিক্ষকের মতামত</strong>
   {a.score!==null&&<p>মূল্যায়ন: {a.score}/১০০</p>}{a.feedback&&<p>{a.feedback}</p>}</div>}
  {a.kind==='homework'&&a.status==='published'&&a.dueOn>=today&&a.submissionState!=='reviewed'&&directIds.has(a.studentId)&&
   <form method="post" class="submit"><input type="hidden" name="assignmentId" value={a.id}/>
    <input type="hidden" name="enrollmentId" value={a.enrollmentId}/>
    <label class="field"><span>আমার উত্তর (কমপক্ষে ২, সর্বোচ্চ ৫০০০ অক্ষর)</span><textarea name="body" rows="5" minlength="2" maxlength="5000" required>{a.body??''}</textarea></label>
    <button class="button">{a.body?'উত্তর আপডেট করুন':'উত্তর জমা দিন'}</button>
   </form>}
  {a.kind==='homework'&&(!directIds.has(a.studentId)||a.dueOn<today||a.status==='closed')&&
   <small class="muted">জমা দেওয়া বন্ধ অথবা এই অ্যাকাউন্ট শুধু অভিভাবক হিসেবে দেখতে পারবে।</small>}
 </article>)}</div>)}
</AccountShell>}
<style>.homework-list{display:grid;gap:var(--space-5)}.hw header{display:flex;gap:var(--space-3);align-items:start;justify-content:space-between;flex-wrap:wrap}.hw h2{margin-block:var(--space-2)}.details,.answer p{white-space:pre-wrap}.answer{padding:var(--space-4);background:var(--color-surface-alt);border-radius:var(--radius-md)}.submit{display:grid;gap:var(--space-3);margin-top:var(--space-4)}.submit button{justify-self:start}</style>
