---
import { env } from 'cloudflare:workers';
import AccountShell from '../../../components/AccountShell.astro';
import NotOffline from '../../../components/NotOffline.astro';
import Icon from '../../../components/Icon.astro';
import { currentStudent } from '../../../server/students';
import { offlineIdsForEmail } from '../../../server/panels';
import { percentScore, publishedResultsForEmail, resultLabel, resultTone } from '../../../server/assessment';
import { bnDigits } from '../../../lib/format';
import { dayBn, studentCode } from '../../../lib/offline';

// Published results only. Drafts never reach students or guardians.
Astro.response.headers.set('Cache-Control', 'no-store');
const me = await currentStudent(env.DB, env, Astro.request.headers.get('Cookie'));
if (!me) return Astro.redirect('/account?return=%2Faccount%2Foffline%2Fresults', 303);
const ids = await offlineIdsForEmail(env.DB, me.email);
const results = ids.length ? await publishedResultsForEmail(env.DB, me.email) : [];
---

{
  ids.length === 0 ? (
    <NotOffline me={me} />
  ) : (
    <AccountShell me={me} active="offline-results" title="পরীক্ষার ফল">
      <div class="ui">
        <header class="page-head">
          <div>
            <h1>পরীক্ষার ফল</h1>
            <p>মাদরাসা যে পরীক্ষার ফল প্রকাশ করেছে, শুধু সেগুলোই এখানে দেখা যায়।</p>
          </div>
          {results.length > 0 && <button class="button button--ghost no-print" type="button" onclick="window.print()"><Icon name="printer" /> প্রিন্ট বা PDF</button>}
        </header>
        {results.length === 0 ? (
          <p class="card muted">এখনো কোনো পরীক্ষার ফল প্রকাশিত হয়নি।</p>
        ) : (
          <div class="reports">
            {results.map((r) => (
              <article class="card report">
                <header class="report__head">
                  <div>
                    <small class="muted">মাদরাসাতুল ইনসাফ · পরীক্ষার ফল</small>
                    <h2>{r.studentName} <span class="id">{studentCode(r.studentNo)}</span></h2>
                    <p>{r.title}{r.subject && ` · ${r.subject}`} · {r.batchName}</p>
                  </div>
                  <span class={`pill pill--${resultTone(r.obtained, r.passMarks, r.attendance)}`}>{resultLabel(r.obtained, r.passMarks, r.attendance)}</span>
                </header>
                <dl class="facts">
                  <div><dt>পরীক্ষার দিন</dt><dd>{dayBn(r.examDate)}</dd></div>
                  <div><dt>পূর্ণমান</dt><dd>{bnDigits(r.maxMarks)}</dd></div>
                  <div><dt>পাস নম্বর</dt><dd>{bnDigits(r.passMarks)}</dd></div>
                  <div><dt>প্রাপ্ত নম্বর</dt><dd>{r.attendance === 'absent' ? 'অনুপস্থিত' : bnDigits(r.obtained ?? 0)}</dd></div>
                  <div><dt>শতকরা</dt><dd>{r.attendance === 'absent' ? 'নেই' : `${bnDigits(percentScore(r.obtained ?? 0, r.maxMarks))}%`}</dd></div>
                </dl>
                {r.comment && <p class="muted">শিক্ষকের মন্তব্য: {r.comment}</p>}
              </article>
            ))}
          </div>
        )}
      </div>
    </AccountShell>
  )
}

<style>
  .reports {
    display: grid;
    gap: var(--space-5);
  }
  .report__head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .report__head h2 {
    margin-block: var(--space-1);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }
  .facts > div {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }
  .facts dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .facts dd {
    margin: 0;
    font: 700 var(--text-lg) / 1.4 var(--font-display);
  }
  /* Print just the result cards, not the site's header, menus or footer. */
  @media print {
    .no-print,
    :global(body > header),
    :global(.footer),
    :global(.bnav),
    :global(.fab),
    :global(.acc-hero),
    :global(.acc-nav) {
      display: none !important;
    }
    .report {
      break-inside: avoid;
      box-shadow: none;
    }
  }
</style>
