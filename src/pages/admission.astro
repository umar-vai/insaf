---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { SITE, whatsappUrl } from '../lib/site';
import { DEPARTMENTS, FACILITIES } from '../lib/madrasa';
import { bnDigits } from '../lib/format';

// Admission is handled at the office; this page says what there is and how
// to reach the office. Fees and dates are not published on the old site, so
// none are written here.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=3600');
---

<Base title="ভর্তি তথ্য" description="মাদরাসাতুল ইনসাফে নুরানি, নাজেরা ও হিফজুল কুরআন এবং কিতাব বিভাগে ভর্তি সম্পর্কে জানুন। আবাসিক সুবিধা ও স্কলারশিপ।">
  <PageHero image="reception" crumbs={[{ href: '/admission', label: 'ভর্তি' }]} eyebrow="ভর্তি" title="আপনার সন্তানের ইলমিযাত্রা শুরু হোক এখান থেকে" lead="ভর্তি, আসন ও ফি সম্পর্কে জানতে অফিসে যোগাযোগ করুন বা সরাসরি মাদরাসায় আসুন।">
    <div class="hero-cta">
      <a class="button button--gold" href="/admission/apply"><Icon name="check" size={18} /> অনলাইনে আবেদন</a>
      <a class="button button--gold" href={`tel:${SITE.phone.tel}`}><Icon name="phone" size={18} /> {bnDigits(SITE.phone.display)}</a>
      <a class="button button--ghost" href={whatsappUrl('আসসালামু আলাইকুম, ভর্তি সম্পর্কে জানতে চাই।')} rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
    </div>
  </PageHero>

  <section class="section container">
    <SectionHead eyebrow="বিভাগসমূহ" title="কোন বিভাগে ভর্তি হবেন" />
    <div class="depts">
      {
        DEPARTMENTS.map((d, i) => (
          <article data-reveal>
            <span class="no">{bnDigits(String(i + 1).padStart(2, '0'))}</span>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
            <a href={`/admission/apply?dept=${d.key}`}>এই বিভাগে ভর্তির আবেদন করুন <Icon name="arrow" size={16} /></a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHead eyebrow="সুযোগ-সুবিধা" title="শিক্ষার্থীরা যা পায়" />
      <div class="facs">
        {
          FACILITIES.map((f) => (
            <article data-reveal>
              <Icon name={f.icon} size={24} />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section container visit">
    <div>
      <h2>অফিসের সময়</h2>
      <p>{SITE.officeHours}</p>
      <p><Icon name="pin" size={18} /> <a href={SITE.mapUrl} rel="noopener">{SITE.address}</a></p>
    </div>
    <div class="portal">
      <h2>ভর্তি হয়ে গেছে?</h2>
      <p>অফিস থেকে পাওয়া মোবাইল নম্বর ও পাসওয়ার্ড দিয়ে স্টুডেন্ট পোর্টালে হাজিরা, ফি, রসিদ আর নোটিশ দেখুন।</p>
      <a class="button" href="/account"><Icon name="user" size={18} /> পোর্টালে লগইন</a>
    </div>
  </section>
</Base>

<style>
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .depts {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .depts article,
  .facs article {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .no {
    font: 800 2.4rem / 1 var(--font-display);
    color: var(--gold-300);
  }
  h3 {
    margin: 0;
  }
  .depts p,
  .facs p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .depts a {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    font-weight: 600;
  }
  .section--tint {
    background: var(--color-tint);
    background-image: var(--pattern-light);
  }
  .facs {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .facs :global(svg) {
    color: var(--gold-500);
  }
  .visit {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 860px) {
    .visit {
      grid-template-columns: 1fr 1fr;
    }
  }
  .portal {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--gold-100);
  }
</style>
