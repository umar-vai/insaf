---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { donationByReference, isDonationReference } from '../../server/donations';
import { SITE, whatsappUrl } from '../../lib/site';
import { bnDigits, dateBn, taka } from '../../lib/format';

// Where SSLCommerz sends the donor back. The reference is long and random, so
// only the donor (who has the link) sees this receipt. The phone number is
// partly hidden all the same.
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const ref = Astro.url.searchParams.get('ref') ?? '';
const d = isDonationReference(ref) ? await donationByReference(env.DB, ref) : null;
const paid = d?.status === 'paid' && !d.voidedAt;
const waiting = d?.status === 'pending' || d?.status === 'review';
const maskedPhone = d?.donorPhone ? `${d.donorPhone.slice(0, 3)}••••${d.donorPhone.slice(-3)}` : '';
---

<Base title={paid ? 'দান গৃহীত হয়েছে' : 'দানের অবস্থা'}>
  <section class="section done">
    <div class="container narrow">
      {
        !d ? (
          <div class="box">
            <h1>রসিদ পাওয়া যায়নি</h1>
            <p>লিংকটি ঠিক আছে কি না দেখুন, অথবা <a href={`tel:${SITE.phone.tel}`}>{bnDigits(SITE.phone.display)}</a> নম্বরে ফোন করুন।</p>
            <a class="button" href="/donate">দানের পেজে যান</a>
          </div>
        ) : (
          <div class="box" data-receipt>
            <div class:list={['status', paid ? 'status--ok' : waiting ? 'status--wait' : 'status--bad']}>
              <Icon name={paid ? 'check' : waiting ? 'clock' : 'alert'} size={34} />
            </div>
            {paid ? (
              <>
                <p class="arabic thanks" lang="ar">جَزَاكَ اللّٰهُ خَيْرًا</p>
                <h1>আপনার দান গৃহীত হয়েছে</h1>
                <p class="muted">আল্লাহ তা‘আলা আপনার দান কবুল করুন এবং উত্তম প্রতিদান দিন।</p>
              </>
            ) : waiting ? (
              <>
                <h1>পেমেন্ট যাচাই হচ্ছে</h1>
                <p class="muted">{d.status === 'review' ? 'আপনার পেমেন্ট অফিস থেকে মিলিয়ে দেখা হচ্ছে। শিগগিরই নিশ্চিত করা হবে।' : 'কয়েক সেকেন্ড অপেক্ষা করুন, পেজটি নিজে থেকেই হালনাগাদ হবে।'}</p>
              </>
            ) : (
              <>
                <h1>{d.status === 'cancelled' ? 'পেমেন্ট বাতিল হয়েছে' : 'পেমেন্ট সম্পন্ন হয়নি'}</h1>
                <p class="muted">কোনো টাকা কাটা হয়ে থাকলে অফিসে যোগাযোগ করুন। চাইলে আবার চেষ্টা করতে পারেন।</p>
                <a class="button button--gold" href={`/donate/${d.fundSlug}?amount=${d.amountMinor / 100}#donate-form`}>আবার চেষ্টা করুন</a>
              </>
            )}

            <dl class="receipt">
              <div><dt>রসিদ নম্বর</dt><dd class="mono">{d.reference}</dd></div>
              <div><dt>তহবিল</dt><dd>{d.fundTitle}</dd></div>
              <div><dt>পরিমাণ</dt><dd class="amount">{taka(d.amountMinor)}</dd></div>
              <div><dt>দাতা</dt><dd>{d.donorName}</dd></div>
              {d.onBehalf && <div><dt>যার পক্ষ থেকে</dt><dd>{d.onBehalf}</dd></div>}
              {maskedPhone && <div><dt>মোবাইল</dt><dd>{maskedPhone}</dd></div>}
              <div><dt>তারিখ</dt><dd>{dateBn(d.paidAt ?? d.createdAt, true)}</dd></div>
              {d.method && <div><dt>মাধ্যম</dt><dd>{d.method}</dd></div>}
              <div><dt>অবস্থা</dt><dd>{paid ? 'পরিশোধিত' : waiting ? 'যাচাই চলছে' : 'অসম্পূর্ণ'}</dd></div>
            </dl>

            <div class="actions">
              {paid && <button class="button button--ghost" type="button" onclick="print()"><Icon name="printer" size={18} /> রসিদ প্রিন্ট / সেভ</button>}
              <a class="button button--ghost" href={whatsappUrl(`আমার দানের রসিদ নম্বর ${d.reference}`)} rel="noopener"><Icon name="whatsapp" size={18} /> অফিসে জানান</a>
              <a class="button" href="/donate">অন্য তহবিলে দান</a>
            </div>
            <p class="org">{SITE.nameBn} · {SITE.address} · {bnDigits(SITE.phone.display)}</p>
          </div>
        )
      }
    </div>
  </section>
  {waiting && d?.status === 'pending' && <meta http-equiv="refresh" content="6" slot="head" />}
  {
    paid && (
      <script is:inline define:vars={{ ref: d!.reference, value: d!.amountMinor / 100 }}>
        // One conversion per payment on this browser, even after the tab is closed
        // and the receipt link is opened again (localStorage, not sessionStorage).
        // The reference is also the event id, so a later server side event for the
        // same gift is counted once by Meta, and the GA4 transaction id.
        try {
          var key = 'conv:' + ref;
          var seen = false;
          try { seen = !!localStorage.getItem(key); } catch (e) {}
          if (!seen) {
            window.fbq?.('track', 'Donate', { value, currency: 'BDT' }, { eventID: 'donate-' + ref });
            window.fbq?.('track', 'Purchase', { value, currency: 'BDT' }, { eventID: 'purchase-' + ref });
            window.gtag?.('event', 'purchase', { transaction_id: ref, value, currency: 'BDT' });
            try { localStorage.setItem(key, '1'); } catch (e) {}
          }
        } catch (e) {}
      </script>
    )
  }
</Base>

<style>
  .done {
    background-image: var(--pattern-light);
  }
  .narrow {
    max-width: 640px;
  }
  .box {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }
  h1 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0;
  }
  .thanks {
    font-size: 1.8rem;
    color: var(--gold-500);
    margin: var(--space-2) 0 0;
  }
  .status {
    display: inline-grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
  }
  .status--ok {
    background: var(--good-100);
    color: var(--good-700);
  }
  .status--wait {
    background: var(--warn-100);
    color: var(--warn-700);
  }
  .status--bad {
    background: var(--bad-100);
    color: var(--bad-700);
  }
  .receipt {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-6) 0;
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--ivory);
    border: 1px dashed var(--color-line);
    text-align: start;
  }
  .receipt div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }
  .receipt dt {
    color: var(--color-text-muted);
  }
  .receipt dd {
    margin: 0;
    font-weight: 600;
    text-align: end;
    overflow-wrap: anywhere;
  }
  .amount {
    color: var(--green-700);
    font-size: var(--text-lg);
  }
  .mono {
    font-family: ui-monospace, monospace;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
  .org {
    margin: var(--space-6) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  @media print {
    :global(header),
    :global(footer),
    :global(.bnav),
    :global(.wa-fab),
    .actions {
      display: none !important;
    }
    .box {
      box-shadow: none;
      border: 0;
    }
  }
</style>
