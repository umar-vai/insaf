---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import DonateForm from '../../components/donate/DonateForm.astro';
import FundProgress from '../../components/donate/FundProgress.astro';
import BankCard from '../../components/donate/BankCard.astro';
import { donationSummary, listFunds, recentGifts } from '../../server/donations';
import { LAND } from '../../lib/land';
import { bnDigits, dateBn, mediaUrl, taka } from '../../lib/format';

const [funds, summary, recent] = await Promise.all([listFunds(env.DB), donationSummary(env.DB), recentGifts(env.DB, null, 8)]);
const error = Astro.url.searchParams.get('error');
const preset = Astro.url.searchParams.get('fund') ?? undefined;
Astro.response.headers.set('Cache-Control', error ? 'no-store' : 'public, max-age=30, s-maxage=60');
---

<Base title="দান করুন" description="মাদরাসাতুল ইনসাফের তহবিলসমূহে দান করুন: জমি ক্রয়, সাদকায়ে জারিয়া, যাকাত, ইফতার ও নিয়মিত দান। বিকাশ, নগদ, কার্ডে নিরাপদে।">
  <PageHero eyebrow="দান করুন" title="আপনার দান, আগামী প্রজন্মের ইলমিযাত্রা" lead="প্রতিটি তহবিলের হিসাব আলাদা রাখা হয়। যে খাতে দেবেন, সে খাতেই ব্যয় হবে ইন শা আল্লাহ।" crumbs={[{ href: '/donate', label: 'দান' }]}>
    <ul class="stats">
      <li><strong>{taka(summary.totalMinor)}</strong><span>মোট সংগ্রহ</span></li>
      <li><strong>{bnDigits(summary.donors)}</strong><span>জন দাতা</span></li>
      <li><strong>{taka(summary.monthMinor)}</strong><span>এই মাসে</span></li>
    </ul>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <div>
        <SectionHead align="start" eyebrow="তহবিলসমূহ" title="যে খাতে দান করতে চান" />
        <div class="funds">
          {
            funds.map((f) => (
              <a class:list={['fund', f.slug === LAND.fund && 'fund--feature']} href={f.slug === LAND.fund ? '/land' : `/donate/${f.slug}`} data-reveal>
                {f.coverKey && <img src={mediaUrl(f.coverKey)} alt="" loading="lazy" />}
                <div class="fund__body">
                  <h3>{f.title}</h3>
                  {f.summary && <p>{f.summary}</p>}
                  <FundProgress raisedMinor={f.raisedMinor} goalMinor={f.goalMinor} donors={f.donors} memberGoal={f.memberGoal} size="sm" />
                  <span class="fund__go">
                    বিস্তারিত ও দান <Icon name="arrow" size={18} />
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
      <aside class="side">
        <DonateForm funds={funds} fund={preset && funds.some((f) => f.slug === preset) ? preset : undefined} from="/donate" error={error} />
        <BankCard />
      </aside>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="section section--tint">
        <div class="container">
          <SectionHead eyebrow="জাযাকুমুল্লাহু খাইরান" title="সাম্প্রতিক দাতাগণ" />
          <ul class="recent">
            {recent.map((g) => (
              <li data-reveal>
                <strong>{g.name || 'আল্লাহর এক বান্দা'}</strong>
                <span>{taka(g.amountMinor)}</span>
                <small>{dateBn(g.paidAt)}</small>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
  }
  .stats li {
    display: grid;
  }
  .stats strong {
    font: 700 var(--text-xl) / 1.2 var(--font-display);
    color: var(--gold-300);
  }
  .stats span {
    color: var(--color-on-dark-muted);
    font-size: var(--text-sm);
  }
  .layout {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 1.25fr 1fr;
    }
    .side {
      position: sticky;
      top: calc(var(--header-h) + var(--space-4));
    }
  }
  .side {
    display: grid;
    gap: var(--space-6);
  }
  .funds {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .fund {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .fund:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .fund--feature {
    grid-column: 1 / -1;
    border-color: color-mix(in srgb, var(--gold-500) 45%, transparent);
    background: linear-gradient(135deg, var(--gold-100), var(--white) 70%);
  }
  .fund img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .fund__body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .fund h3 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .fund p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .fund__go {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    color: var(--color-primary);
    font-weight: 650;
  }
  .section--tint {
    background: var(--color-tint);
    background-image: var(--pattern-light);
  }
  .recent {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recent li {
    display: grid;
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .recent span {
    color: var(--green-700);
    font-weight: 700;
  }
  .recent small {
    color: var(--color-text-muted);
  }
</style>
