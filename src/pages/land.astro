<script>
  // The phone's "give" button shows only while the form itself is out of sight.
  const sticky = document.querySelector<HTMLElement>('[data-sticky]');
  const formEl = document.getElementById('donate-form');
  if (sticky && formEl) {
    new IntersectionObserver(([e]) => (sticky.hidden = Boolean(e?.isIntersecting))).observe(formEl);
  }
</script>

