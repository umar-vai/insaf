---
import { env } from 'cloudflare:workers';
import '../styles/land-foundation.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import DonateForm from '../components/donate/DonateForm.astro';
import FundProgress from '../components/donate/FundProgress.astro';
import BankCard from '../components/donate/BankCard.astro';
import BarChart from '../components/admin/BarChart.astro';
import { fundUpdates, listFunds, monthlyTotals, recentGifts, storyHtml } from '../server/donations';
import { LAND } from '../lib/land';
import { FOUNDER, SITE, whatsappUrl } from '../lib/site';
import { bnDigits, dateBn, mediaUrl, taka } from '../lib/format';
import { monthBn } from '../lib/offline';

// The land purchase landing page, made for ads: the reason in a few lines,
// how far the goal is, and the form, again and again, never more than a
// thumb away. Every number on it comes from counted gifts.

const funds = await listFunds(env.DB);
const buy = funds.find((f) => f.slug === LAND.fund);
const members = funds.find((f) => f.slug === LAND.memberFund);
if (!buy) return Astro.redirect('/donate', 302);

const landIds = [buy.id, members?.id].filter(Boolean) as string[];
const raisedMinor = buy.raisedMinor + (members?.raisedMinor ?? 0);
const donors = buy.donors + (members?.donors ?? 0);
const gifts = buy.gifts + (members?.gifts ?? 0);
// The approved foundation goal is authoritative; keep Admin fund data synchronized.
const goalMinor = LAND.goalMinor;
const founderVideoCandidate = import.meta.env.PUBLIC_FOUNDER_VIDEO_EMBED_URL ?? '';
const founderVideo = /^https:\/\/(?:www\.)?(?:youtube(?:-nocookie)?\.com\/embed\/|player\.vimeo\.com\/video\/)[A-Za-z0-9_\-/?=&]+$/.test(founderVideoCandidate) ? founderVideoCandidate : null;

const [months, recent, updates] = await Promise.all([
  Promise.all(landIds.map((id) => monthlyTotals(env.DB, id, 9))),
  recentGifts(env.DB, buy.id, 10),
  fundUpdates(env.DB, buy.id),
]);
const monthRows = months[0]!.map((m, i) => ({ label: monthBn(m.month), values: [months.reduce((s, f) => s + (f[i]?.minor ?? 0), 0)] }));
const error = Astro.url.searchParams.get('error');
const formFunds = funds.filter((f) => landIds.includes(f.id));
Astro.response.headers.set('Cache-Control', error ? 'no-store' : 'public, max-age=30, s-maxage=60');

const WHY = [
  {
    icon: 'heart',
    title: 'সদকায়ে জারিয়া',
    text: 'ইলমের কাজে সহায়তা করার মাধ্যমে সদকায়ে জারিয়ার সওয়াবের আশা করা যায়।',
  },
  { icon: 'home', title: 'স্থায়ী ঠিকানা', text: 'এটি হবে দীনি শিক্ষার একটি মজবুত দুর্গ, যা আগামী প্রজন্মের ঈমান রক্ষায় কাজ করবে।' },
  { icon: 'users', title: 'প্রিয়জনদের স্মরণে', text: 'আপনি চাইলে আপনার মৃত বাবা-মা বা প্রিয়জনদের নামেও জমি ক্রয়ে শরিক হতে পারেন।' },
] as const;

const FAQ = [
  {
    q: 'দানের টাকা কোথায় খরচ হবে?',
    a: 'এই জমি ক্রয় তহবিল তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশনের মসজিদ, মাদরাসা ও ইসলামিক সেন্টার প্রতিষ্ঠার পরিকল্পনার জন্য। প্রকল্পের দান আলাদাভাবে হিসাব করা হয়।',
  },
  { q: 'কীভাবে দান করব?', a: 'বিকাশ, নগদ, রকেট, কার্ড বা নেট ব্যাংকিংয়ে এই পেজ থেকেই দান করা যায়। বড় অঙ্কের দান মাদরাসার ব্যাংক অ্যাকাউন্টে পাঠাতে পারেন।' },
  { q: 'রসিদ পাব কি?', a: 'হ্যাঁ। পেমেন্ট নিশ্চিত হলেই রসিদ দেখা ও প্রিন্ট করা যায়। ব্যাংকে বা অফিসে দিলে অফিস থেকে রসিদ দেওয়া হয়।' },
  { q: 'মৃত বাবা-মায়ের পক্ষ থেকে দান করা যাবে?', a: 'অবশ্যই। ফর্মে “অন্য কারো পক্ষ থেকে দান” ঘরে তাঁদের নাম লিখে দিন।' },
  { q: 'এই প্রকল্পের মোট লক্ষ্য কত?', a: 'জমি ক্রয়ের বর্তমান নির্ধারিত লক্ষ্য ২ কোটি ৫০ লাখ টাকা (৳২,৫০,০০,০০০)।' },
  { q: 'হিরোতে দেখানো জমি ও ভবন কি প্রকৃত প্রকল্পস্থলের ছবি?', a: 'না। এটি প্রকল্পের পরিকল্পনা বোঝাতে তৈরি করা একটি প্রতীকী দৃশ্য; প্রকৃত জমি বা নির্মিত ভবনের ছবি নয়।' },
  { q: 'এই প্রকল্প কোন প্রতিষ্ঠানের অধীনে?', a: 'জমি প্রকল্পের উদ্যোগ ও তহবিল সংগ্রহ তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশনের নামে পরিচালিত। ব্যাংক ট্রান্সফারের আগে প্রদর্শিত ব্যাংক হিসাবের প্রকৃত প্রাপকের নাম অবশ্যই মিলিয়ে নিন।' },
] as const;
---

<Base title="জমি ক্রয় প্রজেক্ট — তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশন" description="তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশনের মসজিদ, মাদরাসা ও ইসলামিক সেন্টারের জন্য ২.৫ কোটি টাকার জমি ক্রয় তহবিল।" image="/images/tamrin-foundation-land-hero-wide-20261111.avif" bottomNav={false} foundationTheme>

  <section class="foundation-hero" aria-labelledby="land-title">
    <div class="container foundation-hero__grid">
      <div class="foundation-hero__copy">
        <span class="foundation-hero__eyebrow"><Icon name="heart" size={16} /> তামরিন ফাউন্ডেশনের জমি ক্রয় প্রকল্প</span>
        <h1 id="land-title"><span class="foundation-hero__first-line">একখণ্ড জমি</span><span class="foundation-hero__highlight">মসজিদ, মাদরাসা ও ইসলামিক সেন্টারের জন্য।</span></h1>
        <p class="foundation-hero__lead">তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশনের পরিকল্পিত মসজিদ, মাদরাসা ও ইসলামিক সেন্টারের জন্য উপযুক্ত জমি কিনতে আমরা তহবিল সংগ্রহ করছি। ইবাদত, কুরআন শিক্ষা ও দ্বীনি জ্ঞানচর্চার একটি স্থায়ী কেন্দ্র গড়ে তোলার এই উদ্যোগে আপনিও অংশ নিতে পারেন।</p>
        <div class="foundation-hero__actions">
          <a class="button button--gold" href="#donate-form"><Icon name="heart" size={18} /> এখনই জমির জন্য দান করুন</a>
          <a class="button button--ghost" href="#land-story"><Icon name="arrow" size={17} /> প্রকল্পটি জানুন</a>
        </div>
        <div class="foundation-hero__micro"><span><Icon name="check" size={16} /> নির্দিষ্ট জমি তহবিল</span><span><Icon name="check" size={16} /> পেমেন্ট রসিদ</span><span><Icon name="check" size={16} /> অগ্রগতির হিসাব</span></div>
      </div>
      <figure class="foundation-landscape">
        <img
          src="/images/tamrin-foundation-land-hero-wide-20261111.avif"
          alt="তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশনের মসজিদ, মাদরাসা ও ইসলামিক সেন্টারের পরিকল্পনার প্রতীকী দৃশ্য—সামনে প্রস্তাবিত জমির সাইনবোর্ড ও সবুজ জমি, পেছনে ভবন"
          width="1672" height="941" fetchpriority="high" decoding="async"
        />
      </figure>
      <div class="foundation-hero__goal" aria-label="জমি ক্রয়ের লক্ষ্যমাত্রা">
        <span class="foundation-hero__goal-icon" aria-hidden="true">◎</span>
        <span><small>আমাদের লক্ষ্য</small><strong>৳২,৫০,০০,০০০</strong></span>
      </div>
    </div>
  </section>

  <section class="foundation-donate" aria-labelledby="donate-title">
    <div class="container foundation-donate__grid">
      <div class="foundation-donate__copy">
        <span class="foundation-donate__label">আমাদের সম্মিলিত লক্ষ্য</span>
        <div class="foundation-donate__goal">৳২,৫০,০০,০০০</div>
        <h2 id="donate-title">জমি ক্রয়ের লক্ষ্যে এগিয়ে চলি একসঙ্গে</h2>
        <p>ছোট-বড় প্রতিটি দান একই জমি ক্রয় লক্ষ্য পূরণে সহযোগিতা করে। এখানে প্রদর্শিত সংগ্রহ, দাতা ও দানের সংখ্যা সংরক্ষিত লেনদেনের তথ্য থেকে আসছে।</p>
        <div class="foundation-donate__progress"><FundProgress raisedMinor={raisedMinor} goalMinor={goalMinor} donors={donors} gifts={gifts} onDark /></div>
      </div>
      <div class="foundation-donate__form"><DonateForm funds={formFunds} fund={buy.slug} title="জমি ক্রয় তহবিলে দান করুন" from="/land" error={error} /></div>
    </div>
  </section>

  <section class="foundation-family" aria-labelledby="family-title"><div class="container">
    <div class="foundation-family__brand">
      <span class="foundation-family__parent">আমাদের প্যারেন্ট প্রতিষ্ঠান</span>
      <img src="/foundation-logo.svg" width="286" height="131" alt="Tamrin Education Network Foundation" loading="lazy" />
    </div>
    <div class="foundation-family__intro">
      <p class="foundation-family__eyebrow">আমাদের প্রাতিষ্ঠানিক পরিবার</p>
      <h2 id="family-title">একটি ফাউন্ডেশন, শিক্ষা ও সেবার যৌথ উদ্যোগ</h2>
      <p>এই জমি ক্রয় প্রকল্পের পরিকল্পনা ও তহবিল সংগ্রহ তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশনের নামে। লক্ষ্য—দীর্ঘমেয়াদে ইবাদত, ইসলামিক শিক্ষা ও সামাজিক সেবার জন্য একটি স্থায়ী অবকাঠামোর ভিত্তি তৈরি করা।</p>
    </div>
    <div class="foundation-family__cards">
      <article class="foundation-family__card"><small>শিক্ষা উদ্যোগ</small><h3>Tamrin Institute of Bangladesh</h3><p>অনলাইনভিত্তিক কুরআন ও আরবি শিক্ষার উদ্যোগ।</p></article>
      <span class="foundation-family__link" aria-hidden="true">+</span>
      <article class="foundation-family__card"><small>ফাউন্ডেশনের জমি প্রকল্প</small><h3>মসজিদ, মাদরাসা ও ইসলামিক সেন্টার</h3><p>নামাজ, কুরআন শিক্ষা, ইলমচর্চা ও জনকল্যাণমূলক সেবার পরিকল্পিত স্থায়ী কেন্দ্র।</p></article>
    </div>
  </div></section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="কেন এই দান" title="দীনি শিক্ষার স্থায়ী ভিত্তি গড়তে আপনার অবদান" lead="মসজিদ, মাদরাসা ও ইসলামিক সেন্টারের জন্য নিজস্ব জমি একটি স্থায়ী ভিত্তি গড়ে দেয়। সেই লক্ষ্যেই তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশন জমি ক্রয় তহবিল সংগ্রহ করছে।" />
      <div class="why">
        {
          WHY.map((w) => (
            <article class="why__card" data-reveal>
              <span class="why__icon"><Icon name={w.icon} size={26} /></span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </article>
          ))
        }
      </div>
      <figure class="quote" data-reveal>
        <blockquote>“যে ব্যক্তি আল্লাহর সন্তুষ্টির জন্য একটি মসজিদ নির্মাণ করল, আল্লাহ তা‘আলা জান্নাতে তার জন্য একটি ঘর নির্মাণ করবেন।”</blockquote>
        <figcaption>সহীহ মুসলিম</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--tint" id="land-story">
    <div class="container story">
      <div class="story__img" data-reveal>
        <img src="/images/students-quran-1280.webp" srcset="/images/students-quran-640.webp 640w, /images/students-quran-1280.webp 1280w" sizes="(max-width: 900px) 100vw, 45vw" alt="কুরআন শিক্ষায় নিয়োজিত শিক্ষার্থীদের প্রতীকী আলোকচিত্র" width="1280" height="853" loading="lazy" />
      </div>
      <div data-reveal>
        <SectionHead align="start" eyebrow="ব্যয়ের খাত" title="জমি ক্রয়" />
        <p class="lead-text">তামরিন এডুকেশন নেটওয়ার্ক ফাউন্ডেশন এমন একটি জমি সংগ্রহের পরিকল্পনা করেছে, যেখানে ভবিষ্যতে মসজিদ, মাদরাসা এবং ইসলামিক সেন্টার গড়ে তোলা সম্ভব হবে। আপনার দান জমি ক্রয়ের নির্দিষ্ট তহবিলে হিসাবভুক্ত হয়। প্রকল্পের আর্থিক অগ্রগতি এই পেজেই দেখানো হচ্ছে।</p>
        <ul class="ticks">
          <li><Icon name="check" size={18} /> লক্ষ্য {taka(goalMinor)}</li>
          <li><Icon name="check" size={18} /> প্রতিটি দানের হিসাব আলাদা তহবিলে রাখা হয়</li>
          <li><Icon name="check" size={18} /> প্রকল্পের সংগ্রহ ও অগ্রগতি নিয়মিত দেখার সুযোগ</li>
        </ul>
      </div>
    </div>
  </section>


  <section class="foundation-founder" aria-labelledby="founder-title">
    <div class="container foundation-founder__grid">
      <div class="foundation-founder__media">
        {founderVideo ? (
          <iframe src={founderVideo} title="প্রতিষ্ঠাতার ভিডিও বাণী" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        ) : (
          <div class="foundation-founder__placeholder" role="img" aria-label="প্রতিষ্ঠাতার ভিডিও বাণী সংযোজনের স্থান">
            <strong>প্রতিষ্ঠাতার ভিডিও বাণী</strong>
            <p>অনুমোদিত ভিডিও লিংক যুক্ত হলে এই অংশে সরাসরি ভিডিও দেখা যাবে।</p>
          </div>
        )}
      </div>
      <div class="foundation-founder__copy">
        <p>প্রতিষ্ঠাতার বাণী</p>
        <h2 id="founder-title">একটি প্রজন্মের জন্য দীর্ঘমেয়াদি শিক্ষার ঠিকানা</h2>
