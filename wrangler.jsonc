{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insaf",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Every night at 00:15 Dhaka time: late fees (src/worker.ts, scheduled).
  "triggers": { "crons": ["15 18 * * *"] },
  // Top level is local development. Production is env "production" below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insaf-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "insaf-media-local" }],
  // Sign-in tries per visitor IP, and payment starts per visitor or student.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CHECKOUT_LIMITER", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "SITE_NAME": "Madrasatul Insaf",
    "ENVIRONMENT": "local",
    "META_PIXEL_ID": "1270876547892049",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
    // Owners (ADMIN_EMAILS) are a secret: .dev.vars locally, wrangler secret elsewhere.
  },
  "env": {
    // madrasatulinsaf.org. Worker routes on the proxied records put this worker
    // in front of the old WordPress, which stays untouched behind it.
    // Rollback: delete the two routes (dashboard, Workers Routes) and WordPress
    // answers again within a minute.
    // Secrets: SESSION_SECRET, ADMIN_EMAILS, optional GOOGLE_CLIENT_ID and
    // GOOGLE_CLIENT_SECRET, SSLCZ_STORE_ID, SSLCZ_STORE_PASSWORD.
    "production": {
      "name": "insaf",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        { "pattern": "madrasatulinsaf.org/*", "zone_name": "madrasatulinsaf.org" },
        { "pattern": "www.madrasatulinsaf.org/*", "zone_name": "madrasatulinsaf.org" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "insaf",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "insaf-media" }],
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "3011", "simple": { "limit": 10, "period": 60 } },
        { "name": "CHECKOUT_LIMITER", "namespace_id": "3012", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": {
        "SITE_NAME": "Madrasatul Insaf",
        "ENVIRONMENT": "production",
        "META_PIXEL_ID": "1270876547892049",
        // Live SSLCommerz store; its id and password are secrets.
        "SSLCZ_SANDBOX": "0",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      }
    }
  }
}
